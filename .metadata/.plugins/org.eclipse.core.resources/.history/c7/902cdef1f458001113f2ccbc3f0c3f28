						class="cart-img">

					</div>

					<div class="col-12 col-md-5">

						<h3>
							HP Omen
						</h3>

						<p>
							Ryzen 9 • RTX 4070 • 32GB RAM • 1TB SSD
						</p>

						<span class="stock">
							In Stock
						</span>

					</div>

					<div class="col-12 col-md-2 text-center">

						<div class="quantity-box">

							<button>-</button>

							<input type="text" value="1">

							<button>+</button>

						</div>

					</div>

					<div class="col-12 col-md-2 text-center">

						<h2 class="price">
							₹1,49,999
						</h2>

						<button class="remove-btn">

							<i class="bi bi-trash"></i>

						</button>

					</div>

				</div>

			</div>

			<!-- ITEM 3 -->

			<div class="cart-card">

				<div class="row align-items-center">

					<div class="col-12 col-md-3 text-center">

						<img
						src="https://images.unsplash.com/photo-1588872657578-7efd1f1555ed?q=80&w=1200&auto=format&fit=crop"
						class="cart-img">

					</div>

					<div class="col-12 col-md-5">

						<h3>
							MacBook Pro M3
						</h3>

						<p>
							Apple M3 • 18GB RAM • 1TB SSD
						</p>

						<span class="stock">
							In Stock
						</span>

					</div>

					<div class="col-12 col-md-2 text-center">

						<div class="quantity-box">

							<button>-</button>

							<input type="text" value="1">

							<button>+</button>

						</div>

					</div>

					<div class="col-12 col-md-2 text-center">

						<h2 class="price">
							₹1,89,999
						</h2>

						<button class="remove-btn">

							<i class="bi bi-trash"></i>

						</button>

					</div>

				</div>

			</div>

		</div>

		<!-- RIGHT -->

		<div class="col-12 col-lg-4">

			<div class="summary-box">

				<h2>
					Order Summary
				</h2>

				<div class="summary-item">

					<span>Subtotal</span>
					<span>₹4,65,997</span>

				</div>

				<div class="summary-item">

					<span>Shipping</span>
					<span>₹499</span>

				</div>

				<div class="summary-item">

					<span>Discount</span>
					<span class="discount">
						- ₹10,000
					</span>

				</div>

				<hr>

				<div class="summary-item total">

					<span>Total</span>
					<span>₹4,56,496</span>

				</div>

				<button class="checkout-btn">

					Proceed To Checkout

				</button>

			</div>

		</div>

