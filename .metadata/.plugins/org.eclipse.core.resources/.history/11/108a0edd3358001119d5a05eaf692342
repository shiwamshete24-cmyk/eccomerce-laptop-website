<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="in.sp.model.User"%>

<%
User user = (User)session.getAttribute("userData");

if(user == null){
	response.sendRedirect("login.html");
}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Profile</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<!-- CSS -->

<link rel="stylesheet" href="css/profile_edit.css">

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="profile.jsp">
			TechLaptop
		</a>

		<button
		class="navbar-toggler"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div class="collapse navbar-collapse" id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">
					<a class="nav-link" href="profile.jsp">
						Profile
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="laptops.jsp">
						Laptops
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="orders.jsp">
						Orders
					</a>
				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- HERO -->

<section class="edit-section">

	<div class="container">

		<div class="edit-box">

			<div class="text-center mb-5">

				<h1>
					Edit <span>Profile</span>
				</h1>

				<p>

					Update your personal information and profile details.

				</p>

			</div>

			<form action="UpdateProfile" method="post" enctype="multipart/form-data">

				<div class="row g-4">

					<!-- IMAGE -->

					<div class="col-12 text-center">

						<div class="image-box">

							<img
							src="img/<%=user.getImage()%>"
							class="profile-img">

						</div>

						<input
						type="file"
						name="image"
						class="form-control mt-4">

					</div>

					<!-- NAME -->

					<div class="col-12 col-md-6">

						<label>Full Name</label>

						<input
						type="text"
						name="name"
						value="<%=user.getName()%>"
						class="form-control">

					</div>

					<!-- EMAIL -->

					<div class="col-12 col-md-6">

						<label>Email</label>

						<input
						type="email"
						name="email"
						value="<%=user.getEmail()%>"
						class="form-control">

					</div>

					<!-- PHONE -->

					<div class="col-12 col-md-6">

						<label>Phone</label>

						<input
						type="text"
						name="phone"
						value="<%=user.getPhone()%>"
						class="form-control">

					</div>

					<!-- GENDER -->

					<div class="col-12 col-md-6">

						<label>Gender</label>

						<select
						name="gender"
						class="form-select">

							<option value="">
								Select Gender
							</option>

							<option value="Male">
								Male
							</option>

							<option value="Female">
								Female
							</option>

							<option value="Other">
								Other
							</option>

						</select>

					</div>

					<!-- DOB -->

					<div class="col-12 col-md-6">

						<label>Date Of Birth</label>

						<input
						type="date"
						name="dob"
						class="form-control">

					</div>

					<!-- COUNTRY -->

					<div class="col-12 col-md-6">

						<label>Country</label>

						<input
						type="text"
						name="country"
						value="<%=user.getCountry()%>"
						class="form-control">

					</div>

					<!-- LANGUAGE -->

					<div class="col-12 col-md-6">

						<label>Language</label>

						<input
						type="text"
						name="language"
						value="<%=user.getLanguage()%>"
						class="form-control">

					</div>

					<!-- CITY -->

					<div class="col-12 col-md-6">

						<label>City</label>

						<input
						type="text"
						name="city"
						value="<%=user.getCity()%>"
						class="form-control">

					</div>

					<!-- PINCODE -->

					<div class="col-12 col-md-6">

						<label>Pincode</label>

						<input
						type="text"
						name="pincode"
						value="<%=user.getPincode()%>"
						class="form-control">

					</div>

					<!-- ADDRESS -->

					<div class="col-12">

						<label>Address</label>

						<textarea
						name="address"
						rows="5"
						class="form-control"><%=user.getAddress()%></textarea>

					</div>

					<!-- BUTTON -->

					<div class="col-12 text-center">

						<button type="submit" class="save-btn">

							<i class="bi bi-check-circle-fill"></i>
							Save Changes

						</button>

					</div>

				</div>

			</form>

		</div>

	</div>

</section>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>