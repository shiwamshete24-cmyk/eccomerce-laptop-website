<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Login - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)
	),

	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

}

/* =========================
   NAVBAR
========================= */

.navbar{

	padding:18px 70px;

	background:rgba(0,0,0,0.35);

	backdrop-filter:blur(10px);

	border-bottom:
	1px solid rgba(255,255,255,0.08);

}

.navbar-brand{

	font-size:34px;

	font-weight:800;

	color:white !important;

	letter-spacing:1px;

}

.navbar-nav .nav-link{

	color:#e5e7eb !important;

	font-size:16px;

	font-weight:500;

	margin-left:25px;

	transition:0.3s;

	position:relative;

}

.navbar-nav .nav-link:hover{

	color:#c026d3 !important;

}

.navbar-nav .active{

	background:#c026d3;

	padding:10px 18px !important;

	border-radius:12px;

	color:white !important;

}

/* =========================
   MAIN CONTAINER
========================= */

.login-wrapper{

	min-height:90vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:40px;

}

/* =========================
   LOGIN BOX
========================= */

.login-box{

	width:100%;

	max-width:480px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(16px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:30px;

	padding:50px;

	box-shadow:
	0 10px 40px rgba(0,0,0,0.35);

	color:white;

	animation:fadeIn 0.8s ease;

}

/* =========================
   ANIMATION
========================= */

@keyframes fadeIn{

	from{

		opacity:0;

		transform:translateY(30px);

	}

	to{

		opacity:1;

		transform:translateY(0);

	}

}

/* =========================
   TEXT
========================= */

.login-box h1{

	font-size:48px;

	font-weight:800;

	margin-bottom:10px;

	text-align:center;

}

.login-box p{

	text-align:center;

	color:#d1d5db;

	margin-bottom:40px;

	font-size:15px;

}

/* =========================
   FORM
========================= */

.form-group{

	margin-bottom:25px;

}

.form-group label{

	display:block;

	margin-bottom:10px;

	font-size:15px;

	font-weight:600;

	color:#f3f4f6;

}

.input-box{

	position:relative;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:18px;

}

.input-box input{

	width:100%;

	height:58px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:16px;

	padding-left:55px;

	padding-right:15px;

	color:white;

	font-size:15px;

	transition:0.3s;

}

.input-box input::placeholder{

	color:#d1d5db;

}

.input-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #c026d3;

}

/* =========================
   OPTIONS
========================= */

.options{

	display:flex;

	justify-content:flex-end;

	margin-bottom:25px;

}

.options a{

	color:#f3f4f6;

	text-decoration:none;

	font-size:14px;

	transition:0.3s;

}

.options a:hover{

	color:#c026d3;

}

/* =========================
   LOGIN BUTTON
========================= */

.login-btn{

	width:100%;

	height:58px;

	border:none;

	border-radius:16px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	transition:0.4s;

	box-shadow:
	0 10px 20px rgba(192,38,211,0.3);

}

.login-btn:hover{

	transform:translateY(-4px);

	box-shadow:
	0 15px 30px rgba(192,38,211,0.45);

}

/* =========================
   REGISTER
========================= */

.register-text{

	text-align:center;

	margin-top:30px;

	color:#e5e7eb;

	font-size:15px;

}

.register-text a{

	color:white;

	font-weight:700;

	text-decoration:none;

	transition:0.3s;

}

.register-text a:hover{

	color:#d946ef;

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.navbar{

		padding:15px 25px;

	}

	.login-box{

		padding:35px 25px;

	}

	.login-box h1{

		font-size:38px;

	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a
		class="navbar-brand"
		href="index.html">

			TechLaptop

		</a>

		<button
		class="navbar-toggler"
		type="button"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div
		class="collapse navbar-collapse"
		id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">

					<a
					class="nav-link"
					href="index.html">

						Home

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link active"
					href="login.html">

						Login

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link"
					href="register.html">

						Register

					</a>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- LOGIN -->

<section class="login-wrapper">

	<div class="login-box">

		<h1>

			Welcome login

		</h1>

		<p>

			Welcome To Admin

		</p>

		<form
		method="post"
		action="Admin_login">

			<!-- EMAIL -->

			<div class="form-group">

				<label>

					Email Address

				</label>

				<div class="input-box">

					<i class="bi bi-envelope-fill"></i>

					<input
					type="email"
					name="email"
					placeholder="Enter your email"
					required>

				</div>

			</div>

			<!-- PASSWORD -->

			<div class="form-group">

				<label>

					Password

				</label>

				<div class="input-box">

					<i class="bi bi-lock-fill"></i>

					<input
					type="password"
					name="password"
					placeholder="Enter your password"
					required>

				</div>

			</div>

			<!-- OPTIONS -->

			<div class="options">

				<a href="#">

					Forgot Password?

				</a>

			</div>

			<!-- BUTTON -->

			<button
			type="submit"
			class="login-btn">

				Login

			</button>

			<!-- REGISTER -->

			<p class="register-text">

				Don't have an account?

				<a href="register.html">

					Register

				</a>

			</p>

		</form>

	</div>

</section>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>