*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#050816;
	color:white;
	overflow-x:hidden;
}

/* NAVBAR */

.navbar{
	background:#081120;
	padding:15px 20px;
	border-bottom:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:0;
	z-index:999;
}

.navbar-brand{
	color:#00d9ff !important;
	font-size:32px;
	font-weight:800;
}

.nav-link{
	color:white !important;
	margin-left:18px;
	font-weight:500;
	position:relative;
}

.nav-link::after{
	content:'';
	position:absolute;
	left:0;
	bottom:-5px;
	width:0%;
	height:2px;
	background:#00d9ff;
	transition:0.4s;
}

.nav-link:hover::after{
	width:100%;
}

/* LOGOUT */

.logout-btn{
	background:linear-gradient(to right,#ff4d4d,#ff0055);
	color:white;
	padding:12px 24px;
	border-radius:40px;
	text-decoration:none;
	font-weight:600;
	transition:0.4s;
}

.logout-btn:hover{
	transform:translateY(-4px);
	box-shadow:0 10px 20px rgba(255,0,85,0.35);
	color:white;
}

/* HERO */

.profile-hero{
	padding:90px 20px 50px;
}

/* PROFILE CARD */

.profile-card{
	background:rgba(255,255,255,0.05);
	border-radius:35px;
	padding:50px;
	border:1px solid rgba(255,255,255,0.08);
	backdrop-filter:blur(10px);
	position:relative;
	overflow:hidden;
}

.profile-card::before{
	content:'';
	position:absolute;
	width:400px;
	height:400px;
	background:#00d9ff;
	filter:blur(180px);
	opacity:0.08;
	top:-150px;
	right:-100px;
}

/* IMAGE */

.profile-image-box{
	position:relative;
	display:inline-block;
}

.profile-img{
	width:220px;
	height:220px;
	border-radius:50%;
	object-fit:cover;
	border:6px solid #00d9ff;
	box-shadow:0 15px 40px rgba(0,217,255,0.3);
}

.online-status{
	width:28px;
	height:28px;
	background:#00ff88;
	border-radius:50%;
	position:absolute;
	bottom:20px;
	right:20px;
	border:4px solid #050816;
}

.profile-name{
	font-size:38px;
	font-weight:800;
	margin-top:25px;
}

.profile-role{
	color:#00d9ff;
	font-size:18px;
	font-weight:600;
}

/* INFO */

.profile-info{
	padding-left:20px;
}

.info-box{
	background:rgba(255,255,255,0.04);
	padding:25px;
	border-radius:20px;
	border:1px solid rgba(255,255,255,0.06);
	height:100%;
	transition:0.4s;
}

.info-box:hover{
	transform:translateY(-6px);
	box-shadow:0 15px 35px rgba(0,217,255,0.12);
}

.info-box h5{
	font-size:18px;
	font-weight:700;
	margin-bottom:15px;
	color:#00d9ff;
}

.info-box p{
	color:#d8d8d8;
	font-size:16px;
	word-break:break-word;
}

/* BUTTONS */

.profile-buttons{
	display:flex;
	gap:20px;
	margin-top:35px;
	flex-wrap:wrap;
}

.edit-btn,
.password-btn{
	border:none;
	padding:14px 28px;
	border-radius:40px;
	font-weight:600;
	transition:0.4s;
}

.edit-btn{
	background:linear-gradient(to right,#00d9ff,#0059ff);
	color:white;
}

.password-btn{
	background:#10192d;
	color:white;
	border:1px solid rgba(255,255,255,0.08);
}

.edit-btn:hover,
.password-btn:hover{
	transform:translateY(-5px);
}

/* STATS */

.stats-card{
	background:rgba(255,255,255,0.05);
	padding:35px 25px;
	border-radius:25px;
	text-align:center;
	border:1px solid rgba(255,255,255,0.08);
	transition:0.4s;
	height:100%;
}

.stats-card:hover{
	transform:translateY(-8px);
	box-shadow:0 20px 40px rgba(0,217,255,0.15);
}

.stats-card i{
	font-size:45px;
	color:#00d9ff;
	margin-bottom:20px;
}

.stats-card h2{
	font-size:40px;
	font-weight:800;
	margin-bottom:10px;
}

.stats-card p{
	color:#bdbdbd;
	font-size:16px;
}

/* ACTIVITY */

.activity-box{
	background:rgba(255,255,255,0.05);
	padding:40px;
	border-radius:30px;
	border:1px solid rgba(255,255,255,0.08);
}

.section-title{
	font-size:40px;
	font-weight:800;
	margin-bottom:35px;
	color:#00d9ff;
}

.activity-item{
	display:flex;
	align-items:flex-start;
	gap:20px;
	padding:20px 0;
	border-bottom:1px solid rgba(255,255,255,0.08);
}

.activity-item:last-child{
	border-bottom:none;
}

.activity-icon{
	width:60px;
	height:60px;
	background:#10192d;
	border-radius:18px;
	display:flex;
	align-items:center;
	justify-content:center;
	font-size:24px;
	color:#00d9ff;
}

.activity-item h5{
	font-size:22px;
	font-weight:700;
	margin-bottom:8px;
}

.activity-item p{
	color:#bdbdbd;
	line-height:1.7;
}

/* FOOTER */

.footer{
	background:#081120;
	padding:80px 20px 40px;
	margin-top:80px;
}

.footer-logo{
	color:#00d9ff;
	font-size:38px;
	font-weight:800;
	margin-bottom:20px;
}

.footer p{
	color:#bdbdbd;
	line-height:1.8;
}

.footer h4{
	margin-bottom:20px;
	font-weight:700;
}

.footer-links{
	list-style:none;
	padding:0;
}

.footer-links li{
	margin-bottom:12px;
}

.footer-links a{
	color:#bdbdbd;
	text-decoration:none;
	transition:0.3s;
}

.footer-links a:hover{
	color:#00d9ff;
	padding-left:5px;
}

/* TABLET */

@media(max-width:991px){

	.navbar-collapse{
		background:#081120;
		padding:20px;
		border-radius:20px;
		margin-top:15px;
	}

	.profile-card{
		text-align:center;
		padding:40px 25px;
	}

	.profile-info{
		padding-left:0;
		margin-top:40px;
	}

	.profile-buttons{
		justify-content:center;
	}

}

/* MOBILE */

@media(max-width:767px){

	.row{
		--bs-gutter-x:0rem;
	}

	.profile-name{
		font-size:30px;
	}

	.profile-img{
		width:170px;
		height:170px;
	}

	.activity-box{
		padding:30px 20px;
	}

	.section-title{
		font-size:32px;
	}

	.activity-item{
		flex-direction:column;
		text-align:center;
		align-items:center;
	}

	.edit-btn,
	.password-btn,
	.logout-btn{
		width:100%;
		text-align:center;
	}

}