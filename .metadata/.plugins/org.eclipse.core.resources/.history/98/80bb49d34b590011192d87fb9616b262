<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>
<%@ page import="in.sp.model.User"%>

<%
User admin = (User) session.getAttribute("admin_details");

if (admin == null) {

	response.sendRedirect("admin_login.html");

}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Manage Users</title>

<!-- BOOTSTRAP -->

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- ICONS -->

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
	href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
	rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: 'Poppins', sans-serif;
}

body {
	background: #eef2f7;
	overflow-x: hidden;
}

/* =========================
   SIDEBAR
========================= */
.sidebar {
	width: 280px;
	height: 100vh;
	position: fixed;
	top: 0;
	left: 0;
	background: linear-gradient(180deg, #111827, #1f2937);
	padding: 30px 20px;
	box-shadow: 5px 0 25px rgba(0, 0, 0, 0.12);
	z-index: 1000;
}

.logo {
	color: white;
	font-size: 34px;
	font-weight: 800;
	margin-bottom: 50px;
	text-align: center;
}

.sidebar-menu {
	list-style: none;
	padding: 0;
}

.sidebar-menu li {
	margin-bottom: 12px;
}

.sidebar-menu a {
	display: flex;
	align-items: center;
	gap: 15px;
	padding: 15px 18px;
	color: #d1d5db;
	text-decoration: none;
	border-radius: 16px;
	font-size: 15px;
	font-weight: 500;
	transition: 0.3s;
}

.sidebar-menu a:hover {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
	transform: translateX(5px);
}

.sidebar-menu .active {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
}

/* =========================
   MAIN
========================= */
.main {
	margin-left: 280px;
	padding: 35px;
}

/* =========================
   TOPBAR
========================= */
.topbar {
	background: white;
	padding: 22px 30px;
	border-radius: 24px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
	margin-bottom: 35px;
}

.topbar h2 {
	font-size: 30px;
	font-weight: 800;
	color: #111827;
}

/* =========================
   TABLE BOX
========================= */
.table-box {
	background: white;
	padding: 30px;
	border-radius: 30px;
	box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
}

/* =========================
   HEADER
========================= */
.table-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 25px;
	flex-wrap: wrap;
	gap: 20px;
}

.table-header h3 {
	font-size: 28px;
	font-weight: 800;
	color: #111827;
}

/* =========================
   SEARCH
========================= */
.search-box {
	position: relative;
}

.search-box input {
	width: 320px;
	height: 52px;
	border: none;
	outline: none;
	background: #f3f4f6;
	border-radius: 14px;
	padding-left: 50px;
	padding-right: 15px;
	font-size: 15px;
}

.search-box i {
	position: absolute;
	left: 18px;
	top: 50%;
	transform: translateY(-50%);
	color: #6b7280;
	font-size: 17px;
}

/* =========================
   TABLE
========================= */
.table {
	vertical-align: middle;
}

.table thead {
	background: #111827;
	color: white;
}

.table thead th {
	padding: 18px;
	font-size: 15px;
	font-weight: 600;
	border: none;
}

.table tbody tr {
	transition: 0.3s;
}

.table tbody tr:hover {
	background: #f9fafb;
}

.table tbody td {
	padding: 18px;
	font-size: 15px;
	border-bottom: 1px solid #e5e7eb;
}

/* =========================
   USER BOX
========================= */
.user-box {
	display: flex;
	align-items: center;
	gap: 15px;
}

.user-img {
	width: 55px;
	height: 55px;
	border-radius: 50%;
	background: linear-gradient(135deg, #d946ef, #9333ea);
	display: flex;
	align-items: center;
	justify-content: center;
	color: white;
	font-size: 22px;
	font-weight: 700;
}

/* =========================
   STATUS
========================= */
.status {
	padding: 8px 16px;
	border-radius: 50px;
	font-size: 13px;
	font-weight: 700;
	display: inline-block;
}

.active-status {
	background: #ecfdf5;
	color: #10b981;
}

/* =========================
   BUTTONS
========================= */
.action-btn {
	border: none;
	padding: 10px 18px;
	border-radius: 12px;
	font-size: 14px;
	font-weight: 600;
	color: white;
	text-decoration: none;
	transition: 0.3s;
	display: inline-block;
}

.view-btn {
	background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.delete-btn {
	background: linear-gradient(135deg, #ef4444, #dc2626);
}

.action-btn:hover {
	transform: translateY(-3px);
	color: white;
}

/* =========================
   MOBILE
========================= */
@media ( max-width :991px) {
	.sidebar {
		width: 100%;
		height: auto;
		position: relative;
	}
	.main {
		margin-left: 0;
	}
	.search-box input {
		width: 100%;
	}
}
</style>

</head>

<body>

	<!-- SIDEBAR -->

	<div class="sidebar">

		<h1 class="logo">TechLaptop</h1>

		<ul class="sidebar-menu">

			<li><a href="admin_dashboard.jsp"> <i
					class="bi bi-grid-fill"></i> Dashboard

			</a></li>

			<li><a href="admin_profile.jsp"> <i
					class="bi bi-person-circle"></i> Profile

			</a></li>

			<li><a href="admin_users.jsp" class="active"> <i
					class="bi bi-people-fill"></i> Users

			</a></li>

			<li><a href="admin_laptops.jsp"> <i class="bi bi-laptop"></i>

					Laptops

			</a></li>

			<li><a href="admin_orders.jsp"> <i
					class="bi bi-bag-check-fill"></i> Orders

			</a></li>

			<li><a href="Logout"> <i class="bi bi-box-arrow-right"></i>

					Logout

			</a></li>

		</ul>

	</div>

	<!-- MAIN -->

	<div class="main">

		<!-- TOPBAR -->

		<div class="topbar">

			<h2>Manage Users</h2>

		</div>

		<!-- TABLE BOX -->

		<div class="table-box">

			<div class="table-header">

				<h3>All Registered Users</h3>

				<!-- SEARCH FORM -->

				<form method="get">

					<div class="search-box">

						<i class="bi bi-search"></i> <input type="text" name="search"
							placeholder="Search users..."
							value="<%=request.getParameter("search") == null ? "" : request.getParameter("search")%>">

					</div>

				</form>

			</div>

			<div class="table-responsive">

				<table class="table">

					<thead>

						<tr>

							<th>ID</th>

							<th>User</th>

							<th>Email</th>

							<th>Status</th>

							<th>Action</th>

						</tr>

					</thead>

					<tbody>

						<%
						Connection conn = DbConnection.getConnection();

						/* SEARCH VALUE */

						String search = request.getParameter("search");

						PreparedStatement ps;

						/* SEARCH QUERY */

						if (search != null && !search.trim().equals("")) {

							ps = conn.prepareStatement(

							"select * from users where name like ? or email like ?"

							);

							ps.setString(1, "%" + search + "%");

							ps.setString(2, "%" + search + "%");

						} else {

							ps = conn.prepareStatement("select * from users");

						}

						ResultSet rs = ps.executeQuery();

						while (rs.next()) {
						%>

						<tr>

							<td>#USR<%=rs.getInt("id")%>

							</td>

							<td>

								<div class="user-box">

									<div class="user-img">

										<%=rs.getString("name").substring(0, 1).toUpperCase()%>

									</div>

									<div>

										<b> <%=rs.getString("name")%>

										</b>

									</div>

								</div>

							</td>

							<td><%=rs.getString("email")%></td>

							<td><span class="status active-status"> Active </span></td>

							<td><a href="view_user.jsp?id=<%=rs.getInt("id")%>"
								class="action-btn view-btn"> <i class="bi bi-eye-fill"></i>

									Details <a href="DeleteUser?id=<%=rs.getInt("id")%>"
									class="action-btn delete-btn"> <i class="bi bi-trash-fill"></i>

										Delete

								</a></td>

						</tr>

						<%
						}
						%>

					</tbody>

				</table>

			</div>

		</div>

	</div>

	<!-- BOOTSTRAP -->

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
		
	</script>

</body>

</html>