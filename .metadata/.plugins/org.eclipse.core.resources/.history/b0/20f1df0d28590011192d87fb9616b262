package in.sp.Controllers ;

import java.io.IOException;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

import in.sp.connection.DbConnection;
import in.sp.model.User;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/AddToCart")
public class AddToCart extends HttpServlet{

	@Override
	protected void doPost(
	HttpServletRequest request,
	HttpServletResponse response)

	throws ServletException, IOException{

		try{

			/* SESSION */

			HttpSession session =
			request.getSession();

			User user =
			(User)session.getAttribute("userData");

			/* LOGIN CHECK */

			if(user == null){

				response.sendRedirect("login.html");

				return;
			}

			/* USER EMAIL */

			String email =
			user.getEmail();

			/* LAPTOP ID */

			int laptopId =
			Integer.parseInt(
			request.getParameter("laptopId"));

			/* DATABASE CONNECTION */

			Connection conn =
			DbConnection.getConnection();

			/* CHECK ALREADY EXISTS */

			String checkQuery =
			"select * from cart " +
			"where user_email=? " +
			"and laptop_id=? " +
			"and status='active'";

			PreparedStatement checkPs =
			conn.prepareStatement(checkQuery);

			checkPs.setString(1, email);

			checkPs.setInt(2, laptopId);

			ResultSet rs =
			checkPs.executeQuery();

			/* IF PRODUCT ALREADY EXISTS */

			if(rs.next()){

				String updateQuery =
				"update cart " +
				"set quantity=quantity+1 " +
				"where user_email=? " +
				"and laptop_id=? " +
				"and status='active'";

				PreparedStatement updatePs =
				conn.prepareStatement(updateQuery);

				updatePs.setString(1, email);

				updatePs.setInt(2, laptopId);

				updatePs.executeUpdate();

			}

			/* INSERT NEW PRODUCT */

			else{

				String insertQuery =
				"insert into cart(" +
				"user_email," +
				"laptop_id," +
				"quantity," +
				"status" +
				") values(?,?,?,?)";

				PreparedStatement insertPs =
				conn.prepareStatement(insertQuery);

				insertPs.setString(1, email);

				insertPs.setInt(2, laptopId);

				insertPs.setInt(3, 1);

				insertPs.setString(4, "active");

				insertPs.executeUpdate();

			}

			/* REDIRECT */

			response.sendRedirect("cart.jsp");

		}

		catch(Exception e){

			e.printStackTrace();

		}

	}

}