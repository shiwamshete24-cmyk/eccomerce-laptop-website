<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Register - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.75),
	rgba(0,0,0,0.75)
	),

	url("img/myimg6.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

}

/* =========================
   NAVBAR
========================= */

.navbar{

	padding:18px 70px;

	background:
	rgba(0,0,0,0.35);

	backdrop-filter:blur(16px);

	border-bottom:
	1px solid rgba(255,255,255,0.08);

	box-shadow:
	0 4px 25px rgba(0,0,0,0.25);

}

.navbar-brand{

	font-size:34px;

	font-weight:800;

	color:white !important;

	letter-spacing:1px;

}

.navbar-nav .nav-link{

	color:#e5e7eb !important;

	font-size:15px;

	font-weight:500;

	margin-left:20px;

	padding:10px 18px !important;

	border-radius:12px;

	transition:0.3s;

}

.navbar-nav .nav-link:hover{

	background:
	rgba(255,255,255,0.08);

	color:#d946ef !important;

}

.navbar-nav .active{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white !important;

	box-shadow:
	0 10px 25px rgba(217,70,239,0.35);

}

/* =========================
   MAIN CONTAINER
========================= */

.auth-container{

	min-height:88vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:40px 20px;

}

/* =========================
   REGISTER BOX
========================= */

.auth-box{

	width:100%;

	max-width:470px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(18px);

	border:
	1px solid rgba(255,255,255,0.14);

	border-radius:30px;

	padding:45px;

	box-shadow:
	0 12px 45px rgba(0,0,0,0.4);

	position:relative;

	overflow:hidden;

	animation:fadeIn 0.8s ease;

}

/* =========================
   GLOW EFFECT
========================= */

.auth-box::before{

	content:"";

	position:absolute;

	width:220px;

	height:220px;

	background:
	radial-gradient(
	circle,
	rgba(217,70,239,0.30),
	transparent
	);

	top:-70px;

	right:-70px;

}

/* =========================
   ANIMATION
========================= */

@keyframes fadeIn{

	from{

		opacity:0;

		transform:translateY(30px);

	}

	to{

		opacity:1;

		transform:translateY(0);

	}

}

/* =========================
   TITLE
========================= */

.auth-box h2{

	color:white;

	font-size:42px;

	font-weight:800;

	text-align:center;

	margin-bottom:10px;

	position:relative;

	z-index:2;

}

.auth-subtitle{

	color:#d1d5db;

	text-align:center;

	font-size:15px;

	line-height:1.8;

	margin-bottom:35px;

	position:relative;

	z-index:2;

}

/* =========================
   LABELS
========================= */

.auth-box label{

	display:block;

	color:#f3f4f6;

	font-size:14px;

	font-weight:600;

	margin-bottom:10px;

	position:relative;

	z-index:2;

}

/* =========================
   INPUT BOX
========================= */

.input-box{

	position:relative;

	margin-bottom:22px;

	z-index:2;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:17px;

}

/* =========================
   INPUTS
========================= */

.input-box input{

	width:100%;

	height:58px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:16px;

	padding-left:55px;

	padding-right:15px;

	color:white;

	font-size:15px;

	transition:0.3s;

}

.input-box input::placeholder{

	color:#d1d5db;

}

.input-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #d946ef;

	box-shadow:
	0 0 15px rgba(217,70,239,0.25);

}

/* =========================
   TERMS
========================= */

.terms-box{

	display:flex;

	align-items:center;

	gap:10px;

	margin-bottom:28px;

	color:#e5e7eb;

	font-size:14px;

	position:relative;

	z-index:2;

}

.terms-box input{

	width:16px;

	height:16px;

	accent-color:#d946ef;

}

/* =========================
   BUTTON
========================= */

.auth-box button{

	width:100%;

	height:58px;

	border:none;

	border-radius:16px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	cursor:pointer;

	transition:0.4s;

	box-shadow:
	0 12px 28px rgba(217,70,239,0.35);

	position:relative;

	z-index:2;

}

.auth-box button:hover{

	transform:translateY(-4px);

	box-shadow:
	0 18px 38px rgba(217,70,239,0.45);

}

/* =========================
   LOGIN LINK
========================= */

.link{

	text-align:center;

	margin-top:28px;

	font-size:15px;

	color:#e5e7eb;

	position:relative;

	z-index:2;

}

.link a{

	color:white;

	font-weight:700;

	text-decoration:none;

	transition:0.3s;

}

.link a:hover{

	color:#d946ef;

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.navbar{

		padding:15px 22px;

	}

	.auth-box{

		padding:35px 25px;

		border-radius:22px;

	}

	.auth-box h2{

		font-size:34px;

	}

	.navbar-brand{

		font-size:28px;

	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a
		class="navbar-brand fw-bold"
		href="index.html">

			TechLaptop

		</a>

		<button
		class="navbar-toggler"
		type="button"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div
		class="collapse navbar-collapse"
		id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">

					<a
					class="nav-link"
					href="index.html">

						Home

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link"
					href="login.html">

						Login

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link active"
					href="register.html">

						Register

					</a>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- REGISTER -->

<div class="auth-container">

	<div class="auth-box">

		<h2>

			Create Account

		</h2>

		<p class="auth-subtitle">

			Join TechLaptop and explore premium laptops
			for gaming, coding and business work.

		</p>

		<form
		method="post"
		action="register"
		onsubmit="return validatePassword()">

			<!-- FULL NAME -->

			<label>

				Full Name

			</label>

			<div class="input-box">

				<i class="bi bi-person-fill"></i>

				<input
				type="text"
				name="username"
				placeholder="Enter your full name"
				required>

			</div>

			<!-- EMAIL -->

			<label>

				Email Address

			</label>

			<div class="input-box">

				<i class="bi bi-envelope-fill"></i>

				<input
				type="email"
				name="email"
				placeholder="Enter your email"
				required>

			</div>

			<!-- PASSWORD -->

			<label>

				Password

			</label>

			<div class="input-box">

				<i class="bi bi-lock-fill"></i>

				<input
				type="password"
				name="password"
				id="password"
				placeholder="Create password"
				required>

			</div>

			<!-- CONFIRM PASSWORD -->

			<label>

				Confirm Password

			</label>

			<div class="input-box">

				<i class="bi bi-shield-lock-fill"></i>

				<input
				type="password"
				name="confirm-password"
				id="confirm-password"
				placeholder="Confirm password"
				required>

			</div>

			<!-- TERMS -->

			<div class="terms-box">

				<input
				type="checkbox"
				required>

				<span>

					I agree to the Terms &
					Conditions

				</span>

			</div>

			<!-- BUTTON -->

			<button type="submit">

				Create Account

			</button>

			<!-- LOGIN LINK -->

			<p class="link">

				Already have an account?

				<a href="login.html">

					Login

				</a>

			</p>

		</form>

	</div>

</div>

<!-- PASSWORD VALIDATION -->

<script src="script.js"></script>

<!-- BOOTSTRAP -->

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>