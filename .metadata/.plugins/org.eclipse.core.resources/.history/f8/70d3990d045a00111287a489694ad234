<%@ page language="java"
contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="in.sp.model.User"%>

<%
User user = (User)session.getAttribute("userData");

if(user == null){

	response.sendRedirect("login.html");

}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Contact Us

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{

	margin:0;

	padding:0;

	box-sizing:border-box;

	font-family:'Poppins',sans-serif;

}

body{

	background:#020617;

	color:white;

	overflow-x:hidden;

}

/* =========================
   NAVBAR
========================= */

.navbar{

	background:
	rgba(0,0,0,0.4);

	backdrop-filter:blur(10px);

	padding:18px 40px;

	border-bottom:
	1px solid rgba(255,255,255,0.08);

}

.navbar-brand{

	font-size:42px;

	font-weight:800;

	color:#22d3ee !important;

}

.navbar-nav .nav-link{

	color:white !important;

	font-size:16px;

	font-weight:500;

	margin-left:18px;

	transition:0.3s;

}

.navbar-nav .nav-link:hover{

	color:#22d3ee !important;

}

.navbar-nav .active{

	color:#22d3ee !important;

}

.custom-btn{

	background:
	linear-gradient(
	135deg,
	#06b6d4,
	#2563eb
	);

	color:white;

	padding:12px 24px;

	border-radius:50px;

	text-decoration:none;

	font-weight:600;

	transition:0.3s;

	display:inline-flex;

	align-items:center;

	gap:8px;

}

.custom-btn:hover{

	transform:translateY(-3px);

	color:white;

}

.user-btn{

	color:#22d3ee !important;

	font-weight:600;

	cursor:pointer;

}

/* =========================
   HERO
========================= */

.contact-hero{

	padding:70px 20px 40px;

	text-align:center;

}

.contact-hero h1{

	font-size:90px;

	font-weight:800;

	line-height:1.1;

}

.contact-hero h1 span{

	color:#22d3ee;

}

.contact-hero p{

	color:#d1d5db;

	font-size:20px;

	margin-top:20px;

}

/* =========================
   CONTACT BOX
========================= */

.contact-info,
.contact-form{

	background:
	rgba(255,255,255,0.06);

	border:
	1px solid rgba(255,255,255,0.08);

	border-radius:28px;

	padding:45px;

	height:100%;

	backdrop-filter:blur(12px);

	box-shadow:
	0 10px 40px rgba(0,0,0,0.25);

}

.contact-info h2,
.contact-form h2{

	font-size:52px;

	font-weight:800;

	margin-bottom:20px;

}

.contact-info p{

	color:#d1d5db;

	font-size:17px;

	line-height:1.8;

}

/* =========================
   INFO BOX
========================= */

.info-box{

	display:flex;

	align-items:flex-start;

	gap:18px;

	margin-top:40px;

}

.info-box i{

	font-size:34px;

	color:#22d3ee;

}

.info-box h5{

	font-size:28px;

	font-weight:700;

	margin-bottom:8px;

}

.info-box p{

	font-size:17px;

	color:#d1d5db;

}

/* =========================
   SOCIAL
========================= */

.social-icons{

	margin-top:40px;

	display:flex;

	gap:15px;

}

.social-icons a{

	width:50px;

	height:50px;

	border-radius:50%;

	background:
	rgba(255,255,255,0.08);

	display:flex;

	align-items:center;

	justify-content:center;

	color:white;

	font-size:20px;

	text-decoration:none;

	transition:0.3s;

}

.social-icons a:hover{

	background:#22d3ee;

	transform:translateY(-5px);

}

/* =========================
   FORM
========================= */

.contact-form input,
.contact-form textarea{

	width:100%;

	background:#07152f;

	border:none;

	border-radius:18px;

	padding:18px 20px;

	color:white;

	font-size:16px;

	outline:none;

}

.contact-form input{

	height:60px;

}

.contact-form textarea{

	resize:none;

}

.contact-form input::placeholder,
.contact-form textarea::placeholder{

	color:#94a3b8;

}

.contact-form input:focus,
.contact-form textarea:focus{

	border:2px solid #22d3ee;

}

/* =========================
   BUTTON
========================= */

.send-btn{

	background:
	linear-gradient(
	135deg,
	#06b6d4,
	#2563eb
	);

	color:white;

	border:none;

	padding:16px 38px;

	border-radius:50px;

	font-size:17px;

	font-weight:700;

	transition:0.3s;

}

.send-btn:hover{

	transform:translateY(-4px);

}

/* =========================
   MAP
========================= */

.map-box{

	border-radius:28px;

	overflow:hidden;

	border:
	1px solid rgba(255,255,255,0.08);

}

/* =========================
   FOOTER
========================= */

.footer{

	background:#020b1b;

	padding:70px 0 30px;

	margin-top:70px;

	border-top:
	1px solid rgba(255,255,255,0.08);

}

.footer-logo{

	font-size:40px;

	font-weight:800;

	color:#22d3ee;

	margin-bottom:18px;

}

.footer p{

	color:#cbd5e1;

	line-height:1.8;

}

.footer h4{

	font-size:24px;

	font-weight:700;

	margin-bottom:20px;

}

.footer-links{

	list-style:none;

	padding:0;

}

.footer-links li{

	margin-bottom:12px;

}

.footer-links a{

	text-decoration:none;

	color:#cbd5e1;

	transition:0.3s;

}

.footer-links a:hover{

	color:#22d3ee;

	padding-left:5px;

}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:992px){

	.contact-hero h1{

		font-size:65px;

	}

	.contact-info h2,
	.contact-form h2{

		font-size:42px;

	}

}

@media(max-width:768px){

	.navbar{

		padding:15px 20px;

	}

	.contact-hero h1{

		font-size:48px;

	}

	.contact-hero p{

		font-size:16px;

	}

	.contact-info,
	.contact-form{

		padding:30px;

	}

	.contact-info h2,
	.contact-form h2{

		font-size:34px;

	}

	.info-box h5{

		font-size:22px;

	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="home.jsp">

			TechLaptop

		</a>

		<button
		class="navbar-toggler"
		type="button"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div class="collapse navbar-collapse" id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">

					<a class="nav-link" href="home.jsp">

						Home

					</a>

				</li>

				<li class="nav-item">

					<a class="nav-link" href="laptops.jsp">

						Laptops

					</a>

				</li>

				<li class="nav-item">

					<a class="nav-link" href="about.jsp">

						About

					</a>

				</li>

				<li class="nav-item">

					<a class="nav-link active" href="contact.jsp">

						Contact

					</a>

				</li>

				<li class="nav-item">

					<a class="nav-link" href="orders.jsp">

						Orders

					</a>

				</li>

			</ul>

			<ul class="navbar-nav ms-4 align-items-center">

				<li class="nav-item me-3">

					<a href="cart.jsp" class="custom-btn">

						<i class="bi bi-cart3"></i>

						Cart

					</a>

				</li>

				<li class="nav-item dropdown">

					<a
					class="nav-link dropdown-toggle user-btn"
					data-bs-toggle="dropdown">

						<i class="bi bi-person-circle"></i>

						<%=user.getName()%>

					</a>

					<ul class="dropdown-menu dropdown-menu-end">

						<li>

							<a class="dropdown-item" href="profile.jsp">

								Profile

							</a>

						</li>

						<li>

							<a class="dropdown-item" href="orders.jsp">

								My Orders

							</a>

						</li>

						<li>

							<hr class="dropdown-divider">

						</li>

						<li>

							<a class="dropdown-item text-danger" href="Logout">

								Logout

							</a>

						</li>

					</ul>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- HERO -->

<section class="contact-hero">

	<div class="container">

		<h1>

			Contact <span>Us</span>

		</h1>

		<p>

			We are here to help you with laptops,
			orders and premium customer support.

		</p>

	</div>

</section>

<!-- CONTACT -->

<section class="container py-5">

	<div class="row g-4">

		<!-- LEFT -->

		<div class="col-lg-5">

			<div class="contact-info">

				<h2>

					Get In Touch

				</h2>

				<p>

					Feel free to contact us anytime.
					We will respond as soon as possible.

				</p>

				<div class="info-box">

					<i class="bi bi-geo-alt-fill"></i>

					<div>

						<h5>Address</h5>

						<p>

							Pune, Maharashtra, India

						</p>

					</div>

				</div>

				<div class="info-box">

					<i class="bi bi-envelope-fill"></i>

					<div>

						<h5>Email</h5>

						<p>

							support@techlaptop.com

						</p>

					</div>

				</div>

				<div class="info-box">

					<i class="bi bi-telephone-fill"></i>

					<div>

						<h5>Phone</h5>

						<p>

							+91 9876543210

						</p>

					</div>

				</div>

				<div class="social-icons">

					<a href="#">
						<i class="bi bi-facebook"></i>
					</a>

					<a href="#">
						<i class="bi bi-instagram"></i>
					</a>

					<a href="#">
						<i class="bi bi-twitter"></i>
					</a>

					<a href="#">
						<i class="bi bi-youtube"></i>
					</a>

				</div>

			</div>

		</div>

		<!-- RIGHT -->

		<div class="col-lg-7">

			<div class="contact-form">

				<h2>

					Send Message

				</h2>

				<form
				action="ContactMessage"
				method="post">

					<div class="row">

						<div class="col-md-6 mb-4">

							<input
							type="text"
							name="name"
							placeholder="Your Name"
							required>

						</div>

						<div class="col-md-6 mb-4">

							<input
							type="email"
							name="email"
							placeholder="Your Email"
							required>

						</div>

					</div>

					<input
					type="text"
					name="subject"
					placeholder="Subject"
					class="mb-4"
					required>

					<textarea
					rows="6"
					name="message"
					placeholder="Write Your Message"
					required></textarea>

					<button
					type="submit"
					class="send-btn mt-4">

						<i class="bi bi-send-fill"></i>

						Send Message

					</button>

				</form>

			</div>

		</div>

	</div>

</section>

<!-- MAP -->

<section class="container pb-5">

	<div class="map-box">

		<iframe
		src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3783.208689968886!2d73.856743!3d18.520430!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2c06d5f0b8fcb%3A0x123456789!2sPune!5e0!3m2!1sen!2sin!4v1710000000000"
		width="100%"
		height="450"
		style="border:0;"
		allowfullscreen=""
		loading="lazy">

		</iframe>

	</div>

</section>

<!-- FOOTER -->

<footer class="footer">

	<div class="container">

		<div class="row g-4">

			<div class="col-lg-4">

				<h2 class="footer-logo">

					TechLaptop

				</h2>

				<p>

					Premium ecommerce platform
					for gaming, business and
					student laptops.

				</p>

			</div>

			<div class="col-6 col-lg-2">

				<h4>

					Links

				</h4>

				<ul class="footer-links">

					<li>
						<a href="home.jsp">Home</a>
					</li>

					<li>
						<a href="laptops.jsp">Laptops</a>
					</li>

					<li>
						<a href="orders.jsp">Orders</a>
					</li>

				</ul>

			</div>

			<div class="col-6 col-lg-3">

				<h4>

					Categories

				</h4>

				<ul class="footer-links">

					<li>
						<a href="#">Gaming</a>
					</li>

					<li>
						<a href="#">Business</a>
					</li>

					<li>
						<a href="#">Student</a>
					</li>

				</ul>

			</div>

			<div class="col-lg-3">

				<h4>

					Contact

				</h4>

				<p>

					<i class="bi bi-envelope"></i>

					support@techlaptop.com

				</p>

				<p>

					<i class="bi bi-telephone"></i>

					+91 9876543210

				</p>

			</div>

		</div>

	</div>

</footer>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">

</script>

</body>

</html>