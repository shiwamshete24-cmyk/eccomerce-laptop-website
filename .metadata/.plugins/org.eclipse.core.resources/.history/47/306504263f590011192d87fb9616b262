<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>


<%
User user = (User)session.getAttribute("admin_details");

if(user == null){
	response.sendRedirect("login.html");
}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Admin Dashboard

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{

	background:#eef2f7;

	overflow-x:hidden;

}

/* =========================
   SIDEBAR
========================= */

.sidebar{

	width:280px;

	height:100vh;

	position:fixed;

	top:0;

	left:0;

	background:
	linear-gradient(
	180deg,
	#111827,
	#1f2937
	);

	padding:30px 20px;

	box-shadow:
	5px 0 25px rgba(0,0,0,0.12);

	z-index:1000;

}

/* LOGO */

.logo{

	color:white;

	font-size:34px;

	font-weight:800;

	margin-bottom:50px;

	text-align:center;

}

/* MENU */

.sidebar-menu{

	list-style:none;

	padding:0;

}

.sidebar-menu li{

	margin-bottom:12px;

}

.sidebar-menu a{

	display:flex;

	align-items:center;

	gap:15px;

	padding:15px 18px;

	color:#d1d5db;

	text-decoration:none;

	border-radius:16px;

	font-size:15px;

	font-weight:500;

	transition:0.3s;

}

.sidebar-menu a:hover{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	transform:translateX(5px);

}

.sidebar-menu .active{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	box-shadow:
	0 10px 25px rgba(217,70,239,0.3);

}

/* =========================
   MAIN
========================= */

.main{

	margin-left:280px;

	padding:30px;

}

/* =========================
   TOPBAR
========================= */

.topbar{

	background:white;

	padding:22px 30px;

	border-radius:24px;

	display:flex;

	align-items:center;

	justify-content:space-between;

	box-shadow:
	0 8px 30px rgba(0,0,0,0.05);

	margin-bottom:30px;

}

.topbar h2{

	font-size:30px;

	font-weight:800;

	color:#111827;

}

.admin-box{

	display:flex;

	align-items:center;

	gap:12px;

	background:#f3f4f6;

	padding:10px 18px;

	border-radius:14px;

	font-weight:600;

}

.admin-box i{

	font-size:22px;

	color:#9333ea;

}

/* =========================
   CARDS
========================= */

.dashboard-card{

	background:white;

	padding:30px;

	border-radius:26px;

	position:relative;

	overflow:hidden;

	box-shadow:
	0 10px 30px rgba(0,0,0,0.05);

	transition:0.3s;

	height:100%;

}

.dashboard-card:hover{

	transform:translateY(-6px);

}

.dashboard-card::before{

	content:"";

	position:absolute;

	width:180px;

	height:180px;

	background:
	radial-gradient(
	circle,
	rgba(217,70,239,0.15),
	transparent
	);

	top:-60px;

	right:-60px;

}

.card-icon{

	width:70px;

	height:70px;

	border-radius:20px;

	display:flex;

	align-items:center;

	justify-content:center;

	font-size:32px;

	margin-bottom:25px;

	color:white;

}

.bg1{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

}

.bg2{

	background:
	linear-gradient(
	135deg,
	#3b82f6,
	#2563eb
	);

}

.bg3{

	background:
	linear-gradient(
	135deg,
	#10b981,
	#059669
	);

}

.bg4{

	background:
	linear-gradient(
	135deg,
	#f59e0b,
	#d97706
	);

}

.dashboard-card h5{

	font-size:17px;

	color:#6b7280;

	margin-bottom:12px;

}

.dashboard-card h1{

	font-size:42px;

	font-weight:800;

	color:#111827;

}

/* =========================
   TABLE SECTION
========================= */

.table-box{

	background:white;

	padding:30px;

	border-radius:26px;

	margin-top:35px;

	box-shadow:
	0 10px 30px rgba(0,0,0,0.05);

}

.table-title{

	display:flex;

	align-items:center;

	justify-content:space-between;

	margin-bottom:25px;

}

.table-title h3{

	font-size:28px;

	font-weight:800;

}

.table{

	vertical-align:middle;

}

.table img{

	width:65px;

	height:65px;

	object-fit:contain;

	background:#f9fafb;

	padding:5px;

	border-radius:12px;

}

/* STATUS */

.status{

	padding:8px 14px;

	border-radius:50px;

	font-size:13px;

	font-weight:700;

	display:inline-block;

}

.pending{

	background:#fff7ed;

	color:#f97316;

}

.delivered{

	background:#ecfdf5;

	color:#10b981;

}

/* BUTTON */

.view-btn{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	border:none;

	padding:10px 18px;

	color:white;

	border-radius:12px;

	font-weight:600;

	transition:0.3s;

}

.view-btn:hover{

	transform:translateY(-3px);

	box-shadow:
	0 10px 20px rgba(217,70,239,0.35);

}

/* =========================
   MOBILE
========================= */

@media(max-width:991px){

	.sidebar{

		width:100%;

		height:auto;

		position:relative;

	}

	.main{

		margin-left:0;

	}

}

</style>

</head>

<body>

<%

Connection conn =
DbConnection.getConnection();

/* TOTAL USERS */

PreparedStatement ps1 =
conn.prepareStatement(
"select count(*) from users");

ResultSet rs1 =
ps1.executeQuery();

int totalUsers = 0;

if(rs1.next()){

	totalUsers =
	rs1.getInt(1);

}

/* TOTAL LAPTOPS */

PreparedStatement ps2 =
conn.prepareStatement(
"select count(*) from laptops");

ResultSet rs2 =
ps2.executeQuery();

int totalLaptops = 0;

if(rs2.next()){

	totalLaptops =
	rs2.getInt(1);

}

/* TOTAL ORDERS */

PreparedStatement ps3 =
conn.prepareStatement(
"select count(*) from orders");

ResultSet rs3 =
ps3.executeQuery();

int totalOrders = 0;

if(rs3.next()){

	totalOrders =
	rs3.getInt(1);

}

/* PENDING ORDERS */

PreparedStatement ps4 =
conn.prepareStatement(
"select count(*) from orders where order_status='pending'");

ResultSet rs4 =
ps4.executeQuery();

int pendingOrders = 0;

if(rs4.next()){

	pendingOrders =
	rs4.getInt(1);

}

%>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="sidebar-menu">

		<li>

			<a
			href="admin_dashboard.jsp"
			class="active">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_laptops.jsp">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="add_laptop.jsp">

				<i class="bi bi-plus-circle-fill"></i>

				Add Laptop

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOPBAR -->

	<div class="topbar">

		<h2>

			Admin Dashboard

		</h2>

		<div class="admin-box">

			<i class="bi bi-person-circle"></i>

			Admin Panel

		</div>

	</div>

	<!-- CARDS -->

	<div class="row g-4">

		<!-- USERS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg1">

					<i class="bi bi-people-fill"></i>

				</div>

				<h5>

					Total Users

				</h5>

				<h1>

					<%=totalUsers%>

				</h1>

			</div>

		</div>

		<!-- LAPTOPS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg2">

					<i class="bi bi-laptop"></i>

				</div>

				<h5>

					Total Laptops

				</h5>

				<h1>

					<%=totalLaptops%>

				</h1>

			</div>

		</div>

		<!-- ORDERS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg3">

					<i class="bi bi-bag-check-fill"></i>

				</div>

				<h5>

					Total Orders

				</h5>

				<h1>

					<%=totalOrders%>

				</h1>

			</div>

		</div>

		<!-- PENDING -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg4">

					<i class="bi bi-clock-fill"></i>

				</div>

				<h5>

					Pending Orders

				</h5>

				<h1>

					<%=pendingOrders%>

				</h1>

			</div>

		</div>

	</div>

	<!-- RECENT ORDERS -->

	<div class="table-box">

		<div class="table-title">

			<h3>

				Recent Orders

			</h3>

			<button class="view-btn">

				View All

			</button>

		</div>

		<div class="table-responsive">

			<table class="table align-middle">

				<thead>

					<tr>

						<th>Order ID</th>

						<th>User</th>

						<th>Status</th>

						<th>Payment</th>

					</tr>

				</thead>

				<tbody>

				<%

				PreparedStatement ps5 =
				conn.prepareStatement(
				"select * from orders order by id desc limit 5");

				ResultSet rs5 =
				ps5.executeQuery();

				while(rs5.next()){

				%>

					<tr>

						<td>

							#ORD<%=rs5.getInt("id")%>

						</td>

						<td>

							<%=rs5.getString("user_email")%>

						</td>

						<td>

							<span class="status pending">

								<%=rs5.getString("order_status")%>

							</span>

						</td>

						<td>

							<%=rs5.getString("payment_method")%>

						</td>

					</tr>

				<%
				}
				%>

				</tbody>

			</table>

		</div>

	</div>

</div>

<!-- BOOTSTRAP -->

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>