<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>
<%@ page import="in.sp.model.User"%>

<%
User admin = (User) session.getAttribute("admin_details");

if (admin == null) {

	response.sendRedirect("admin_login.html");

}

Connection conn = DbConnection.getConnection();
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Manage Laptops</title>

<!-- BOOTSTRAP -->

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- ICONS -->

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
	href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
	rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: 'Poppins', sans-serif;
}

body {
	background: #eef2f7;
	overflow-x: hidden;
}

/* =========================
   SIDEBAR
========================= */
.sidebar {
	width: 280px;
	height: 100vh;
	position: fixed;
	top: 0;
	left: 0;
	background: linear-gradient(180deg, #111827, #1f2937);
	padding: 30px 20px;
	box-shadow: 5px 0 25px rgba(0, 0, 0, 0.12);
	z-index: 1000;
	overflow-y: auto;
}

.logo {
	color: white;
	font-size: 34px;
	font-weight: 800;
	margin-bottom: 50px;
	text-align: center;
}

.sidebar-menu {
	list-style: none;
	padding: 0;
}

.sidebar-menu li {
	margin-bottom: 12px;
}

.sidebar-menu a {
	display: flex;
	align-items: center;
	gap: 15px;
	padding: 15px 18px;
	color: #d1d5db;
	text-decoration: none;
	border-radius: 16px;
	font-size: 15px;
	font-weight: 500;
	transition: 0.3s;
}

.sidebar-menu a:hover {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
	transform: translateX(5px);
}

.sidebar-menu .active {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
}

/* =========================
   MAIN
========================= */
.main {
	margin-left: 280px;
	padding: 35px;
}

/* =========================
   TOPBAR
========================= */
.topbar {
	background: white;
	padding: 22px 30px;
	border-radius: 24px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
	margin-bottom: 30px;
	flex-wrap: wrap;
	gap: 20px;
}

.topbar h2 {
	font-size: 30px;
	font-weight: 800;
	color: #111827;
}

.add-btn {
	padding: 13px 24px;
	border: none;
	border-radius: 14px;
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
	font-weight: 700;
	text-decoration: none;
	transition: 0.3s;
	display: inline-flex;
	align-items: center;
	gap: 10px;
}

.add-btn:hover {
	transform: translateY(-3px);
	color: white;
}

/* =========================
   BRAND NAVBAR
========================= */
.brand-navbar {
	display: flex;
	gap: 15px;
	flex-wrap: wrap;
	margin-bottom: 30px;
}

.brand-navbar a {
	padding: 12px 22px;
	background: white;
	border-radius: 14px;
	text-decoration: none;
	font-weight: 600;
	color: #111827;
	box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
	transition: 0.3s;
}

.brand-navbar a:hover {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
	transform: translateY(-3px);
}

/* =========================
   TABLE BOX
========================= */
.table-box {
	background: white;
	padding: 30px;
	border-radius: 30px;
	box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
}

/* =========================
   HEADER
========================= */
.table-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 25px;
	flex-wrap: wrap;
	gap: 20px;
}

.table-header h3 {
	font-size: 28px;
	font-weight: 800;
	color: #111827;
}

/* =========================
   FILTER FORM
========================= */
.filter-form {
	display: flex;
	align-items: center;
	gap: 15px;
	flex-wrap: wrap;
}

/* =========================
   SEARCH
========================= */
.search-box {
	position: relative;
}

.search-box input {
	width: 320px;
	height: 52px;
	border: none;
	outline: none;
	background: #f3f4f6;
	border-radius: 14px;
	padding-left: 50px;
	padding-right: 15px;
	font-size: 15px;
}

.search-box i {
	position: absolute;
	left: 18px;
	top: 50%;
	transform: translateY(-50%);
	color: #6b7280;
	font-size: 17px;
}

/* =========================
   STATUS SELECT
========================= */
.status-filter {
	width: 200px;
	height: 52px;
	border: none;
	outline: none;
	background: #f3f4f6;
	border-radius: 14px;
	padding: 0 15px;
	font-size: 15px;
}

/* =========================
   FILTER BUTTON
========================= */
.filter-btn {
	height: 52px;
	padding: 0 22px;
	border: none;
	border-radius: 14px;
	background: linear-gradient(135deg, #3b82f6, #2563eb);
	color: white;
	font-weight: 700;
	transition: 0.3s;
}

.filter-btn:hover {
	transform: translateY(-3px);
}

/* =========================
   TABLE
========================= */
.table {
	vertical-align: middle;
}

.table thead {
	background: #111827;
	color: white;
}

.table thead th {
	padding: 18px;
	font-size: 15px;
	font-weight: 600;
	border: none;
}

.table tbody td {
	padding: 18px;
	font-size: 15px;
	border-bottom: 1px solid #e5e7eb;
}

/* =========================
   LAPTOP IMAGE
========================= */
.laptop-box {
	display: flex;
	align-items: center;
	gap: 15px;
	min-width: 250px;
}

.laptop-img {
	width: 80px;
	height: 70px;
	object-fit: cover;
	border-radius: 15px;
	background: #f3f4f6;
	padding: 5px;
}

/* =========================
   STATUS
========================= */
.status {
	padding: 8px 15px;
	border-radius: 50px;
	font-size: 13px;
	font-weight: 700;
	display: inline-block;
}

.available {
	background: #ecfdf5;
	color: #10b981;
}

.out {
	background: #fef2f2;
	color: #ef4444;
}

/* =========================
   BUTTON GROUP
========================= */
.action-group {
	display: flex;
	align-items: center;
	gap: 10px;
	flex-wrap: wrap;
	min-width: 180px;
}

/* =========================
   BUTTONS
========================= */
.action-btn {
	padding: 10px 18px;
	border-radius: 12px;
	font-size: 14px;
	font-weight: 600;
	color: white;
	text-decoration: none;
	transition: 0.3s;
	display: inline-flex;
	align-items: center;
	gap: 8px;
	border: none;
}

.edit-btn {
	background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.delete-btn {
	background: linear-gradient(135deg, #ef4444, #dc2626);
}

.action-btn:hover {
	transform: translateY(-3px);
	color: white;
}

/* =========================
   MOBILE
========================= */
@media ( max-width :991px) {
	.sidebar {
		width: 100%;
		height: auto;
		position: relative;
	}
	.main {
		margin-left: 0;
		padding: 20px;
	}
	.search-box input {
		width: 100%;
	}
	.filter-form {
		width: 100%;
	}
	.status-filter {
		width: 100%;
	}
	.filter-btn {
		width: 100%;
	}
	.table-header {
		flex-direction: column;
		align-items: flex-start;
	}
}
</style>

</head>

<body>

	<!-- SIDEBAR -->

	<div class="sidebar">

		<h1 class="logo">TechLaptop</h1>

		<ul class="sidebar-menu">

			<li><a href="admin_dashboard.jsp"> <i
					class="bi bi-grid-fill"></i> Dashboard

			</a></li>

			<li><a href="admin_profile.jsp"> <i
					class="bi bi-person-circle"></i> Profile

			</a></li>

			<li><a href="admin_users.jsp"> <i class="bi bi-people-fill"></i>

					Users

			</a></li>

			<li><a href="admin_laptops.jsp" class="active"> <i
					class="bi bi-laptop"></i> Laptops

			</a></li>

			<li><a href="admin_orders.jsp"> <i
					class="bi bi-bag-check-fill"></i> Orders

			</a></li>

			<li><a href="Logout"> <i class="bi bi-box-arrow-right"></i>

					Logout

			</a></li>

		</ul>

	</div>

	<!-- MAIN -->

	<div class="main">

		<!-- TOPBAR -->

		<div class="topbar">

			<h2>Manage Laptops</h2>

			<a href="add_laptop.jsp" class="add-btn"> <i
				class="bi bi-plus-circle-fill"></i> Add Laptop

			</a>

		</div>

		<!-- BRAND FILTER -->

		<div class="brand-navbar">

			<a href="admin_laptops.jsp"> All </a> <a
				href="admin_laptops.jsp?brand=Dell"> Dell </a> <a
				href="admin_laptops.jsp?brand=HP"> HP </a> <a
				href="admin_laptops.jsp?brand=Asus"> Asus </a> <a
				href="admin_laptops.jsp?brand=Lenovo"> Lenovo </a> <a
				href="admin_laptops.jsp?brand=Acer"> Acer </a> <a
				href="admin_laptops.jsp?brand=MSI"> MSI </a> <a
				href="admin_laptops.jsp?brand=Apple"> Apple </a>

		</div>

		<!-- TABLE -->

		<div class="table-box">

			<div class="table-header">

				<h3>All Laptops</h3>

				<form method="get" class="filter-form">

					<div class="search-box">

						<i class="bi bi-search"></i> <input type="text" name="search"
							placeholder="Search name, brand, category...">

					</div>

					<select name="status" class="status-filter">

						<option value="">All Status</option>

						<option value="available">Available</option>

						<option value="out">Out Of Stock</option>

					</select>

					<button type="submit" class="filter-btn">

						<i class="bi bi-funnel-fill"></i> Filter

					</button>

				</form>

			</div>

			<div class="table-responsive">

				<table class="table">

					<thead>

						<tr>

							<th>ID</th>

							<th>Laptop</th>

							<th>Brand</th>

							<th>Category</th>

							<th>Price</th>

							<th>Stock</th>

							<th>Status</th>

							<th>Action</th>

						</tr>

					</thead>

					<tbody>

						<%
						String search = request.getParameter("search");

						String brand = request.getParameter("brand");

						String status = request.getParameter("status");

						String sql = "select * from laptops where 1=1";

						if (search != null && !search.trim().equals("")) {

							sql += " and (name like ? or brand like ? or category like ?)";

						}

						if (brand != null && !brand.equals("") && !brand.equals("All")) {

							sql += " and brand=?";

						}

						if (status != null && status.equals("available")) {

							sql += " and stock > 0";

						}

						if (status != null && status.equals("out")) {

							sql += " and stock <= 0";

						}

						sql += " order by id desc";

						PreparedStatement ps = conn.prepareStatement(sql);

						int paramIndex = 1;

						if (search != null && !search.trim().equals("")) {

							ps.setString(paramIndex++, "%" + search + "%");

							ps.setString(paramIndex++, "%" + search + "%");

							ps.setString(paramIndex++, "%" + search + "%");

						}

						if (brand != null && !brand.equals("") && !brand.equals("All")) {

							ps.setString(paramIndex++, brand);

						}

						ResultSet rs = ps.executeQuery();

						while (rs.next()) {

							int stock = rs.getInt("stock");
						%>

						<tr>

							<td>#LAP<%=rs.getInt("id")%>

							</td>

							<td>

								<div class="laptop-box">

									<img src="images/laptops/<%=rs.getString("image1")%>"
										class="laptop-img">

									<div>

										<b> <%=rs.getString("name")%>

										</b>

									</div>

								</div>

							</td>

							<td><%=rs.getString("brand")%></td>

							<td><%=rs.getString("category")%></td>

							<td>₹ <%=rs.getDouble("price")%>

							</td>

							<td><%=stock%></td>

							<td><span
								class="status
						<%=stock > 0 ? "available" : "out"%>">

									<%=stock > 0 ? "Available" : "Out Of Stock"%>

							</span></td>

							<td>

								<div class="action-group">

									<a href="edit_laptop.jsp?id=<%=rs.getInt("id")%>"
										class="action-btn edit-btn"> <i class="bi bi-pencil-fill"></i>

										Edit

									</a> <a href="DeleteLaptop?id=<%=rs.getInt("id")%>"
										class="action-btn delete-btn"
										onclick="return confirm('Are you sure you want to delete this laptop?')">

										<i class="bi bi-trash-fill"></i> Delete

									</a>

								</div>

							</td>

						</tr>

						<%
						}
						%>

					</tbody>

				</table>

			</div>

		</div>

	</div>

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
		
	</script>

</body>

</html>