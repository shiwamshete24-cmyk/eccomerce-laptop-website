<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Login - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)
	),

	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

}

/* NAVBAR */

.navbar{

	padding:18px 70px;

	background:rgba(0,0,0,0.35);

	backdrop-filter:blur(10px);

	border-bottom:
	1px solid rgba(255,255,255,0.08);

}

.navbar-brand{

	font-size:34px;

	font-weight:800;

	color:white !important;

}

.navbar-nav .nav-link{

	color:#e5e7eb !important;

	font-size:16px;

	font-weight:500;

	margin-left:25px;

	transition:0.3s;

}

.navbar-nav .nav-link:hover{

	color:#c026d3 !important;

}

.navbar-nav .active{

	background:#c026d3;

	padding:10px 18px !important;

	border-radius:12px;

	color:white !important;

}

/* LOGIN */

.login-wrapper{

	min-height:90vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:40px;

}

.login-box{

	width:100%;

	max-width:500px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(16px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:30px;

	padding:50px;

	box-shadow:
	0 10px 40px rgba(0,0,0,0.35);

	color:white;

}

.login-box h1{

	font-size:46px;

	font-weight:800;

	margin-bottom:10px;

	text-align:center;

}

.login-box p{

	text-align:center;

	color:#d1d5db;

	margin-bottom:35px;

	font-size:15px;

}

.form-group{

	margin-bottom:25px;

}

.form-group label{

	display:block;

	margin-bottom:10px;

	font-size:15px;

	font-weight:600;

	color:#f3f4f6;

}

.input-box{

	position:relative;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:18px;

}

.input-box input{

	width:100%;

	height:58px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:16px;

	padding-left:55px;

	padding-right:15px;

	color:white;

	font-size:15px;

}

.input-box input::placeholder{

	color:#d1d5db;

}

.input-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #c026d3;

}

.options{

	display:flex;

	justify-content:space-between;

	align-items:center;

	margin-bottom:25px;

}

.options a{

	color:#f3f4f6;

	text-decoration:none;

	font-size:14px;

}

.options a:hover{

	color:#c026d3;

}

.login-btn{

	width:100%;

	height:58px;

	border:none;

	border-radius:16px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	transition:0.4s;

	margin-top:10px;

}

.login-btn:hover{

	transform:translateY(-4px);

}

.otp-btn{

	width:100%;

	height:55px;

	border:none;

	border-radius:14px;

	background:#2563eb;

	color:white;

	font-size:16px;

	font-weight:600;

	margin-top:10px;

	transition:0.3s;

}

.otp-btn:hover{

	background:#1d4ed8;

}

.register-text{

	text-align:center;

	margin-top:25px;

	color:#e5e7eb;

	font-size:15px;

}

.register-text a{

	color:white;

	font-weight:700;

	text-decoration:none;

}

.register-text a:hover{

	color:#d946ef;

}

#otpSection{

	display:none;

}

@media(max-width:768px){

	.navbar{

		padding:15px 25px;

	}

	.login-box{

		padding:35px 25px;

	}

	.login-box h1{

		font-size:38px;

	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a
		class="navbar-brand"
		href="index.html">

			TechLaptop

		</a>

	</div>

</nav>

<!-- LOGIN -->

<section class="login-wrapper">

	<div class="login-box">

		<h1>

			Welcome Login

		</h1>

		<p>

			Login to continue shopping laptops.

		</p>

		<form
		method="post"
		action="login">

			<!-- EMAIL -->

			<div class="form-group">

				<label>

					Email Address

				</label>

				<div class="input-box">

					<i class="bi bi-envelope-fill"></i>

					<input
					type="email"
					name="email"
					placeholder="Enter your email"
					required>

				</div>

			</div>

			<!-- PASSWORD -->

			<div id="passwordSection">

				<div class="form-group">

					<label>

						Password

					</label>

					<div class="input-box">

						<i class="bi bi-lock-fill"></i>

						<input
						type="password"
						name="password"
						placeholder="Enter your password">

					</div>

				</div>

			</div>

			<!-- OTP SECTION -->

			<div id="otpSection">

				<div class="form-group">

					<label>

						OTP

					</label>

					<div class="input-box">

						<i class="bi bi-shield-lock-fill"></i>

						<input
						type="text"
						name="otp"
						placeholder="Enter OTP">

					</div>

				</div>

			</div>

			<!-- OPTIONS -->

			<div class="options">

				<a href="forget_password.jsp">

					Forgot Password?

				</a>

				<a href="#"
				onclick="showOtpLogin()">

					Login With OTP

				</a>

			</div>

			<!-- LOGIN BUTTON -->

			<button
			type="submit"
			class="login-btn">

				Login

			</button>

			<!-- SEND OTP -->

			<button
			type="button"
			class="otp-btn"
			onclick="sendOtp()">

				Send OTP

			</button>

			<!-- REGISTER -->

			<p class="register-text">

				Don't have an account?

				<a href="register.html">

					Register

				</a>

			</p>

		</form>

	</div>

</section>

<script>

function showOtpLogin(){

	document.getElementById(
	"otpSection").style.display="block";

}

function sendOtp(){

	alert("OTP Sent Successfully");

}

</script>

</body>

</html>