}

.footer h4{
	margin-bottom:25px;
	font-weight:700;
}

.footer-links{
	list-style:none;
	padding:0;
}

.footer-links li{
	margin-bottom:15px;
}

.footer-links a{
	color:#bdbdbd;
	text-decoration:none;
	transition:0.3s;
}

.footer-links a:hover{
	color:#00d9ff;
	padding-left:5px;
}

.footer-contact{
	color:#bdbdbd;
	margin-bottom:20px;
}

.footer-contact i{
	color:#00d9ff;
	margin-right:10px;
}

.footer-line{
