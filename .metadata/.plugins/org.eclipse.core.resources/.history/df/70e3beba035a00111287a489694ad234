*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#050816;
	color:white;
	overflow-x:hidden;
}

/* NAVBAR */

.navbar{
	background:#081120;
	padding:15px 20px;
	border-bottom:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:0;
	z-index:999;
}

.navbar-brand{
	color:#00d9ff !important;
	font-size:32px;
	font-weight:800;
}

.nav-link{
	color:white !important;
	margin-left:18px;
	font-weight:500;
	position:relative;
}

.nav-link::after{
	content:'';
	position:absolute;
	left:0;
	bottom:-5px;
	width:0%;
	height:2px;
	background:#00d9ff;
	transition:0.4s;
}

.nav-link:hover::after{
	width:100%;
}

.custom-btn{
	background:linear-gradient(to right,#00d9ff,#0059ff);
	color:white;
	padding:12px 24px;
	border-radius:40px;
	text-decoration:none;
	font-weight:600;
	border:none;
	transition:0.4s;
}

.custom-btn:hover{
	transform:translateY(-4px);
	box-shadow:0 10px 20px rgba(0,217,255,0.4);
	color:white;
}

.user-btn{
	color:#00d9ff !important;
	font-weight:700;
}

/* DROPDOWN */

.dropdown-menu{
	background:#10192d;
	border:1px solid rgba(255,255,255,0.08);
	border-radius:14px;
}

.dropdown-item{
	color:white;
}

.dropdown-item:hover{
	background:#00d9ff;
	color:black;
}

/* HERO */

.contact-hero{
	padding:100px 20px 60px;
}

.contact-hero h1{
	font-size:75px;
	font-weight:800;
	margin-bottom:20px;
}

.contact-hero h1 span{
	color:#00d9ff;
}

.contact-hero p{
	color:#bdbdbd;
	font-size:18px;
}

/* CONTACT */

.contact-info,
.contact-form{
	background:rgba(255,255,255,0.05);
	padding:40px 30px;
	border-radius:25px;
	border:1px solid rgba(255,255,255,0.08);
	height:100%;
}

.contact-info h2,
.contact-form h2{
	font-size:38px;
	font-weight:700;
	margin-bottom:20px;
}

.contact-info p{
	color:#bdbdbd;
	line-height:1.8;
}

.info-box{
	display:flex;
	align-items:flex-start;
	gap:20px;
	margin-top:35px;
}

.info-box i{
	font-size:28px;
	color:#00d9ff;
}

.social-icons{
	margin-top:40px;
}

.social-icons a{
	width:45px;
	height:45px;
	display:inline-flex;
	align-items:center;
	justify-content:center;
	border-radius:50%;
	background:#10192d;
	color:white;
	text-decoration:none;
	margin-right:12px;
	transition:0.4s;
}

.social-icons a:hover{
	background:#00d9ff;
	transform:translateY(-5px);
}

/* FORM */

.contact-form input,
.contact-form textarea{
	width:100%;
	background:#10192d;
	border:none;
	outline:none;
	padding:16px 18px;
	border-radius:14px;
	color:white;
}

.contact-form textarea{
	resize:none;
}

/* MAP */

.map-box{
	border-radius:25px;
	overflow:hidden;
	border:1px solid rgba(255,255,255,0.08);
}

/* FOOTER */

.footer{
	background:#081120;
	padding:80px 20px 40px;
	margin-top:80px;
}

.footer-logo{
	color:#00d9ff;
	font-size:38px;
	font-weight:800;
	margin-bottom:20px;
}

.footer p{
	color:#bdbdbd;
	line-height:1.8;
}

.footer h4{
	margin-bottom:20px;
	font-weight:700;
}

.footer-links{
	list-style:none;
	padding:0;
}

.footer-links li{
	margin-bottom:12px;
}

.footer-links a{
	color:#bdbdbd;
	text-decoration:none;
	transition:0.3s;
}

.footer-links a:hover{
	color:#00d9ff;
	padding-left:5px;
}

/* MOBILE */

@media(max-width:991px){

	.navbar-collapse{
		background:#081120;
		padding:20px;
		border-radius:20px;
		margin-top:15px;
	}

	.contact-hero h1{
		font-size:45px;
	}

	.contact-info{
		margin-bottom:20px;
	}

}

/* MOBILE */

@media(max-width:767px){

	.row{
		--bs-gutter-x:0rem;
	}

	.contact-info,
	.contact-form{
		padding:30px 20px;
	}

	.contact-info h2,
	.contact-form h2{
		font-size:30px;
	}

}