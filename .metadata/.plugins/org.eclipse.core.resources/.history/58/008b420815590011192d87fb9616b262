<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%

int id = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

String sql = "select * from laptops where id=?";

PreparedStatement ps = conn.prepareStatement(sql);

ps.setInt(1, id);

ResultSet rs = ps.executeQuery();

if(rs.next()){

	int stock = rs.getInt("stock");

%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
<%=rs.getString("name")%>
</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICON -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#060b18;
	color:white;
	overflow-x:hidden;
}

/* NAVBAR */

.navbar{
	background:#0a1225;
	padding:18px 35px;
	border-bottom:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:0;
	z-index:999;
	backdrop-filter:blur(10px);
}

.navbar-brand{
	color:#00d9ff !important;
	font-size:34px;
	font-weight:800;
	text-decoration:none;
	letter-spacing:1px;
}

/* MAIN SECTION */

.main-section{
	padding:45px 0;
}

/* PRODUCT CONTAINER */

.product-wrapper{
	background:#101827;
	border-radius:35px;
	padding:35px;
	border:1px solid rgba(255,255,255,0.08);
	box-shadow:
	0 10px 30px rgba(0,0,0,0.4),
	0 0 50px rgba(0,217,255,0.04);
}

/* LEFT SIDE */

.image-panel{
	background:white;
	border-radius:30px;
	padding:25px;
	position:relative;
	overflow:hidden;
}

/* MAIN IMAGE */

.main-image-container{
	width:100%;
	height:520px;
	border-radius:20px;
	overflow:hidden;
	cursor:zoom-in;
	position:relative;
}

.main-image{
	width:100%;
	height:100%;
	object-fit:contain;
	transition:transform 0.4s ease;
}

.main-image-container:hover .main-image{
	transform:scale(1.5);
}

/* THUMBNAILS */

.thumbnail-row{
	display:flex;
	gap:15px;
	margin-top:22px;
	justify-content:center;
	flex-wrap:wrap;
}

.thumb{
	width:95px;
	height:95px;
	object-fit:contain;
	background:white;
	padding:10px;
	border-radius:18px;
	cursor:pointer;
	border:2px solid transparent;
	transition:0.3s;
	box-shadow:0 5px 15px rgba(0,0,0,0.08);
}

.thumb:hover{
	border-color:#00d9ff;
	transform:translateY(-5px) scale(1.05);
}

/* DETAILS SIDE */

.brand{
	display:inline-block;
	background:rgba(0,217,255,0.15);
	color:#00d9ff;
	padding:8px 18px;
	border-radius:40px;
	font-size:14px;
	font-weight:700;
	margin-bottom:18px;
}

.title{
	font-size:42px;
	font-weight:800;
	line-height:1.4;
	margin-bottom:18px;
}

/* RATING */

.rating-row{
	display:flex;
	align-items:center;
	gap:14px;
	margin-bottom:24px;
	flex-wrap:wrap;
}

.stars{
	color:gold;
	font-size:18px;
}

.review{
	color:#bdbdbd;
	font-size:15px;
}

/* PRICE */

.price-box{
	margin-bottom:25px;
}

.new-price{
	font-size:46px;
	font-weight:800;
	color:#00d9ff;
}

.old-price{
	font-size:24px;
	color:#777;
	text-decoration:line-through;
	margin-left:14px;
}

.discount{
	background:#00ff88;
	color:black;
	padding:7px 16px;
	border-radius:30px;
	font-size:13px;
	font-weight:700;
	margin-left:14px;
}

/* STOCK */

.stock{
	margin-bottom:30px;
	font-size:17px;
	font-weight:700;
}

.in-stock{
	color:#00ff88;
}

.out-stock{
	color:red;
}

/* BUTTONS */

.button-group{
	display:flex;
	gap:18px;
	margin-bottom:35px;
}

.buy-btn{
	flex:1;
	background:#00d9ff;
	color:black;
	border:none;
	padding:16px;
	border-radius:18px;
	font-size:17px;
	font-weight:700;
	transition:0.4s;
}

.buy-btn:hover{
	transform:translateY(-5px);
	box-shadow:0 15px 30px rgba(0,217,255,0.25);
}

.cart-btn{
	flex:1;
	background:linear-gradient(to right,#00d9ff,#0059ff);
	color:white;
	border:none;
	padding:16px;
	border-radius:18px;
	font-size:17px;
	font-weight:700;
	transition:0.4s;
}

.cart-btn:hover{
	transform:translateY(-5px);
	box-shadow:0 15px 30px rgba(0,217,255,0.25);
}

/* SPECIFICATION BOX */

.spec-box{
	background:rgba(255,255,255,0.03);
	border-radius:24px;
	padding:28px;
	margin-top:20px;
	border:1px solid rgba(255,255,255,0.04);
}

.spec-title{
	font-size:25px;
	font-weight:700;
	margin-bottom:24px;
	color:#00d9ff;
}

.spec-row{
	display:flex;
	justify-content:space-between;
	align-items:center;
	padding:15px 0;
	border-bottom:1px solid rgba(255,255,255,0.05);
}

.spec-row:last-child{
	border-bottom:none;
}

.spec-name{
	color:#a1a1aa;
	font-weight:500;
	font-size:15px;
}

.spec-value{
	font-weight:600;
	font-size:15px;
	text-align:right;
}

/* DESCRIPTION */

.desc-box{
	background:rgba(255,255,255,0.03);
	border-radius:24px;
	padding:28px;
	margin-top:25px;
	border:1px solid rgba(255,255,255,0.04);
}

.desc-title{
	font-size:25px;
	font-weight:700;
	margin-bottom:18px;
	color:#00d9ff;
}

.desc{
	color:#cbd5e1;
	line-height:2;
	font-size:15px;
}

/* FEATURES */

.feature-row{
	display:flex;
	gap:15px;
	flex-wrap:wrap;
	margin-top:25px;
}

.feature-card{
	flex:1;
	min-width:120px;
	background:rgba(255,255,255,0.04);
	padding:18px;
	border-radius:18px;
	text-align:center;
	border:1px solid rgba(255,255,255,0.04);
}

.feature-card i{
	font-size:28px;
	color:#00d9ff;
	margin-bottom:10px;
}

.feature-card h6{
	margin:0;
	font-size:14px;
	font-weight:600;
}

/* MOBILE */

@media(max-width:991px){

	.title{
		font-size:32px;
		margin-top:25px;
	}

	.main-image-container{
		height:350px;
	}

}

@media(max-width:576px){

	.product-wrapper{
		padding:20px;
		border-radius:20px;
	}

	.title{
		font-size:25px;
	}

	.new-price{
		font-size:34px;
	}

	.button-group{
		flex-direction:column;
	}

	.thumb{
		width:70px;
		height:70px;
	}

	.main-image-container{
		height:280px;
	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar">

	<a class="navbar-brand" href="home.jsp">
		TechLaptop
	</a>

</nav>

<!-- MAIN -->

<div class="container main-section">

	<div class="product-wrapper">

		<div class="row g-5">

			<!-- LEFT -->

			<div class="col-lg-6">

				<div class="image-panel">

					<div class="main-image-container">

						<img
						id="mainImage"
						src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
						class="main-image">

					</div>

					<!-- THUMBNAILS -->

					<div class="thumbnail-row">

						<img
						src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
						class="thumb"
						onclick="changeImage(this.src)">

						<img
						src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image2")%>"
						class="thumb"
						onclick="changeImage(this.src)">

						<img
						src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image3")%>"
						class="thumb"
						onclick="changeImage(this.src)">

					</div>

				</div>

			</div>

			<!-- RIGHT -->

			<div class="col-lg-6">

				<div class="brand">
					<%=rs.getString("brand")%>
				</div>

				<h1 class="title">
					<%=rs.getString("name")%>
				</h1>

				<!-- RATING -->

				<div class="rating-row">

					<div class="stars">
						★★★★★
					</div>

					<div class="review">

						<%=rs.getDouble("rating")%>

						(
						<%=rs.getInt("total_reviews")%>
						Reviews )

					</div>

				</div>

				<!-- PRICE -->

				<div class="price-box">

					<span class="new-price">

						₹<%=rs.getInt("price")%>

					</span>

					<span class="old-price">

						₹<%=rs.getInt("old_price")%>

					</span>

					<span class="discount">

						20% OFF

					</span>

				</div>

				<!-- STOCK -->

				<div class="stock">

				<%
				if(stock > 0){
				%>

					<span class="in-stock">

						<i class="bi bi-check-circle-fill"></i>

						In Stock
						(
						<%=stock%>
						left )

					</span>

				<%
				}else{
				%>

					<span class="out-stock">

						<i class="bi bi-x-circle-fill"></i>

						Out Of Stock

					</span>

				<%
				}
				%>

				</div>

				<!-- FEATURES -->

				<div class="feature-row">

					<div class="feature-card">

						<i class="bi bi-truck"></i>

						<h6>
							Fast Delivery
						</h6>

					</div>

					<div class="feature-card">

						<i class="bi bi-shield-check"></i>

						<h6>
							Secure Warranty
						</h6>

					</div>

					<div class="feature-card">

						<i class="bi bi-arrow-repeat"></i>

						<h6>
							7 Days Return
						</h6>

					</div>

				</div>

				<!-- BUTTONS -->

				<div class="button-group">

					<button class="buy-btn">

						<i class="bi bi-lightning-charge-fill"></i>
						Buy Now

					</button>

					<form
					action="AddToCart"
					method="post"
					style="flex:1;">

						<input
						type="hidden"
						name="laptopId"
						value="<%=rs.getInt("id")%>">

						<button class="cart-btn w-100">

							<i class="bi bi-cart-plus"></i>
							Add To Cart

						</button>

					</form>

				</div>

				<!-- SPECIFICATIONS -->

				<div class="spec-box">

					<div class="spec-title">
						Specifications
					</div>

					<div class="spec-row">
						<div class="spec-name">Processor</div>
						<div class="spec-value"><%=rs.getString("processor")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">RAM</div>
						<div class="spec-value"><%=rs.getString("ram")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Storage</div>
						<div class="spec-value"><%=rs.getString("storage")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Graphics</div>
						<div class="spec-value"><%=rs.getString("graphics")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Display Size</div>
						<div class="spec-value"><%=rs.getString("display_size")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Display Type</div>
						<div class="spec-value"><%=rs.getString("display_type")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Battery</div>
						<div class="spec-value"><%=rs.getString("battery")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Operating System</div>
						<div class="spec-value"><%=rs.getString("operating_system")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Color</div>
						<div class="spec-value"><%=rs.getString("color")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Weight</div>
						<div class="spec-value"><%=rs.getString("weight")%></div>
					</div>

					<div class="spec-row">
						<div class="spec-name">Warranty</div>
						<div class="spec-value"><%=rs.getString("warranty")%></div>
					</div>

				</div>

				<!-- DESCRIPTION -->

				<div class="desc-box">

					<div class="desc-title">
						Product Description
					</div>

					<div class="desc">

						<%=rs.getString("description")%>

					</div>

				</div>

			</div>

		</div>

	</div>

</div>

<!-- IMAGE CHANGE -->

<script>

function changeImage(imagePath){

	document.getElementById("mainImage").src = imagePath;

}

</script>

</body>

</html>

<%
}
%>