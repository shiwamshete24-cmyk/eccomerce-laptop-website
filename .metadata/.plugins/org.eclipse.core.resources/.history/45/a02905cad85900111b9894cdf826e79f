<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="in.sp.model.User"%>

<%
User admin = (User) session.getAttribute("admin_details");

if (admin == null) {

	response.sendRedirect("admin_login.html");

}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Profile</title>

<!-- BOOTSTRAP -->

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
	href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
	rel="stylesheet">



</head>

<body>

	<!-- SIDEBAR -->

	<div class="sidebar">

		<h1 class="logo">TechLaptop</h1>

		<ul class="sidebar-menu">

			<li><a href="admin_dashboard.jsp"> <i
					class="bi bi-grid-fill"></i> Dashboard

			</a></li>

			<li><a href="admin_profile.jsp" class="active"> <i
					class="bi bi-person-circle"></i> Profile

			</a></li>

			<li><a href="admin_users.jsp"> <i class="bi bi-people-fill"></i>

					Users

			</a></li>

			<li><a href="admin_laptops.jsp"> <i class="bi bi-laptop"></i>

					Laptops

			</a></li>

			<li><a href="admin_orders.jsp"> <i
					class="bi bi-bag-check-fill"></i> Orders

			</a></li>

			<li><a href="Logout"> <i class="bi bi-box-arrow-right"></i>

					Logout

			</a></li>

		</ul>

	</div>

	<!-- MAIN -->

	<div class="main">

		<!-- TOPBAR -->

		<div class="topbar">

			<h2>Admin Profile</h2>

		</div>

		<!-- PROFILE CARD -->

		<div class="profile-card">

			<!-- PROFILE HEADER -->

			<div class="profile-header">

				<div class="profile-image">

					<img src="img/shiva.jpg" alt="error img" class="profile-img">

				</div>

				<div class="profile-info">

					<h1>

						<%=admin.getName()%>

					</h1>

					<p>Administrator</p>

					<p>TechLaptop Ecommerce Management System</p>

				</div>

			</div>

			<!-- DETAILS -->

			<div class="details-box">

				<!-- EMAIL -->

				<div class="detail-item">

					<div class="detail-left">

						<div class="detail-icon">

							<i class="bi bi-envelope-fill"></i>

						</div>

						<div class="detail-text">

							<h4>Email Address</h4>

							<p>

								<%=admin.getEmail()%>

							</p>

						</div>

					</div>

				</div>

				<!-- ROLE -->

				<div class="detail-item">

					<div class="detail-left">

						<div class="detail-icon">

							<i class="bi bi-shield-lock-fill"></i>

						</div>

						<div class="detail-text">

							<h4>Role</h4>

							<p>Super Administrator</p>

						</div>

					</div>

				</div>

				<!-- STATUS -->

				<div class="detail-item">

					<div class="detail-left">

						<div class="detail-icon">

							<i class="bi bi-check-circle-fill"></i>

						</div>

						<div class="detail-text">

							<h4>Account Status</h4>

							<p>Active</p>

						</div>

					</div>

				</div>

			</div>

			<!-- ACTION BUTTONS -->

			<div class="action-buttons">

				<a href="admin_dashboard.jsp" class="action-btn btn1"> <i
					class="bi bi-grid-fill"></i> Dashboard

				</a>

				<!--  		<a
			href="#"
			class="action-btn btn2">

				<i class="bi bi-pencil-square"></i>

				Update Profile

			</a>    -->

				<a href="Logout" class="action-btn btn3"> <i
					class="bi bi-box-arrow-right"></i> Logout

				</a>

			</div>

		</div>

	</div>

	<!-- BOOTSTRAP -->

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
		
	</script>

</body>

</html>