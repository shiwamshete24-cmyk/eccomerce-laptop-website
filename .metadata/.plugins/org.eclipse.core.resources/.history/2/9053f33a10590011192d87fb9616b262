<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#050816;
	color:white;
	overflow-x:hidden;
}

/* NAVBAR */

.navbar{
	background:#081120;
	padding:15px 20px;
	border-bottom:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:0;
	z-index:999;
}

.navbar-brand{
	color:#00d9ff !important;
	font-size:32px;
	font-weight:800;
}

.nav-link{
	color:white !important;
	margin-left:18px;
	font-weight:500;
	position:relative;
	transition:0.3s;
}

.nav-link::after{
	content:'';
	position:absolute;
	left:0;
	bottom:-5px;
	width:0%;
	height:2px;
	background:#00d9ff;
	transition:0.4s;
}

.nav-link:hover::after{
	width:100%;
}

.nav-link:hover{
	color:#00d9ff !important;
}

/* SIDEBAR */

.sidebar{
	background:#081120;
	min-height:100vh;
	padding:25px 20px;
	border-right:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:80px;
}

.sidebar-title{
	font-size:28px;
	font-weight:700;
	margin-bottom:30px;
	color:#00d9ff;
}

.brand-link{
	display:block;
	width:100%;
	background:rgba(255,255,255,0.05);
	color:white;
	padding:14px;
	margin-bottom:15px;
	border-radius:14px;
	text-decoration:none;
	font-weight:500;
	transition:0.4s;
}

.brand-link:hover{
	background:#00d9ff;
	color:black;
	transform:translateX(5px);
}

/* PAGE TITLE */

.page-title{
	padding:40px 10px 30px;
}

.page-title h1{
	font-size:55px;
	font-weight:800;
}

.page-title p{
	color:#bdbdbd;
	margin-top:10px;
}

/* PRODUCT CARD */

.product-card{
	background:rgba(255,255,255,0.05);
	border-radius:24px;
	overflow:hidden;
	border:1px solid rgba(255,255,255,0.08);
	transition:0.4s;
	height:100%;
	position:relative;
}

.product-card:hover{
	transform:translateY(-10px);
	box-shadow:0 20px 40px rgba(0,217,255,0.18);
}

.product-card img{
	width:100%;
	height:240px;
	object-fit:contain;
	background:white;
	padding:10px;
	transition:0.5s;
}

.product-card:hover img{
	transform:scale(1.05);
}

.badge-custom{
	position:absolute;
	top:15px;
	left:15px;
	background:#00d9ff;
	color:black;
	font-size:12px;
	font-weight:700;
	padding:8px 14px;
	border-radius:20px;
	z-index:2;
}

.product-content{
	padding:22px;
}

.product-content h4{
	font-size:23px;
	font-weight:700;
	margin-bottom:10px;
}

.product-content p{
	color:#bdbdbd;
	line-height:1.8;
	font-size:14px;
	margin-bottom:18px;
}

.price{
	color:#00d9ff;
	font-size:26px;
	font-weight:800;
}

/* BUTTONS */

.card-buttons{
	display:flex;
	gap:12px;
	margin-top:18px;
}

.show-btn{
	flex:1;
	background:transparent;
	border:2px solid #00d9ff;
	color:#00d9ff;
	padding:12px;
	border-radius:14px;
	text-decoration:none;
	font-weight:600;
	text-align:center;
	transition:0.4s;
	font-size:15px;
}

.show-btn:hover{
	background:#00d9ff;
	color:black;
	transform:translateY(-3px);
	box-shadow:0 10px 20px rgba(0,217,255,0.25);
}

.cart-btn{
	flex:1;
	background:linear-gradient(to right,#00d9ff,#0059ff);
	border:none;
	color:white;
	padding:12px;
	border-radius:14px;
	font-weight:600;
	transition:0.4s;
	font-size:15px;
}

.cart-btn:hover{
	transform:translateY(-3px);
	box-shadow:0 10px 20px rgba(0,217,255,0.35);
}

.out-btn{
	background:#444;
	cursor:not-allowed;
}

/* MOBILE */

@media(max-width:991px){

	.sidebar{
		min-height:auto;
		position:relative;
		top:0;
		border-right:none;
		border-bottom:1px solid rgba(255,255,255,0.08);
	}

	.page-title h1{
		font-size:40px;
	}

}

@media(max-width:576px){

	.card-buttons{
		flex-direction:column;
	}

}

</style>