<%@page import="in.sp.model.User"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>


<%
User user = (User)session.getAttribute("admin_details");

if(user == null){
	response.sendRedirect("login.html");
}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Admin Dashboard

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<link rel="stylesheet" href="css/admin_dashboard.css">

</head>

<body>

<%

Connection conn =
DbConnection.getConnection();

/* TOTAL USERS */

PreparedStatement ps1 =
conn.prepareStatement(
"select count(*) from users");

ResultSet rs1 =
ps1.executeQuery();

int totalUsers = 0;

if(rs1.next()){

	totalUsers =
	rs1.getInt(1);

}

/* TOTAL LAPTOPS */

PreparedStatement ps2 =
conn.prepareStatement(
"select count(*) from laptops");

ResultSet rs2 =
ps2.executeQuery();

int totalLaptops = 0;

if(rs2.next()){

	totalLaptops =
	rs2.getInt(1);

}

/* TOTAL ORDERS */

PreparedStatement ps3 =
conn.prepareStatement(
"select count(*) from orders");

ResultSet rs3 =
ps3.executeQuery();

int totalOrders = 0;

if(rs3.next()){

	totalOrders =
	rs3.getInt(1);

}

/* PENDING ORDERS */

PreparedStatement ps4 =
conn.prepareStatement(
"select count(*) from orders where order_status='pending'");

ResultSet rs4 =
ps4.executeQuery();

int pendingOrders = 0;

if(rs4.next()){

	pendingOrders =
	rs4.getInt(1);

}

%>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="sidebar-menu">

		<li>

			<a
			href="admin_dashboard.jsp"
			class="active">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_laptops.jsp">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="add_laptop.jsp">

				<i class="bi bi-plus-circle-fill"></i>

				Add Laptop

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOPBAR -->

	<div class="topbar">

		<h2>

			Admin Dashboard

		</h2>

		<div class="admin-box">

			<i class="bi bi-person-circle"></i>

			<%= user.getName()  %>

		</div>

	</div>

	<!-- CARDS -->

	<div class="row g-4">

		<!-- USERS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg1">

					<i class="bi bi-people-fill"></i>

				</div>

				<h5>

					Total Users

				</h5>

				<h1>

					<%=totalUsers%>

				</h1>

			</div>

		</div>

		<!-- LAPTOPS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg2">

					<i class="bi bi-laptop"></i>

				</div>

				<h5>

					Total Laptops

				</h5>

				<h1>

					<%=totalLaptops%>

				</h1>

			</div>

		</div>

		<!-- ORDERS -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg3">

					<i class="bi bi-bag-check-fill"></i>

				</div>

				<h5>

					Total Orders

				</h5>

				<h1>

					<%=totalOrders%>

				</h1>

			</div>

		</div>

		<!-- PENDING -->

		<div class="col-12 col-md-6 col-xl-3">

			<div class="dashboard-card">

				<div class="card-icon bg4">

					<i class="bi bi-clock-fill"></i>

				</div>

				<h5>

					Pending Orders

				</h5>

				<h1>

					<%=pendingOrders%>

				</h1>

			</div>

		</div>

	</div>

	<!-- RECENT ORDERS -->

	<div class="table-box">

		<div class="table-title">

			<h3>

				Recent Orders

			</h3>

			<button class="view-btn">

				<a href="admin_orders.jsp">view all</a>

			</button>

		</div>

		<div class="table-responsive">

			<table class="table align-middle">

				<thead>

					<tr>

						<th>Order ID</th>

						<th>User</th>

						<th>Status</th>

						<th>Payment</th>

					</tr>

				</thead>

				<tbody>

				<%

				PreparedStatement ps5 =
				conn.prepareStatement(
				"select * from orders order by id desc limit 5");

				ResultSet rs5 =
				ps5.executeQuery();

				while(rs5.next()){

				%>

					<tr>

						<td>

							#ORD<%=rs5.getInt("id")%>

						</td>

						<td>

							<%=rs5.getString("user_email")%>

						</td>

						<td>

							<span class="status pending">

								<%=rs5.getString("order_status")%>

							</span>

						</td>

						<td>

							<%=rs5.getString("payment_method")%>

						</td>

					</tr>

				<%
				}
				%>

				</tbody>

			</table>

		</div>

	</div>

</div>

<!-- BOOTSTRAP -->

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>