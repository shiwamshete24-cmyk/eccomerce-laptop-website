*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:sans-serif;
}

body{
    background:#050816;
}

/* NAVBAR */

.navbar{
    background:rgba(0,0,0,0.45);
    backdrop-filter:blur(15px);
    padding:15px 0;
    border-bottom:1px solid rgba(255,255,255,0.08);
}

/* LOGO */

.navbar-brand{
    color:#00d9ff !important;
    font-size:32px;
    font-weight:800;
}

/* NAV LINKS */

.nav-link{
    color:white !important;
    margin-left:25px;
    font-size:16px;
    font-weight:500;
    transition:0.3s;
}

.nav-link:hover{
    color:#00d9ff !important;
}

/* BUTTON */

.shop-btn{
    background:linear-gradient(to right,#00d9ff,#0059ff);
    color:white;
    padding:12px 24px;
    border-radius:40px;
    text-decoration:none;
    font-weight:600;
    transition:0.4s;
    display:inline-block;
}

.shop-btn:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 20px rgba(0,217,255,0.4);
    color:white;
}

/* MOBILE */

@media(max-width:991px){

    .navbar{
        padding:12px 0;
    }

    .navbar-collapse{
        background:#081120;
        padding:20px;
        border-radius:15px;
        margin-top:15px;
    }

    .nav-link{
        margin-left:0;
        margin-bottom:12px;
    }

    .shop-btn{
        width:100%;
        text-align:center;
    }

}