<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%
Connection conn = DbConnection.getConnection();

String sql = "select * from orders order by order_date desc";

PreparedStatement ps = conn.prepareStatement(sql);

ResultSet rs = ps.executeQuery();
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Admin Orders - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	background:#f1f5f9;

}

/* ======================
   SIDEBAR
====================== */

.sidebar{

	width:250px;

	height:100vh;

	position:fixed;

	top:0;
	left:0;

	background:linear-gradient(180deg,#0f172a,#1e293b);

	padding:25px 18px;

	overflow-y:auto;

}

.logo{

	color:white;

	font-size:32px;

	font-weight:800;

	margin-bottom:40px;

}

.menu{

	list-style:none;

	padding:0;

}

.menu li{

	margin-bottom:10px;

}

.menu li a{

	display:flex;

	align-items:center;

	gap:12px;

	padding:14px 18px;

	border-radius:14px;

	color:#cbd5e1;

	text-decoration:none;

	font-size:16px;

	font-weight:500;

	transition:0.3s;

}

.menu li a:hover,
.menu li a.active{

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

}

.menu li a i{

	font-size:18px;

}

/* ======================
   MAIN
====================== */

.main{

	margin-left:270px;

	padding:25px;

}

/* TOP */

.top-box{

	background:white;

	padding:22px 30px;

	border-radius:20px;

	margin-bottom:25px;

	box-shadow:0 4px 20px rgba(0,0,0,0.04);

}

.top-box h1{

	font-size:34px;

	font-weight:700;

	color:#0f172a;

	margin:0;

}

/* ======================
   ORDER CARD
====================== */

.order-card{

	background:white;

	border-radius:22px;

	padding:25px;

	margin-bottom:22px;

	box-shadow:0 4px 20px rgba(0,0,0,0.05);

	transition:0.3s;

}

.order-card:hover{

	transform:translateY(-4px);

}

.customer-name{

	font-size:24px;

	font-weight:700;

	color:#0f172a;

	margin-bottom:8px;

}

.order-id{

	font-size:14px;

	color:#64748b;

	font-weight:500;

}

.info{

	margin-top:18px;

}

.info p{

	font-size:15px;

	color:#334155;

	margin-bottom:10px;

}

.info span{

	font-weight:700;

	color:#0f172a;

}

/* STATUS */

.status{

	display:inline-block;

	padding:8px 16px;

	border-radius:50px;

	font-size:13px;

	font-weight:600;

	background:#ecfdf5;

	color:#10b981;

	margin-top:10px;

}

/* BUTTON */

.view-btn{

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

	border:none;

	padding:12px 22px;

	border-radius:12px;

	text-decoration:none;

	font-size:14px;

	font-weight:600;

	display:inline-block;

	margin-top:18px;

	transition:0.3s;

}

.view-btn:hover{

	transform:translateY(-2px);

	color:white;

}

/* MOBILE */

@media(max-width:992px){

	.sidebar{

		width:100%;

		height:auto;

		position:relative;

	}

	.main{

		margin-left:0;

	}

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="menu">

		<li>

			<a href="admin_dashboard.jsp">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_laptops.jsp">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp"
			   class="active">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOP -->

	<div class="top-box">

		<h1>

			User Orders

		</h1>

	</div>

	<!-- ORDERS -->

	<%
	while(rs.next()){
	%>

	<div class="order-card">

		<div class="row align-items-center">

			<!-- LEFT -->

			<div class="col-md-9">

				<h2 class="customer-name">

					<%=rs.getString("full_name")%>

				</h2>

				<p class="order-id">

					Order ID :
					#ORD<%=rs.getInt("id")%>

				</p>

				<div class="info">

					<p>

						<span>Email :</span>

						<%=rs.getString("user_email")%>

					</p>

					<p>

						<span>Phone :</span>

						<%=rs.getString("phone")%>

					</p>

					<p>

						<span>City :</span>

						<%=rs.getString("city")%>

					</p>

					<p>

						<span>Payment :</span>

						<%=rs.getString("payment_method")%>

					</p>

					<p>

						<span>Total Amount :</span>

						₹<%=rs.getDouble("total_amount")%>

					</p>

				</div>

				<div class="status">

					<%=rs.getString("order_status")%>

				</div>

			</div>

			<!-- RIGHT -->

			<div class="col-md-3 text-md-end mt-4 mt-md-0">

				<a href="user_address.jsp?id=<%=rs.getInt("id")%>"
				   class="view-btn">

					View Address

				</a>

			</div>

		</div>

	</div>

	<%
	}
	%>

</div>

</body>

</html>