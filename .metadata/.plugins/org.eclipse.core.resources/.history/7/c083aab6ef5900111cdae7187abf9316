<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Verify OTP - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<link href="css/verify_otp.css" rel="stylesheet">

<style>

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)
	),
	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

}

/* OTP INPUT */

.otp-input{

	text-align:center;

	font-size:22px !important;

	font-weight:700;

	letter-spacing:6px;

}

/* OTP ICON */

.otp-icon{

	width:90px;

	height:90px;

	background:
	rgba(255,255,255,0.12);

	border-radius:50%;

	display:flex;

	align-items:center;

	justify-content:center;

	margin:auto;

	margin-bottom:25px;

	border:
	1px solid rgba(255,255,255,0.1);

}

.otp-icon i{

	font-size:40px;

	color:white;

}

/* TEXT */

.otp-note{

	text-align:center;

	color:#d1d5db;

	font-size:14px;

	line-height:1.8;

	margin-bottom:35px;

}

.resend-text{

	text-align:center;

	margin-top:28px;

	font-size:14px;

	color:#e5e7eb;

}

.resend-text a{

	color:white;

	font-weight:700;

	text-decoration:none;

	transition:0.3s;

}

.resend-text a:hover{

	color:#d946ef;

}

</style>

</head>

<body>

<!-- OTP -->

<section class="login-wrapper">

	<div class="login-box">

		<!-- ICON -->

		<div class="otp-icon">

			<i class="bi bi-shield-lock-fill"></i>

		</div>

		<!-- TITLE -->

		<h1>

			Verify OTP

		</h1>

		<p class="otp-note">

			Enter the verification code sent to your registered
			email address to continue securely.

		</p>

		<!-- FORM -->

		<form
		action="VerifyOtp"
		method="post">

			<!-- OTP -->

			<div class="form-group">

				<label>

					Enter OTP

				</label>

				<div class="input-box">

					<i class="bi bi-key-fill"></i>

					<input
					type="text"
					name="otp"
					class="otp-input"
					placeholder="------"
					required>

				</div>

			</div>

			<!-- BUTTON -->

			<button
			type="submit"
			class="login-btn">

				Verify OTP

			</button>

			<!-- RESEND -->

			<div class="resend-text">

				Didn't receive OTP?

				<a href="#">

					Resend OTP

				</a>

			</div>

		</form>

	</div>

</section>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>