<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
	scroll-behavior:smooth;
}

body{
	background:#050816;
	color:white;
	overflow-x:hidden;
}

/* SCROLLBAR */

::-webkit-scrollbar{
	width:10px;
}

::-webkit-scrollbar-thumb{
	background:linear-gradient(#00d9ff,#0059ff);
	border-radius:20px;
}

/* NAVBAR */

.navbar{
	background:rgba(0,0,0,0.55);
	backdrop-filter:blur(15px);
	padding:15px 40px;
	border-bottom:1px solid rgba(255,255,255,0.08);
	position:sticky;
	top:0;
	z-index:999;
}

.navbar-brand{
	font-size:32px;
	font-weight:800;
	color:#00d9ff !important;
}

.nav-link{
	color:white !important;
	font-weight:500;
	margin-right:15px;
	position:relative;
	transition:0.3s;
}

.nav-link::after{
	content:'';
	position:absolute;
	width:0%;
	height:2px;
	background:#00d9ff;
	left:0;
	bottom:-5px;
	transition:0.4s;
}

.nav-link:hover::after{
	width:100%;
}

.nav-link:hover{
	color:#00d9ff !important;
}

/* BUTTON */

.custom-btn{
	background:linear-gradient(to right,#00d9ff,#0059ff);
	border:none;
	padding:12px 24px;
	border-radius:40px;
	color:white;
	font-weight:600;
	transition:0.4s;
}

.custom-btn:hover{
	transform:translateY(-4px);
	box-shadow:0 12px 30px rgba(0,217,255,0.4);
	color:white;
}

/* HERO */

.hero{
	min-height:100vh;
	display:flex;
	align-items:center;
	padding:100px 8%;
	position:relative;
	overflow:hidden;
}

.hero::before{
	content:'';
	position:absolute;
	width:600px;
	height:600px;
	background:#00d9ff;
	filter:blur(220px);
	opacity:0.12;
	top:-150px;
	right:-150px;
}

.hero::after{
	content:'';
	position:absolute;
	width:500px;
	height:500px;
	background:#0059ff;
	filter:blur(220px);
	opacity:0.12;
	bottom:-150px;
	left:-150px;
}

.hero-text{
	position:relative;
	z-index:2;
}

.hero-text h1{
	font-size:82px;
	font-weight:800;
	line-height:1.1;
	margin-bottom:25px;
	animation:slideUp 1s ease;
}

.hero-text p{
	font-size:20px;
	color:#c9c9c9;
	line-height:1.8;
	margin-bottom:35px;
	max-width:600px;
}

.hero-img{
	position:relative;
	z-index:2;
	text-align:center;
}

.hero-img img{
	width:100%;
	max-width:700px;
	animation:float 4s ease-in-out infinite;
	filter:drop-shadow(0 20px 40px rgba(0,0,0,0.6));
}

/* ANIMATION */

@keyframes float{
	0%{
		transform:translateY(0px);
	}
	50%{
		transform:translateY(-15px);
	}
	100%{
		transform:translateY(0px);
	}
}

@keyframes slideUp{
	from{
		opacity:0;
		transform:translateY(40px);
	}
	to{
		opacity:1;
		transform:translateY(0px);
	}
}

/* SECTION TITLE */

.section-title{
	text-align:center;
	font-size:48px;
	font-weight:800;
	margin-bottom:60px;
	color:#00d9ff;
}

/* CONTAINER */

.container{
	width:100%;
	max-width:1400px;
	padding-left:15px;
	padding-right:15px;
}

/* FEATURE CARD */

.feature-box{
	background:rgba(255,255,255,0.05);
	border:1px solid rgba(255,255,255,0.08);
	backdrop-filter:blur(12px);
	padding:40px 25px;
	border-radius:25px;
	text-align:center;
	height:100%;
	transition:0.5s;
}

.feature-box:hover{
	transform:translateY(-10px);
	box-shadow:0 20px 40px rgba(0,217,255,0.18);
}

.feature-box i{
	font-size:55px;
	margin-bottom:20px;
}

.feature-box h4{
	font-size:24px;
	font-weight:700;
	margin-bottom:15px;
}

.feature-box p{
	color:#bdbdbd;
	line-height:1.7;
}

/* PRODUCT CARD */

.product-card{
	background:rgba(255,255,255,0.05);
	border-radius:25px;
	border:1px solid rgba(255,255,255,0.08);
	overflow:hidden;
	height:100%;
	transition:0.5s;
	position:relative;
}

.product-card:hover{
	transform:translateY(-10px);
	box-shadow:0 20px 40px rgba(0,217,255,0.18);
}

.product-card img{
	width:100%;
	height:260px;
	object-fit:cover;
	transition:0.5s;
}

.product-card:hover img{
	transform:scale(1.08);
}

.badge-custom{
	position:absolute;
	top:15px;
	left:15px;
	background:#00d9ff;
	color:black;
	font-size:13px;
	font-weight:700;
	padding:8px 14px;
	border-radius:20px;
	z-index:2;
}

.product-content{
	padding:25px;
}

.product-content h4{
	font-size:24px;
	font-weight:700;
	margin-bottom:10px;
}

.product-content p{
	color:#bdbdbd;
	margin-bottom:18px;
}

.price{
	font-size:28px;
	font-weight:800;
	color:#00d9ff;
}

/* REVIEW CARD */

.review-card{
	background:rgba(255,255,255,0.05);
	border-radius:25px;
	padding:30px;
	border:1px solid rgba(255,255,255,0.08);
	height:100%;
	transition:0.5s;
}

.review-card:hover{
	transform:translateY(-10px);
	box-shadow:0 20px 40px rgba(0,217,255,0.18);
}

.review-user{
	width:65px;
	height:65px;
	border-radius:50%;
	object-fit:cover;
}

.review-card h5{
	font-weight:700;
}

.review-card p{
	color:#c9c9c9;
	line-height:1.8;
}

.stars{
	color:#ffc107;
}

/* STATS */

.stats-box{
	background:linear-gradient(135deg,#00d9ff22,#0059ff22);
	border-radius:30px;
	padding:60px 30px;
	border:1px solid rgba(255,255,255,0.08);
}

.stats-box h1{
	font-size:55px;
	font-weight:800;
	color:#00d9ff;
}

.stats-box p{
	color:#d0d0d0;
}

/* NEWSLETTER */

.newsletter{
