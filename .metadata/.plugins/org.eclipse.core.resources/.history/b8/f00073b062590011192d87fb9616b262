<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Forgot Password - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{

	margin:0;

	padding:0;

	box-sizing:border-box;

	font-family:'Poppins',sans-serif;

}

/* =========================
   BODY
========================= */

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)),
	url("img/myimg6.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

}

/* =========================
   NAVBAR
========================= */

.navbar{

	background:
	rgba(0,0,0,0.45);

	backdrop-filter:blur(12px);

	padding:18px 60px;

	border-bottom:
	1px solid rgba(255,255,255,0.08);

}

.navbar-brand{

	font-size:38px;

	font-weight:800;

	color:white !important;

}

.nav-link{

	color:#e5e7eb !important;

	font-size:16px;

	font-weight:500;

	margin-left:20px;

	transition:0.3s;

}

.nav-link:hover{

	color:#d946ef !important;

}

.active-btn{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	padding:10px 24px !important;

	border-radius:14px;

	color:white !important;

}

/* =========================
   MAIN SECTION
========================= */

.main-container{

	min-height:85vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:40px 20px;

}

/* =========================
   GLASS BOX
========================= */

.forgot-box{

	width:520px;

	padding:55px 45px;

	background:
	rgba(255,255,255,0.10);

	backdrop-filter:blur(18px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:32px;

	box-shadow:
	0 20px 60px rgba(0,0,0,0.45);

	color:white;

}

/* =========================
   TITLE
========================= */

.forgot-box h1{

	font-size:58px;

	font-weight:800;

	text-align:center;

	line-height:1.1;

	margin-bottom:16px;

}

.subtitle{

	text-align:center;

	color:#d1d5db;

	font-size:17px;

	margin-bottom:40px;

}

/* =========================
   LABEL
========================= */

.form-label{

	font-size:15px;

	font-weight:600;

	margin-bottom:12px;

	color:#f3f4f6;

}

/* =========================
   INPUT WRAPPER
========================= */

.input-box{

	position:relative;

	margin-bottom:28px;

}

/* =========================
   ICON
========================= */

.input-box i{

	position:absolute;

	left:20px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:18px;

}

/* =========================
   INPUT
========================= */

.form-control{

	height:68px;

	border:none;

	border-radius:20px;

	background:
	rgba(255,255,255,0.16);

	padding-left:58px;

	font-size:17px;

	color:white;

}

.form-control::placeholder{

	color:#d1d5db;

}

.form-control:focus{

	box-shadow:none;

	border:2px solid #d946ef;

	background:
	rgba(255,255,255,0.20);

	color:white;

}

/* =========================
   BUTTON
========================= */

.reset-btn{

	width:100%;

	height:70px;

	border:none;

	border-radius:22px;

	font-size:22px;

	font-weight:700;

	color:white;

	margin-top:12px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	box-shadow:
	0 12px 35px rgba(217,70,239,0.35);

	transition:0.35s;

}

.reset-btn:hover{

	transform:translateY(-5px);

	box-shadow:
	0 18px 40px rgba(217,70,239,0.5);

}

/* =========================
   BACK LINK
========================= */

.back-link{

	text-align:center;

	margin-top:28px;

}

.back-link a{

	color:#f3f4f6;

	text-decoration:none;

	font-size:15px;

	font-weight:500;

}

.back-link a:hover{

	text-decoration:underline;

	color:white;

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.navbar{

		padding:18px 25px;

	}

	.navbar-brand{

		font-size:30px;

	}

	.forgot-box{

		width:100%;

		padding:40px 28px;

	}

	.forgot-box h1{

		font-size:44px;

	}

	.subtitle{

		font-size:15px;

	}

	.reset-btn{

		font-size:18px;

		height:62px;

	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="index.html">

			TechLaptop

		</a>

		<button
		class="navbar-toggler"
		type="button"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div
		class="collapse navbar-collapse"
		id="menu">

			<ul class="navbar-nav ms-auto align-items-center">

				<li class="nav-item">

					<a
					class="nav-link"
					href="index.html">

						Home

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link active-btn"
					href="login.html">

						Login

					</a>

				</li>

				<li class="nav-item">

					<a
					class="nav-link"
					href="register.html">

						Register

					</a>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- MAIN -->

<div class="main-container">

	<div class="forgot-box">

		<h1>

			Forgot<br>Password

		</h1>

		<p class="subtitle">

			Reset your account password securely
			and continue shopping laptops.

		</p>

		<form
		action="ForgotPassword"
		method="post">

			<!-- EMAIL -->

			<label class="form-label">

				Email Address

			</label>

			<div class="input-box">

				<i class="bi bi-envelope-fill"></i>

				<input
				type="email"
				name="email"
				class="form-control"
				placeholder="Enter your email"
				required>

			</div>

			<!-- NEW PASSWORD -->

			<label class="form-label">

				New Password

			</label>

			<div class="input-box">

				<i class="bi bi-lock-fill"></i>

				<input
				type="password"
				name="new_password"
				class="form-control"
				placeholder="Enter your new password"
				required>

			</div>

			<!-- CONFIRM PASSWORD -->

			<label class="form-label">

				Confirm Password

			</label>

			<div class="input-box">

				<i class="bi bi-shield-lock-fill"></i>

				<input
				type="password"
				name="confirm_password"
				class="form-control"
				placeholder="Confirm your password"
				required>

			</div>

			<!-- BUTTON -->

			<button
			type="submit"
			class="reset-btn">

				<i class="bi bi-arrow-repeat"></i>

				Reset Password

			</button>

		</form>

		<!-- BACK -->

		<div class="back-link">

			<a href="login.html">

				<i class="bi bi-arrow-left"></i>

				Back To Login

			</a>

		</div>

	</div>

</div>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>