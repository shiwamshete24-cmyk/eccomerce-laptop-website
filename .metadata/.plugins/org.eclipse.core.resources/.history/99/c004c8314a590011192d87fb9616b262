<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>
<%@ page import="in.sp.model.User"%>

<%
User admin = (User) session.getAttribute("admin_details");

if (admin == null) {

	response.sendRedirect("admin_login.html");

}

int userId = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

PreparedStatement ps = conn.prepareStatement("select * from users where id=?");

ps.setInt(1, userId);

ResultSet rs = ps.executeQuery();

String name = "";
String email = "";

if (rs.next()) {

	name = rs.getString("name");

	email = rs.getString("email");

}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>View User</title>

<!-- BOOTSTRAP -->

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- ICONS -->

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
	href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
	rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: 'Poppins', sans-serif;
}

body {
	background: #eef2f7;
	overflow-x: hidden;
}

/* =========================
   SIDEBAR
========================= */
.sidebar {
	width: 280px;
	height: 100vh;
	position: fixed;
	top: 0;
	left: 0;
	background: linear-gradient(180deg, #111827, #1f2937);
	padding: 30px 20px;
	box-shadow: 5px 0 25px rgba(0, 0, 0, 0.12);
}

.logo {
	color: white;
	font-size: 34px;
	font-weight: 800;
	margin-bottom: 50px;
	text-align: center;
}

.sidebar-menu {
	list-style: none;
	padding: 0;
}

.sidebar-menu li {
	margin-bottom: 12px;
}

.sidebar-menu a {
	display: flex;
	align-items: center;
	gap: 15px;
	padding: 15px 18px;
	color: #d1d5db;
	text-decoration: none;
	border-radius: 16px;
	font-size: 15px;
	font-weight: 500;
	transition: 0.3s;
}

.sidebar-menu a:hover {
	background: linear-gradient(135deg, #d946ef, #9333ea);
	color: white;
	transform: translateX(5px);
}

/* =========================
   MAIN
========================= */
.main {
	margin-left: 280px;
	padding: 35px;
}

/* =========================
   TOPBAR
========================= */
.topbar {
	background: white;
	padding: 22px 30px;
	border-radius: 24px;
	box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
	margin-bottom: 35px;
}

.topbar h2 {
	font-size: 30px;
	font-weight: 800;
	color: #111827;
}

/* =========================
   PROFILE CARD
========================= */
.profile-card {
	background: white;
	border-radius: 30px;
	padding: 45px;
	box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
	position: relative;
	overflow: hidden;
}

.profile-card::before {
	content: "";
	position: absolute;
	width: 250px;
	height: 250px;
	background: radial-gradient(circle, rgba(217, 70, 239, 0.15),
		transparent);
	top: -70px;
	right: -70px;
}

/* =========================
   PROFILE HEADER
========================= */
.profile-header {
	display: flex;
	align-items: center;
	gap: 30px;
	margin-bottom: 40px;
	position: relative;
	z-index: 2;
}

.profile-image {
	width: 130px;
	height: 130px;
	border-radius: 50%;
	background: linear-gradient(135deg, #d946ef, #9333ea);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 55px;
	font-weight: 700;
	color: white;
	box-shadow: 0 10px 30px rgba(217, 70, 239, 0.35);
}

.profile-info h1 {
	font-size: 42px;
	font-weight: 800;
	color: #111827;
	margin-bottom: 10px;
}

.profile-info p {
	font-size: 16px;
	color: #6b7280;
	margin-bottom: 6px;
}

/* =========================
   DETAILS
========================= */
.detail-box {
	margin-top: 20px;
	position: relative;
	z-index: 2;
}

.detail-item {
	background: #f9fafb;
	padding: 22px 25px;
	border-radius: 20px;
	margin-bottom: 20px;
	display: flex;
	align-items: center;
	gap: 20px;
	transition: 0.3s;
}

.detail-item:hover {
	transform: translateY(-3px);
	box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}

.detail-icon {
	width: 60px;
	height: 60px;
	border-radius: 18px;
	background: linear-gradient(135deg, #d946ef, #9333ea);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 24px;
	color: white;
}

.detail-text h4 {
	font-size: 18px;
	font-weight: 700;
	color: #111827;
	margin-bottom: 5px;
}

.detail-text p {
	color: #6b7280;
	margin: 0;
}

/* =========================
   BUTTONS
========================= */
.action-buttons {
	margin-top: 35px;
	display: flex;
	gap: 20px;
	flex-wrap: wrap;
	position: relative;
	z-index: 2;
}

.action-btn {
	padding: 15px 28px;
	border: none;
	border-radius: 16px;
	font-size: 16px;
	font-weight: 700;
	text-decoration: none;
	color: white;
	transition: 0.3s;
}

.btn1 {
	background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.btn2 {
	background: linear-gradient(135deg, #ef4444, #dc2626);
}

.action-btn:hover {
	transform: translateY(-4px);
	color: white;
	box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
}

/* =========================
   MOBILE
========================= */
@media ( max-width :991px) {
	.sidebar {
		width: 100%;
		height: auto;
		position: relative;
	}
	.main {
		margin-left: 0;
	}
	.profile-header {
		flex-direction: column;
		text-align: center;
	}
}
</style>

</head>

<body>

	<!-- SIDEBAR -->

	<div class="sidebar">

		<h1 class="logo">TechLaptop</h1>

		<ul class="sidebar-menu">

			<li><a href="admin_dashboard.jsp"> <i
					class="bi bi-grid-fill"></i> Dashboard

			</a></li>

			<li><a href="admin_profile.jsp"> <i
					class="bi bi-person-circle"></i> Profile

			</a></li>

			<li><a href="admin_users.jsp"> <i class="bi bi-people-fill"></i>

					Users

			</a></li>

			<li><a href="admin_laptops.jsp"> <i class="bi bi-laptop"></i>

					Laptops

			</a></li>

			<li><a href="admin_orders.jsp"> <i
					class="bi bi-bag-check-fill"></i> Orders

			</a></li>

		</ul>

	</div>

	<!-- MAIN -->

	<div class="main">

		<!-- TOPBAR -->

		<div class="topbar">

			<h2>User Details</h2>

		</div>

		<!-- PROFILE CARD -->

		<div class="profile-card">

			<div class="profile-header">

				<div class="profile-image">

					<%=name.substring(0, 1).toUpperCase()%>

				</div>

				<div class="profile-info">

					<h1>

						<%=name%>

					</h1>

					<p>Registered User</p>

					<p>TechLaptop Ecommerce Customer</p>

				</div>

			</div>

			<!-- DETAILS -->

			<div class="detail-box">

				<!-- NAME -->

				<div class="detail-item">

					<div class="detail-icon">

						<i class="bi bi-person-fill"></i>

					</div>

					<div class="detail-text">

						<h4>Full Name</h4>

						<p>

							<%=name%>

						</p>

					</div>

				</div>

				<!-- EMAIL -->

				<div class="detail-item">

					<div class="detail-icon">

						<i class="bi bi-envelope-fill"></i>

					</div>

					<div class="detail-text">

						<h4>Email Address</h4>

						<p>

							<%=email%>

						</p>

					</div>

				</div>

				<!-- STATUS -->

				<div class="detail-item">

					<div class="detail-icon">

						<i class="bi bi-check-circle-fill"></i>

					</div>

					<div class="detail-text">

						<h4>Account Status</h4>

						<p>Active</p>

					</div>

				</div>

			</div>

			<!-- BUTTONS -->

			<div class="action-buttons">

				<a href="admin_users.jsp" class="action-btn btn1"> <i
					class="bi bi-arrow-left"></i> Back

				</a> <a href="DeleteUser?id=<%=userId%>" class="action-btn btn2"> <i
					class="bi bi-trash-fill"></i> Delete User

				</a>

			</div>

		</div>

	</div>

	<!-- BOOTSTRAP -->

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
		
	</script>

</body>

</html>