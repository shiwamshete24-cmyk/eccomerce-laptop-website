<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%
int id = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

String sql = "select * from laptops where id=?";

PreparedStatement ps = conn.prepareStatement(sql);

ps.setInt(1, id);

ResultSet rs = ps.executeQuery();

if (rs.next()) {

	int stock = rs.getInt("stock");
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%=rs.getString("name")%></title>

<!-- BOOTSTRAP -->

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">

<!-- ICON -->

<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- FONT -->

<link
	href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
	rel="stylesheet">

<style>
* {
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	font-family: 'Poppins', sans-serif;
}

body {
	background: #eceff3;
	color: #111827;
}

/* NAVBAR */
.navbar {
	background: white;
	padding: 18px 35px;
	box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
	position: sticky;
	top: 0;
	z-index: 999;
}

.logo {
	font-size: 32px;
	font-weight: 800;
	color: #0077ff;
	text-decoration: none;
	display: flex;
	align-items: center;
	gap: 10px;
}

.logo:hover {
	color: #005fe0;
}

.nav-link-custom {
	color: #374151;
	text-decoration: none;
	font-weight: 600;
	margin-left: 28px;
	transition: 0.3s;
	display: flex;
	align-items: center;
	gap: 8px;
	font-size: 15px;
}

.nav-link-custom:hover {
	color: #0077ff;
	transform: translateY(-2px);
}

.navbar-toggler {
	border: none;
}

.navbar-toggler:focus {
	box-shadow: none;
}

/* MAIN */
.main-section {
	padding: 40px 0;
}

/* PRODUCT WRAPPER */
.product-wrapper {
	background: white;
	border-radius: 25px;
	padding: 35px;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
}

/* LEFT SIDE */
.left-side {
	position: sticky;
	top: 100px;
}

/* IMAGE */
.main-image-box {
	background: #fff;
	border: 1px solid #eee;
	border-radius: 25px;
	height: 520px;
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
	cursor: zoom-in;
}

.main-image {
	width: 100%;
	height: 100%;
	object-fit: contain;
	padding: 20px;
	transition: 0.4s ease;
}

.main-image-box:hover .main-image {
	transform: scale(1.35);
}

/* THUMBNAILS */
.thumbnail-row {
	display: flex;
	gap: 15px;
	margin-top: 20px;
	justify-content: center;
	flex-wrap: wrap;
}

.thumb {
	width: 90px;
	height: 90px;
	object-fit: contain;
	background: white;
	border: 2px solid #eee;
	border-radius: 16px;
	padding: 8px;
	cursor: pointer;
	transition: 0.3s;
}

.thumb:hover {
	border-color: #0077ff;
	transform: translateY(-4px);
	box-shadow: 0 10px 20px rgba(0, 119, 255, 0.12);
}

/* RIGHT SIDE */
.brand {
	color: #0077ff;
	font-weight: 700;
	font-size: 15px;
	margin-bottom: 12px;
	text-transform: uppercase;
	letter-spacing: 1px;
}

.title {
	font-size: 38px;
	font-weight: 800;
	line-height: 1.4;
	margin-bottom: 18px;
}

/* RATING */
.rating-row {
	display: flex;
	align-items: center;
	gap: 12px;
	margin-bottom: 22px;
	flex-wrap: wrap;
}

.stars {
	background: #00b67a;
	color: white;
	padding: 6px 12px;
	border-radius: 8px;
	font-size: 14px;
	font-weight: 700;
}

.review-text {
	color: #666;
	font-size: 15px;
}

/* PRICE */
.price-section {
	margin-bottom: 28px;
}

.new-price {
	font-size: 44px;
	font-weight: 800;
	color: #111827;
}

.old-price {
	font-size: 24px;
	color: #9ca3af;
	text-decoration: line-through;
	margin-left: 14px;
}

.discount {
	color: #00b67a;
	font-weight: 700;
	font-size: 18px;
	margin-left: 14px;
}

/* STOCK */
.stock {
	font-size: 17px;
	font-weight: 700;
	margin-bottom: 25px;
}

.in-stock {
	color: #00b67a;
}

.out-stock {
	color: red;
}

/* FEATURES */
.feature-row {
	display: flex;
	gap: 15px;
	margin-bottom: 30px;
	flex-wrap: wrap;
}

.feature {
	background: #f3f6fb;
	padding: 18px;
	border-radius: 18px;
	text-align: center;
	flex: 1;
	min-width: 120px;
}

.feature i {
	font-size: 28px;
	color: #0077ff;
	margin-bottom: 10px;
}

.feature p {
	margin: 0;
	font-size: 14px;
	font-weight: 600;
}

/* BUTTONS */
.button-row {
	display: flex;
	gap: 18px;
	margin-bottom: 35px;
}

.buy-btn {
	flex: 1;
	background: #ff9f00;
	border: none;
	color: white;
	padding: 16px;
	border-radius: 14px;
	font-size: 17px;
	font-weight: 700;
	transition: 0.3s;
}

.buy-btn:hover {
	background: #f59e0b;
	transform: translateY(-3px);
}

.cart-btn {
	flex: 1;
	background: #0077ff;
	border: none;
	color: white;
	padding: 16px;
	border-radius: 14px;
	font-size: 17px;
	font-weight: 700;
	transition: 0.3s;
}

.cart-btn:hover {
	background: #005fe0;
	transform: translateY(-3px);
}

/* SPECIFICATIONS */
.spec-box {
	background: #f9fafb;
	border-radius: 22px;
	padding: 28px;
	margin-top: 20px;
	border: 1px solid #eee;
}

.spec-title {
	font-size: 24px;
	font-weight: 700;
	margin-bottom: 22px;
}

.spec-row {
	display: flex;
	justify-content: space-between;
	padding: 14px 0;
	border-bottom: 1px solid #e5e7eb;
}

.spec-row:last-child {
	border-bottom: none;
}

.spec-name {
	color: #6b7280;
	font-weight: 500;
}

.spec-value {
	font-weight: 600;
	text-align: right;
}

/* DESCRIPTION */
.desc-box {
	background: #f9fafb;
	border-radius: 22px;
	padding: 28px;
	margin-top: 25px;
	border: 1px solid #eee;
}

.desc-title {
	font-size: 24px;
	font-weight: 700;
	margin-bottom: 18px;
}

.desc {
	color: #4b5563;
	line-height: 2;
	font-size: 15px;
}

/* MOBILE */
@media ( max-width :991px) {
	.left-side {
		position: relative;
		top: 0;
	}
	.title {
		font-size: 30px;
		margin-top: 25px;
	}
	.main-image-box {
		height: 350px;
	}
}

@media ( max-width :576px) {
	.product-wrapper {
		padding: 20px;
	}
	.button-row {
		flex-direction: column;
	}
	.title {
		font-size: 24px;
	}
	.new-price {
		font-size: 34px;
	}
	.thumb {
		width: 70px;
		height: 70px;
	}
}
</style>

</head>

<body>

	<!-- NAVBAR -->

	<nav class="navbar navbar-expand-lg">

		<div class="container-fluid">

			<!-- LOGO -->

			<a href="home.jsp" class="logo"> <i class="bi bi-laptop"></i>

				TechLaptop

			</a>

			<!-- MOBILE TOGGLE -->

			<button class="navbar-toggler" type="button"
				data-bs-toggle="collapse" data-bs-target="#navbarMenu">

				<span class="navbar-toggler-icon"></span>

			</button>

			<!-- MENU -->

			<div class="collapse navbar-collapse" id="navbarMenu">

				<ul class="navbar-nav ms-auto align-items-lg-center">

					<li class="nav-item"><a class="nav-link-custom"
						href="home.jsp"> <i class="bi bi-house-door"></i> Home

					</a></li>

					<li class="nav-item"><a class="nav-link-custom"
						href="laptops.jsp"> <i class="bi bi-laptop"></i> Laptops

					</a></li>

					<li class="nav-item"><a class="nav-link-custom"
						href="cart.jsp"> <i class="bi bi-cart3"></i> Cart

					</a></li>

					<li class="nav-item"><a class="nav-link-custom"
						href="profile.jsp"> <i class="bi bi-person-circle"></i>
							Profile

					</a></li>

				</ul>

			</div>

		</div>

	</nav>

	<!-- MAIN -->

	<div class="container main-section">

		<div class="product-wrapper">

			<div class="row g-5">

				<!-- LEFT -->

				<div class="col-lg-5">

					<div class="left-side">

						<!-- MAIN IMAGE -->

						<div class="main-image-box">

							<img id="mainImage"
								src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
								class="main-image">

						</div>

						<!-- THUMBNAILS -->

						<div class="thumbnail-row">

							<img
								src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
								class="thumb" onclick="changeImage(this.src)"> <img
								src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image2")%>"
								class="thumb" onclick="changeImage(this.src)"> <img
								src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image3")%>"
								class="thumb" onclick="changeImage(this.src)">

						</div>

					</div>

				</div>

				<!-- RIGHT -->

				<div class="col-lg-7">

					<div class="brand">
						<%=rs.getString("brand")%>
					</div>

					<h1 class="title">
						<%=rs.getString("name")%>
					</h1>

					<!-- RATING -->

					<div class="rating-row">

						<div class="stars">★★★★☆</div>

						<div class="review-text">

							<%=rs.getDouble("rating")%>

							(
							<%=rs.getInt("total_reviews")%>
							Reviews )

						</div>

					</div>

					<!-- PRICE -->

					<div class="price-section">

						<span class="new-price"> ₹<%=rs.getInt("price")%>

						</span> <span class="old-price"> ₹<%=rs.getInt("old_price")%>

						</span> <span class="discount"> 20% OFF </span>

					</div>

					<!-- STOCK -->

					<div class="stock">

						<%
						if (stock > 0) {
						%>

						<span class="in-stock"> <i class="bi bi-check-circle-fill"></i>

							In Stock ( <%=stock%> left )

						</span>

						<%
						} else {
						%>

						<span class="out-stock"> <i class="bi bi-x-circle-fill"></i>

							Out Of Stock

						</span>

						<%
						}
						%>

					</div>

					<!-- FEATURES -->

					<div class="feature-row">

						<div class="feature">

							<i class="bi bi-truck"></i>

							<p>Fast Delivery</p>

						</div>

						<div class="feature">

							<i class="bi bi-shield-check"></i>

							<p>1 Year Warranty</p>

						</div>

						<div class="feature">

							<i class="bi bi-arrow-repeat"></i>

							<p>7 Days Return</p>

						</div>

					</div>

					<!-- BUTTONS -->

					<div class="button-row">

						<button class="buy-btn">

							<i class="bi bi-lightning-charge-fill"></i> Buy Now

						</button>

						<form action="AddToCart" method="post" style="flex: 1;">

							<input type="hidden" name="laptopId" value="<%=rs.getInt("id")%>">

							<button class="cart-btn w-100">

								<i class="bi bi-cart-plus"></i> Add To Cart

							</button>

						</form>

					</div>

					<!-- SPECIFICATIONS -->

					<div class="spec-box">

						<div class="spec-title">Specifications</div>

						<div class="spec-row">
							<div class="spec-name">Processor</div>
							<div class="spec-value"><%=rs.getString("processor")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">RAM</div>
							<div class="spec-value"><%=rs.getString("ram")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Storage</div>
							<div class="spec-value"><%=rs.getString("storage")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Graphics</div>
							<div class="spec-value"><%=rs.getString("graphics")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Display Size</div>
							<div class="spec-value"><%=rs.getString("display_size")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Display Type</div>
							<div class="spec-value"><%=rs.getString("display_type")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Battery</div>
							<div class="spec-value"><%=rs.getString("battery")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Operating System</div>
							<div class="spec-value"><%=rs.getString("operating_system")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Color</div>
							<div class="spec-value"><%=rs.getString("color")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Weight</div>
							<div class="spec-value"><%=rs.getString("weight")%></div>
						</div>

						<div class="spec-row">
							<div class="spec-name">Warranty</div>
							<div class="spec-value"><%=rs.getString("warranty")%></div>
						</div>

					</div>

					<!-- DESCRIPTION -->

					<div class="desc-box">

						<div class="desc-title">Product Description</div>

						<div class="desc">

							<%=rs.getString("description")%>

						</div>

					</div>

				</div>

			</div>

		</div>

	</div>

	<!-- IMAGE CHANGE -->

	<script>
		function changeImage(imagePath) {

			document.getElementById("mainImage").src = imagePath;

		}
	</script>

	<!-- BOOTSTRAP JS -->

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
		
	</script>

</body>

</html>

<%
}
%>