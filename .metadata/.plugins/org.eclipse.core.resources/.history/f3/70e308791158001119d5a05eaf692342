<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="in.sp.model.User"%>

<%
User user = (User)session.getAttribute("userData");

if(user == null){
	response.sendRedirect("login.jsp");
}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Contact Us</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<!-- CSS -->

<link rel="stylesheet" href="css/contact.css">

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="profile.jsp">
			TechLaptop
		</a>

		<button
		class="navbar-toggler"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div class="collapse navbar-collapse" id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">
					<a class="nav-link" href="home.jsp">
						Home
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="laptops.jsp">
						Laptops
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="about.jsp">
						About
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link active" href="contact.jsp">
						Contact
					</a>
				</li>
				
				<li class="nav-item">
					<a class="nav-link" href="orders.jsp">Orders</a>
				</li>

			</ul>

			<ul class="navbar-nav ms-4 align-items-center">

				<li class="nav-item me-3">

					<a href="cart.jsp" class="custom-btn">

						<i class="bi bi-cart3"></i>
						Cart

					</a>

				</li>

				<li class="nav-item dropdown">

					<a
					class="nav-link dropdown-toggle user-btn"
					data-bs-toggle="dropdown">

						<i class="bi bi-person-circle"></i>
						<%=user.getUsername()%>

					</a>

					<ul class="dropdown-menu dropdown-menu-end">

						<li>
							<a class="dropdown-item" href="#">
								Profile
							</a>
						</li>

						<li>
							<a class="dropdown-item text-danger" href="Logout">
								Logout
							</a>
						</li>

					</ul>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- HERO -->

<section class="contact-hero">

	<div class="container text-center">

		<h1>
			Contact <span>Us</span>
		</h1>

		<p>

			We are here to help you with laptops,
			orders and premium customer support.

		</p>

	</div>

</section>

<!-- CONTACT SECTION -->

<section class="container py-5">

	<div class="row g-4">

		<!-- LEFT -->

		<div class="col-12 col-lg-5">

			<div class="contact-info">

				<h2>
					Get In Touch
				</h2>

				<p>

					Feel free to contact us anytime.
					We will respond as soon as possible.

				</p>

				<div class="info-box">

					<i class="bi bi-geo-alt-fill"></i>

					<div>

						<h5>Address</h5>

						<p>
							Pune, Maharashtra, India
						</p>

					</div>

				</div>

				<div class="info-box">

					<i class="bi bi-envelope-fill"></i>

					<div>

						<h5>Email</h5>

						<p>
							support@techlaptop.com
						</p>

					</div>

				</div>

				<div class="info-box">

					<i class="bi bi-telephone-fill"></i>

					<div>

						<h5>Phone</h5>

						<p>
							+91 9876543210
						</p>

					</div>

				</div>

				<div class="social-icons">

					<a href="#">
						<i class="bi bi-facebook"></i>
					</a>

					<a href="#">
						<i class="bi bi-instagram"></i>
					</a>

					<a href="#">
						<i class="bi bi-twitter"></i>
					</a>

					<a href="#">
						<i class="bi bi-youtube"></i>
					</a>

				</div>

			</div>

		</div>

		<!-- RIGHT -->

		<div class="col-12 col-lg-7">

			<div class="contact-form">

				<h2>
					Send Message
				</h2>

				<form>

					<div class="row">

						<div class="col-12 col-md-6 mb-4">

							<input
							type="text"
							placeholder="Your Name"
							required>

						</div>

						<div class="col-12 col-md-6 mb-4">

							<input
							type="email"
							placeholder="Your Email"
							required>

						</div>

					</div>

					<input
					type="text"
					placeholder="Subject"
					class="mb-4"
					required>

					<textarea
					rows="6"
					placeholder="Write Your Message"
					required></textarea>

					<button type="submit" class="custom-btn mt-4">

						Send Message

					</button>

				</form>

			</div>

		</div>

	</div>

</section>

<!-- MAP -->

<section class="container pb-5">

	<div class="map-box">

		<iframe
		src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3783.208689968886!2d73.856743!3d18.520430!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bc2c06d5f0b8fcb%3A0x123456789!2sPune!5e0!3m2!1sen!2sin!4v1710000000000"
		width="100%"
		height="450"
		style="border:0;"
		allowfullscreen=""
		loading="lazy">
		</iframe>

	</div>

</section>

<!-- FOOTER -->

<footer class="footer">

	<div class="container">

		<div class="row">

			<div class="col-12 col-lg-4">

				<h2 class="footer-logo">
					TechLaptop
				</h2>

				<p>

					Premium ecommerce platform for
					gaming and business laptops.

				</p>

			</div>

			<div class="col-6 col-lg-2">

				<h4>Links</h4>

				<ul class="footer-links">

					<li><a href="#">Home</a></li>
					<li><a href="#">Laptops</a></li>
					<li><a href="#">Deals</a></li>

				</ul>

			</div>

			<div class="col-6 col-lg-3">

				<h4>Categories</h4>

				<ul class="footer-links">

					<li><a href="#">Gaming</a></li>
					<li><a href="#">Business</a></li>
					<li><a href="#">Student</a></li>

				</ul>

			</div>

			<div class="col-12 col-lg-3">

				<h4>Contact</h4>

				<p>
					<i class="bi bi-envelope"></i>
					support@techlaptop.com
				</p>

				<p>
					<i class="bi bi-telephone"></i>
					+91 9876543210
				</p>

			</div>

		</div>

	</div>

</footer>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>