<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Admin Panel - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	background:#f1f5f9;

}

/* ======================
   SIDEBAR
====================== */

.sidebar{

	width:250px;

	height:100vh;

	position:fixed;

	top:0;
	left:0;

	background:linear-gradient(180deg,#0f172a,#1e293b);

	padding:25px 18px;

	overflow-y:auto;

}

.logo{

	color:white;

	font-size:32px;

	font-weight:800;

	margin-bottom:40px;

}

.menu{

	list-style:none;

	padding:0;

}

.menu li{

	margin-bottom:10px;

}

.menu li a{

	display:flex;

	align-items:center;

	gap:12px;

	padding:14px 18px;

	border-radius:14px;

	color:#cbd5e1;

	text-decoration:none;

	font-size:16px;

	font-weight:500;

	transition:0.3s;

}

.menu li a:hover,
.menu li a.active{

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

}

.menu li a i{

	font-size:18px;

}

/* ======================
   MAIN
====================== */

.main{

	margin-left:270px;

	padding:25px;

}

/* TOP */

.top-box{

	background:white;

	padding:22px 30px;

	border-radius:20px;

	margin-bottom:25px;

	box-shadow:0 4px 20px rgba(0,0,0,0.04);

}

.top-box h1{

	font-size:34px;

	font-weight:700;

	color:#0f172a;

	margin:0;

}

/* FORM */

.form-box{

	background:white;

	border-radius:25px;

	padding:35px;

	box-shadow:0 4px 20px rgba(0,0,0,0.04);

}

.form-box h2{

	font-size:30px;

	font-weight:700;

	color:#0f172a;

	margin-bottom:30px;

}

/* LABEL */

.form-label{

	font-size:15px;

	font-weight:600;

	color:#334155;

	margin-bottom:8px;

}

/* INPUT */

.form-control,
.form-select{

	height:52px;

	border:none;

	background:#f8fafc;

	border-radius:12px;

	font-size:15px;

	padding-left:15px;

}

.form-control:focus,
.form-select:focus{

	box-shadow:none;

	border:1px solid #9333ea;

	background:white;

}

textarea.form-control{

	height:120px;

	padding-top:15px;

	resize:none;

}

/* BUTTON */

.submit-btn{

	background:linear-gradient(90deg,#c026ff,#9333ea);

	border:none;

	color:white;

	width:100%;

	height:55px;

	border-radius:14px;

	font-size:17px;

	font-weight:600;

	margin-top:10px;

	transition:0.3s;

}

.submit-btn:hover{

	transform:translateY(-2px);

	box-shadow:0 8px 20px rgba(147,51,234,0.2);

}

/* ======================
   MOBILE
====================== */

@media(max-width:992px){

	.sidebar{

		width:100%;

		height:auto;

		position:relative;

	}

	.main{

		margin-left:0;

	}

	.logo{

		font-size:28px;

		margin-bottom:25px;

	}

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="menu">

		<li>

			<a href="admin_dashboard.jsp">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_laptops.jsp"
			   class="active">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="admin_payments.jsp">

				<i class="bi bi-credit-card-fill"></i>

				Payments

			</a>

		</li>

		<li>

			<a href="admin_reviews.jsp">

				<i class="bi bi-star-fill"></i>

				Reviews

			</a>

		</li>

		<li>

			<a href="admin_settings.jsp">

				<i class="bi bi-gear-fill"></i>

				Settings

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOP -->

	<div class="top-box">

		<h1>

			Add New Laptop

		</h1>

	</div>

	<!-- FORM -->

	<div class="form-box">

		<h2>

			Laptop Information

		</h2>

		<form>

			<div class="row g-4">

				<!-- BRAND -->

				<div class="col-md-6">

					<label class="form-label">

						Brand

					</label>

					<select class="form-select">

						<option>Select Brand</option>

						<option>HP</option>

						<option>Dell</option>

						<option>Lenovo</option>

						<option>ASUS</option>

						<option>Acer</option>

					</select>

				</div>

				<!-- NAME -->

				<div class="col-md-6">

					<label class="form-label">

						Laptop Name

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="Enter Laptop Name">

				</div>

				<!-- PRICE -->

				<div class="col-md-6">

					<label class="form-label">

						Price

					</label>

					<input
					type="number"
					class="form-control"
					placeholder="Enter Price">

				</div>

				<!-- OLD PRICE -->

				<div class="col-md-6">

					<label class="form-label">

						Old Price

					</label>

					<input
					type="number"
					class="form-control"
					placeholder="Enter Old Price">

				</div>

				<!-- PROCESSOR -->

				<div class="col-md-6">

					<label class="form-label">

						Processor

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="Intel i7">

				</div>

				<!-- RAM -->

				<div class="col-md-6">

					<label class="form-label">

						RAM

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="16GB DDR5">

				</div>

				<!-- STORAGE -->

				<div class="col-md-6">

					<label class="form-label">

						Storage

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="512GB SSD">

				</div>

				<!-- GRAPHICS -->

				<div class="col-md-6">

					<label class="form-label">

						Graphics

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="RTX 4060">

				</div>

				<!-- DESCRIPTION -->

				<div class="col-12">

					<label class="form-label">

						Description

					</label>

					<textarea
					class="form-control"
					placeholder="Enter laptop description"></textarea>

				</div>

				<!-- IMAGE -->

				<div class="col-12">

					<label class="form-label">

						Laptop Image

					</label>

					<input
					type="file"
					class="form-control">

				</div>

				<!-- BUTTON -->

				<div class="col-12">

					<button
					type="submit"
					class="submit-btn">

						Add Laptop

					</button>

				</div>

			</div>

		</form>

	</div>

</div>

</body>

</html>