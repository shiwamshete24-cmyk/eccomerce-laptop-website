

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	min-height:100vh;

	display:flex;

	justify-content:center;

	align-items:center;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)
	),
	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	padding:20px;

}

/* OTP BOX */

.otp-box{

	width:100%;
	max-width:420px;

	background:rgba(255,255,255,0.12);

	backdrop-filter:blur(15px);

	border:1px solid rgba(255,255,255,0.2);

	border-radius:28px;

	padding:40px 35px;

	box-shadow:0 10px 35px rgba(0,0,0,0.3);

	color:white;

	text-align:center;

	animation:fadeIn 0.6s ease;

}

/* ICON */

.otp-icon{

	width:90px;

	height:90px;

	background:rgba(255,255,255,0.15);

	border-radius:50%;

	display:flex;

	align-items:center;

	justify-content:center;

	margin:auto;

	margin-bottom:20px;

}

.otp-icon i{

	font-size:42px;

	color:#fff;

}

/* TITLE */

.otp-box h2{

	font-size:32px;

	font-weight:700;

	margin-bottom:10px;

}

.otp-box p{

	font-size:15px;

	color:#d1d5db;

	margin-bottom:30px;

	line-height:1.7;

}

/* INPUT */

.form-control{

	height:58px;

	border:none;

	border-radius:15px;

	padding-left:18px;

	font-size:16px;

	background:rgba(255,255,255,0.9);

	margin-bottom:22px;

}

.form-control:focus{

	box-shadow:none;

	border:2px solid #8b5cf6;

}

/* BUTTON */

.verify-btn{

	width:100%;

	height:56px;

	border:none;

	border-radius:15px;

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

	font-size:17px;

	font-weight:600;

	transition:0.3s;

}

.verify-btn:hover{

	transform:translateY(-3px);

	box-shadow:0 10px 25px rgba(147,51,234,0.4);

}

/* TEXT */

.bottom-text{

	margin-top:20px;

	font-size:14px;

	color:#d1d5db;

}

.bottom-text a{

	color:#fff;

	font-weight:600;

	text-decoration:none;

}

.bottom-text a:hover{

	text-decoration:underline;

}

/* ANIMATION */

@keyframes fadeIn{

	from{

		opacity:0;
		transform:translateY(20px);

	}

	to{

		opacity:1;
		transform:translateY(0);

	}

}

