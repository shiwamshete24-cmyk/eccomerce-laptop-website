<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%

int id = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

String sql = "select * from laptops where id=?";

PreparedStatement ps = conn.prepareStatement(sql);

ps.setInt(1, id);

ResultSet rs = ps.executeQuery();

if(rs.next()){

	int stock = rs.getInt("stock");

%>

<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>
<%=rs.getString("name")%>
</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICON -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#050816;
	color:white;
	overflow-x:hidden;
}

/* NAVBAR */

.navbar{
	background:#081120;
	padding:15px 30px;
	border-bottom:1px solid rgba(255,255,255,0.08);
}

.navbar-brand{
	color:#00d9ff !important;
	font-size:32px;
	font-weight:800;
}

/* MAIN PRODUCT */

.product-section{
	padding:50px 0;
}

.product-box{
	background:#081120;
	border-radius:30px;
	padding:40px;
	border:1px solid rgba(255,255,255,0.08);
}

/* IMAGE */

.main-image{
	width:100%;
	height:500px;
	object-fit:contain;
	background:white;
	border-radius:20px;
	padding:20px;
	transition:0.4s;
}

.main-image:hover{
	transform:scale(1.03);
}

/* THUMBNAILS */

.thumbnail-row{
	display:flex;
	gap:15px;
	margin-top:20px;
}

.thumbnail{
	width:90px;
	height:90px;
	object-fit:contain;
	background:white;
	border-radius:15px;
	padding:10px;
	cursor:pointer;
	border:2px solid transparent;
	transition:0.3s;
}

.thumbnail:hover{
	border-color:#00d9ff;
	transform:translateY(-3px);
}

/* PRODUCT DETAILS */

.brand{
	color:#00d9ff;
	font-size:18px;
	font-weight:600;
	margin-bottom:8px;
}

.product-title{
	font-size:42px;
	font-weight:800;
	line-height:1.3;
	margin-bottom:18px;
}

/* RATING */

.rating-box{
	display:flex;
	align-items:center;
	gap:12px;
	margin-bottom:20px;
}

.stars{
	color:gold;
	font-size:18px;
}

.review-count{
	color:#bbb;
}

/* PRICE */

.price-section{
	margin-bottom:25px;
}

.new-price{
	font-size:42px;
	font-weight:800;
	color:#00d9ff;
}

.old-price{
	font-size:24px;
	text-decoration:line-through;
	color:#777;
	margin-left:15px;
}

.discount{
	background:#00ff88;
	color:black;
	padding:5px 12px;
	border-radius:20px;
	font-size:14px;
	font-weight:700;
	margin-left:15px;
}

/* STOCK */

.stock-box{
	margin-bottom:25px;
}

.in-stock{
	color:#00ff88;
	font-weight:700;
	font-size:18px;
}

.out-stock{
	color:red;
	font-weight:700;
	font-size:18px;
}

/* SPECIFICATIONS */

.spec-box{
	background:rgba(255,255,255,0.04);
	padding:25px;
	border-radius:20px;
	margin-top:25px;
}

.spec-title{
	font-size:24px;
	font-weight:700;
	margin-bottom:20px;
	color:#00d9ff;
}

.spec-item{
	display:flex;
	justify-content:space-between;
	padding:14px 0;
	border-bottom:1px solid rgba(255,255,255,0.06);
}

.spec-item:last-child{
	border-bottom:none;
}

.spec-name{
	color:#aaa;
	font-weight:500;
}

.spec-value{
	font-weight:600;
}

/* BUTTONS */

.button-group{
	display:flex;
	gap:15px;
	margin-top:30px;
}

.buy-btn{
	flex:1;
	background:#00d9ff;
	color:black;
	border:none;
	padding:16px;
	border-radius:16px;
	font-size:18px;
	font-weight:700;
	transition:0.4s;
}

.buy-btn:hover{
	transform:translateY(-4px);
	box-shadow:0 15px 30px rgba(0,217,255,0.25);
}

.cart-btn{
	flex:1;
	background:linear-gradient(to right,#00d9ff,#0059ff);
	color:white;
	border:none;
	padding:16px;
	border-radius:16px;
	font-size:18px;
	font-weight:700;
	transition:0.4s;
}

.cart-btn:hover{
	transform:translateY(-4px);
	box-shadow:0 15px 30px rgba(0,217,255,0.25);
}

/* DESCRIPTION */

.description-box{
	margin-top:35px;
	background:rgba(255,255,255,0.04);
	padding:25px;
	border-radius:20px;
}

.description-title{
	font-size:24px;
	font-weight:700;
	color:#00d9ff;
	margin-bottom:15px;
}

.description{
	color:#ccc;
	line-height:1.9;
	font-size:16px;
}

/* MOBILE */

@media(max-width:991px){

	.product-title{
		font-size:32px;
		margin-top:30px;
	}

	.main-image{
		height:350px;
	}

}

@media(max-width:576px){

	.button-group{
		flex-direction:column;
	}

	.product-title{
		font-size:26px;
	}

	.new-price{
		font-size:34px;
	}

}

</style>

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="home.jsp">
			TechLaptop
		</a>

	</div>

</nav>

<!-- PRODUCT SECTION -->

<div class="container product-section">

	<div class="product-box">

		<div class="row">

			<!-- IMAGE SIDE -->

			<div class="col-lg-6">

				<img
				src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
				class="main-image">

				<div class="thumbnail-row">

					<img
					src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("image1")%>"
					class="thumbnail">

					<img
					src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("img2")%>"
					class="thumbnail">

					<img
					src="<%=request.getContextPath()%>/images/laptops/<%=rs.getString("img3")%>"
					class="thumbnail">

				</div>

			</div>

			<!-- DETAILS SIDE -->

			<div class="col-lg-6">

				<div class="brand">
					<%=rs.getString("brand")%>
				</div>

				<h1 class="product-title">
					<%=rs.getString("name")%>
				</h1>

				<!-- RATING -->

				<div class="rating-box">

					<div class="stars">
						★★★★★
					</div>

					<div class="review-count">

						<%=rs.getDouble("rating")%>

						(
						<%=rs.getInt("total_reviews")%>
						Reviews )

					</div>

				</div>

				<!-- PRICE -->

				<div class="price-section">

					<span class="new-price">
						₹<%=rs.getInt("price")%>
					</span>

					<span class="old-price">
						₹<%=rs.getInt("old_price")%>
					</span>

					<span class="discount">
						20% OFF
					</span>

				</div>

				<!-- STOCK -->

				<div class="stock-box">

					<%
					if(stock > 0){
					%>

					<div class="in-stock">

						<i class="bi bi-check-circle-fill"></i>

						In Stock
						(
						<%=stock%>
						left )

					</div>

					<%
					}else{
					%>

					<div class="out-stock">

						<i class="bi bi-x-circle-fill"></i>

						Out Of Stock

					</div>

					<%
					}
					%>

				</div>

				<!-- BUTTONS -->

				<div class="button-group">

					<button class="buy-btn">

						<i class="bi bi-lightning-charge-fill"></i>
						Buy Now

					</button>

					<form
					action="AddToCart"
					method="post"
					style="flex:1;">

						<input
						type="hidden"
						name="laptopId"
						value="<%=rs.getInt("id")%>">

						<button class="cart-btn w-100">

							<i class="bi bi-cart-plus"></i>
							Add To Cart

						</button>

					</form>

				</div>

				<!-- SPECIFICATIONS -->

				<div class="spec-box">

					<div class="spec-title">
						Specifications
					</div>

					<div class="spec-item">

						<div class="spec-name">
							Processor
						</div>

						<div class="spec-value">
							<%=rs.getString("processor")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							RAM
						</div>

						<div class="spec-value">
							<%=rs.getString("ram")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Storage
						</div>

						<div class="spec-value">
							<%=rs.getString("storage")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Graphics
						</div>

						<div class="spec-value">
							<%=rs.getString("graphics")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Display
						</div>

						<div class="spec-value">
							<%=rs.getString("display_size")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Battery
						</div>

						<div class="spec-value">
							<%=rs.getString("battery")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Operating System
						</div>

						<div class="spec-value">
							<%=rs.getString("operating_system")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Color
						</div>

						<div class="spec-value">
							<%=rs.getString("color")%>
						</div>

					</div>

					<div class="spec-item">

						<div class="spec-name">
							Weight
						</div>

						<div class="spec-value">
							<%=rs.getString("weight")%>
						</div>

					</div>

				</div>

				<!-- DESCRIPTION -->

				<div class="description-box">

					<div class="description-title">
						Product Description
					</div>

					<div class="description">

						<%=rs.getString("description")%>

					</div>

				</div>

			</div>

		</div>

	</div>

</div>

</body>

</html>

<%
}
%>