<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<%@ page import="in.sp.model.User"%>

<%
User user = (User)session.getAttribute("userData");

if(user == null){
	response.sendRedirect("login.html");
}
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cart</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<!-- CSS -->

<link rel="stylesheet" href="css/cart.css">

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark">

	<div class="container-fluid">

		<a class="navbar-brand" href="home.jsp">
			TechLaptop
		</a>

		<button
		class="navbar-toggler"
		data-bs-toggle="collapse"
		data-bs-target="#menu">

			<span class="navbar-toggler-icon"></span>

		</button>

		<div class="collapse navbar-collapse" id="menu">

			<ul class="navbar-nav ms-auto">

				<li class="nav-item">
					<a class="nav-link" href="home.jsp">
						Home
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="laptops.jsp">
						Laptops
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link active" href="about.jsp">
						About
					</a>
				</li>

				<li class="nav-item">
					<a class="nav-link" href="orders.jsp">
						Orders
					</a>
				</li>

			</ul>

			<ul class="navbar-nav ms-4 align-items-center">
			<li class="nav-item me-3">

					<a href="cart.jsp" class="custom-btn">

						<i class="bi bi-cart3"></i>
						Cart

					</a>

				</li>

				<li class="nav-item dropdown">

					<a
					class="nav-link dropdown-toggle user-btn"
					data-bs-toggle="dropdown">

						<i class="bi bi-person-circle"></i>
						<%=user.getName()%>

					</a>

					<ul class="dropdown-menu dropdown-menu-end">

						<li>
							<a class="dropdown-item" href="profiles.jsp">
								Profile
							</a>
						</li>

						<li>
							<a class="dropdown-item text-danger" href="Logout">
								Logout
							</a>
						</li>

					</ul>

				</li>

			</ul>

		</div>

	</div>

</nav>

<!-- HERO -->

<section class="cart-hero">

	<div class="container text-center">

		<h1>
			Shopping <span>Cart</span>
		</h1>

		<p>

			Review your selected premium laptops before checkout.

		</p>

	</div>

</section>

<!-- CART -->

<section class="container pb-5">

	<div class="row g-4">

		<!-- LEFT -->

		<div class="col-12 col-lg-8">

			<!-- ITEM 1 -->

			<div class="cart-card">

				<div class="row align-items-center">

					<div class="col-12 col-md-3 text-center">

						<img
						src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?q=80&w=1200&auto=format&fit=crop"
						class="cart-img">

					</div>

					<div class="col-12 col-md-5">

						<h3>
							Dell XPS 15
						</h3>

						<p>
							Intel i7 • RTX 4060 • 16GB RAM • 1TB SSD
						</p>

						<span class="stock">
							In Stock
						</span>

					</div>

					<div class="col-12 col-md-2 text-center">

						<div class="quantity-box">

							<button>-</button>

							<input type="text" value="1">

							<button>+</button>

						</div>

					</div>

					<div class="col-12 col-md-2 text-center">

						<h2 class="price">
							₹1,25,999
						</h2>

						<button class="remove-btn">

							<i class="bi bi-trash"></i>

						</button>

					</div>

				</div>

			</div>

			<!-- ITEM 2 -->

			<div class="cart-card">

				<div class="row align-items-center">

					<div class="col-12 col-md-3 text-center">

						<img
