<%@ page language="java"
contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Verify OTP - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- BOOTSTRAP ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{

	margin:0;

	padding:0;

	box-sizing:border-box;

	font-family:'Poppins',sans-serif;

}

/* =========================
   BODY
========================= */

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.75),
	rgba(0,0,0,0.75)
	),

	url("img/myimg6.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:20px;

}

/* =========================
   OTP BOX
========================= */

.otp-container{

	width:100%;

	max-width:500px;

	background:
	rgba(255,255,255,0.10);

	backdrop-filter:blur(18px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:32px;

	padding:55px 45px;

	box-shadow:
	0 20px 60px rgba(0,0,0,0.45);

	color:white;

	position:relative;

	overflow:hidden;

}

/* =========================
   TOP ICON
========================= */

.icon-box{

	width:90px;

	height:90px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	border-radius:50%;

	display:flex;

	align-items:center;

	justify-content:center;

	margin:0 auto 25px;

	box-shadow:
	0 10px 30px rgba(217,70,239,0.4);

}

.icon-box i{

	font-size:42px;

	color:white;

}

/* =========================
   TITLE
========================= */

.otp-container h1{

	font-size:42px;

	font-weight:800;

	text-align:center;

	margin-bottom:12px;

	line-height:1.2;

}

/* =========================
   SUBTITLE
========================= */

.subtitle{

	text-align:center;

	color:#d1d5db;

	font-size:16px;

	line-height:1.7;

	margin-bottom:35px;

}

/* =========================
   INPUT BOX
========================= */

.input-box{

	position:relative;

	margin-bottom:30px;

}

.input-box i{

	position:absolute;

	left:20px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:20px;

}

/* =========================
   INPUT
========================= */

.form-control{

	height:65px;

	border:none;

	border-radius:18px;

	background:
	rgba(255,255,255,0.14);

	padding-left:60px;

	font-size:18px;

	color:white;

	letter-spacing:3px;

	font-weight:600;

	text-align:center;

}

.form-control::placeholder{

	color:#d1d5db;

	letter-spacing:1px;

}

.form-control:focus{

	box-shadow:none;

	border:2px solid #d946ef;

	background:
	rgba(255,255,255,0.18);

	color:white;

}

/* =========================
   BUTTON
========================= */

.verify-btn{

	width:100%;

	height:65px;

	border:none;

	border-radius:20px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:20px;

	font-weight:700;

	transition:0.35s;

	box-shadow:
	0 12px 35px rgba(217,70,239,0.35);

}

.verify-btn:hover{

	transform:translateY(-4px);

	box-shadow:
	0 18px 40px rgba(217,70,239,0.5);

}

/* =========================
   RESEND
========================= */

.resend{

	text-align:center;

	margin-top:25px;

	font-size:15px;

	color:#d1d5db;

}

.resend a{

	color:white;

	font-weight:600;

	text-decoration:none;

	margin-left:5px;

}

.resend a:hover{

	color:#d946ef;

}

/* =========================
   MOBILE
========================= */

@media(max-width:576px){

	.otp-container{

		padding:40px 25px;

	}

	.otp-container h1{

		font-size:34px;

	}

	.subtitle{

		font-size:14px;

	}

	.form-control{

		height:58px;

		font-size:16px;

	}

	.verify-btn{

		height:58px;

		font-size:18px;

	}

}

</style>

</head>

<body>

<!-- OTP CONTAINER -->

<div class="otp-container">

	<!-- ICON -->

	<div class="icon-box">

		<i class="bi bi-shield-lock-fill"></i>

	</div>

	<!-- TITLE -->

	<h1>

		Verify OTP

	</h1>

	<!-- SUBTITLE -->

	<p class="subtitle">

		We have sent a verification code
		to your registered email address.
		Enter the OTP below to continue.

	</p>

	<!-- FORM -->

	<form
	action="VerifyOtp"
	method="post">

		<!-- OTP INPUT -->

		<div class="input-box">

			<i class="bi bi-key-fill"></i>

			<input
			type="text"
			name="otp"
			class="form-control"
			placeholder="Enter 6 Digit OTP"
			required>

		</div>

		<!-- BUTTON -->

		<button
		type="submit"
		class="verify-btn">

			<i class="bi bi-check-circle-fill"></i>

			Verify OTP

		</button>

	</form>

	<!-- RESEND -->

	<div class="resend">

		Didn't receive OTP?

		<a href="register.html">

			Resend OTP

		</a>

	</div>

</div>

</body>

</html>