<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Admin Panel - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	background:#edf1f5;

}

/* ======================
   SIDEBAR
====================== */

.sidebar{

	width:310px;

	height:100vh;

	position:fixed;

	top:0;
	left:0;

	background:linear-gradient(180deg,#081120,#111f3d);

	padding:30px 20px;

	overflow-y:auto;

}

.logo{

	color:white;

	font-size:52px;

	font-weight:800;

	margin-bottom:60px;

}

.menu{

	list-style:none;

	padding:0;

}

.menu li{

	margin-bottom:18px;

}

.menu li a{

	display:flex;

	align-items:center;

	gap:15px;

	padding:18px 22px;

	border-radius:18px;

	color:#d1d5db;

	text-decoration:none;

	font-size:25px;

	font-weight:600;

	transition:0.3s;

}

.menu li a:hover,
.menu li a.active{

	background:linear-gradient(90deg,#c026ff,#8b5cf6);

	color:white;

	transform:translateX(4px);

}

.menu li a i{

	font-size:24px;

}

/* ======================
   MAIN
====================== */

.main{

	margin-left:330px;

	padding:30px;

}

/* TOP */

.top-box{

	background:white;

	padding:28px 40px;

	border-radius:30px;

	margin-bottom:35px;

	box-shadow:0 10px 25px rgba(0,0,0,0.04);

}

.top-box h1{

	font-size:52px;

	font-weight:800;

	color:#081120;

}

/* FORM */

.form-box{

	background:white;

	border-radius:35px;

	padding:50px;

	box-shadow:0 12px 30px rgba(0,0,0,0.04);

}

.form-box h2{

	font-size:45px;

	font-weight:800;

	color:#081120;

	margin-bottom:40px;

}

/* INPUTS */

.form-label{

	font-size:22px;

	font-weight:700;

	margin-bottom:12px;

	color:#1f2937;

}

.form-control,
.form-select{

	height:75px;

	border:none;

	background:#f3f4f6;

	border-radius:20px;

	font-size:22px;

	padding-left:25px;

}

.form-control:focus,
.form-select:focus{

	box-shadow:none;

	border:2px solid #8b5cf6;

	background:white;

}

/* TEXTAREA */

textarea.form-control{

	height:160px;

	padding-top:20px;

	resize:none;

}

/* BUTTON */

.submit-btn{

	background:linear-gradient(90deg,#c026ff,#8b5cf6);

	border:none;

	color:white;

	width:100%;

	height:75px;

	border-radius:20px;

	font-size:24px;

	font-weight:700;

	margin-top:15px;

	transition:0.3s;

}

.submit-btn:hover{

	transform:translateY(-4px);

	box-shadow:0 12px 25px rgba(139,92,246,0.3);

}

/* ======================
   MOBILE
====================== */

@media(max-width:1200px){

	.sidebar{

		width:100%;

		height:auto;

		position:relative;

	}

	.main{

		margin-left:0;

	}

	.logo{

		font-size:38px;

		margin-bottom:25px;

	}

	.menu li a{

		font-size:18px;

		padding:14px 18px;

	}

	.top-box h1{

		font-size:36px;

	}

	.form-box h2{

		font-size:32px;

	}

	.form-label{

		font-size:18px;

	}

	.form-control,
	.form-select{

		height:60px;

		font-size:18px;

	}

	.submit-btn{

		height:60px;

		font-size:20px;

	}

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="menu">

		<li>

			<a href="admin_dashboard.jsp">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_add_laptop.jsp"
			   class="active">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="admin_categories.jsp">

				<i class="bi bi-grid-3x3-gap-fill"></i>

				Categories

			</a>

		</li>

		<li>

			<a href="admin_payments.jsp">

				<i class="bi bi-credit-card-fill"></i>

				Payments

			</a>

		</li>

		<li>

			<a href="admin_reviews.jsp">

				<i class="bi bi-star-fill"></i>

				Reviews

			</a>

		</li>

		<li>

			<a href="admin_settings.jsp">

				<i class="bi bi-gear-fill"></i>

				Settings

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOP -->

	<div class="top-box">

		<h1>

			Add New Laptop

		</h1>

	</div>

	<!-- FORM -->

	<div class="form-box">

		<h2>

			Laptop Information

		</h2>

		<form>

			<div class="row g-4">

				<!-- BRAND -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Brand

					</label>

					<select class="form-select">

						<option>Select Brand</option>

						<option>HP</option>

						<option>Dell</option>

						<option>Lenovo</option>

						<option>ASUS</option>

						<option>Acer</option>

					</select>

				</div>

				<!-- NAME -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Laptop Name

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="Enter Laptop Name">

				</div>

				<!-- PRICE -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Price

					</label>

					<input
					type="number"
					class="form-control"
					placeholder="Enter Price">

				</div>

				<!-- OLD PRICE -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Old Price

					</label>

					<input
					type="number"
					class="form-control"
					placeholder="Enter Old Price">

				</div>

				<!-- PROCESSOR -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Processor

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="Intel i7 / Ryzen 7">

				</div>

				<!-- RAM -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						RAM

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="16GB DDR5">

				</div>

				<!-- STORAGE -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Storage

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="512GB SSD">

				</div>

				<!-- GRAPHICS -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Graphics

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="RTX 4060">

				</div>

				<!-- DISPLAY -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Display

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="15.6 FHD 144Hz">

				</div>

				<!-- BATTERY -->

				<div class="col-12 col-lg-6">

					<label class="form-label">

						Battery

					</label>

					<input
					type="text"
					class="form-control"
					placeholder="6 Hours">

				</div>

				<!-- DESCRIPTION -->

				<div class="col-12">

					<label class="form-label">

						Description

					</label>

					<textarea
					class="form-control"
					placeholder="Enter laptop description"></textarea>

				</div>

				<!-- IMAGE -->

				<div class="col-12">

					<label class="form-label">

						Upload Laptop Image

					</label>

					<input
					type="file"
					class="form-control">

				</div>

				<!-- BUTTON -->

				<div class="col-12">

					<button
					type="submit"
					class="submit-btn">

						Add Laptop

					</button>

				</div>

			</div>

		</form>

	</div>

</div>

</body>

</html>