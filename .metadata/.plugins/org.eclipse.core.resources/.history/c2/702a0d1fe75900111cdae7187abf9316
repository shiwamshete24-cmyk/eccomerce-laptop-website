<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%
int orderId = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

PreparedStatement ps = conn.prepareStatement(
"select * from orders where id=?");

ps.setInt(1, orderId);

ResultSet rs = ps.executeQuery();
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	User Address Details

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{

	background:#f5f7fb;

	font-family:Arial,sans-serif;

}

.address-box{

	max-width:700px;

	margin:60px auto;

	background:white;

	padding:35px;

	border-radius:15px;

	box-shadow:0 4px 20px rgba(0,0,0,0.08);

}

.address-box h2{

	text-align:center;

	margin-bottom:30px;

	font-weight:bold;

}

.detail{

	margin-bottom:18px;

	font-size:17px;

}

.detail span{

	font-weight:bold;

	color:#0d6efd;

}

.back-btn{

	margin-top:25px;

}

</style>

</head>

<body>

<div class="container">

	<div class="address-box">

		<h2>

			User Address Details

		</h2>

		<%
		if(rs.next()){
		%>

		<div class="detail">

			<span>Full Name :</span>

			<%=rs.getString("full_name")%>

		</div>

		<div class="detail">

			<span>Email :</span>

			<%=rs.getString("user_email")%>

		</div>

		<div class="detail">

			<span>Phone :</span>

			<%=rs.getString("phone")%>

		</div>

		<div class="detail">

			<span>Address :</span>

			<%=rs.getString("address")%>

		</div>

		<div class="detail">

			<span>City :</span>

			<%=rs.getString("city")%>

		</div>

		<div class="detail">

			<span>State :</span>

			<%=rs.getString("state")%>

		</div>

		<div class="detail">

			<span>Pincode :</span>

			<%=rs.getString("pincode")%>

		</div>

		<div class="detail">

			<span>Payment Method :</span>

			<%=rs.getString("payment_method")%>

		</div>

		<div class="detail">

			<span>Total Amount :</span>

			₹<%=rs.getDouble("total_amount")%>

		</div>

		<div class="detail">

			<span>Order Status :</span>

			<%=rs.getString("order_status")%>

		</div>

		<div class="detail">

			<span>Order Date :</span>

			<%=rs.getString("order_date")%>

		</div>

		<%
		}
		%>

		<a href="admin_orders.jsp"
		   class="btn btn-primary back-btn">

			Back

		</a>

	</div>

</div>

</body>

</html>