*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#050816;
    overflow-x:hidden;
    color:white;
}

/* NAVBAR */

.navbar{
    background:rgba(0,0,0,0.45);
    backdrop-filter:blur(15px);
    padding:15px 0;
    border-bottom:1px solid rgba(255,255,255,0.08);
    position:fixed;
    width:100%;
    top:0;
    left:0;
    z-index:999;
}

.navbar-brand{
    font-size:32px;
    font-weight:800;
    color:#00d9ff !important;
}

.nav-link{
    color:white !important;
    margin-left:25px;
    font-weight:500;
    position:relative;
    transition:0.3s;
}

.nav-link::after{
    content:'';
    position:absolute;
    left:0;
    bottom:-5px;
    width:0%;
    height:2px;
    background:#00d9ff;
    transition:0.4s;
}

.nav-link:hover::after{
    width:100%;
}

.nav-link:hover{
    color:#00d9ff !important;
}

/* BUTTON */

.shop-btn{
    background:linear-gradient(to right,#00d9ff,#0059ff);
    color:white;
    padding:13px 28px;
    border-radius:40px;
    text-decoration:none;
    font-weight:600;
    display:inline-block;
    transition:0.4s;
}

.shop-btn:hover{
    transform:translateY(-5px);
    box-shadow:0 12px 25px rgba(0,217,255,0.4);
    color:white;
}

.outline-btn{
    border:2px solid rgba(255,255,255,0.2);
    padding:13px 28px;
    border-radius:40px;
    text-decoration:none;
    color:white;
    transition:0.4s;
}

.outline-btn:hover{
    background:white;
    color:black;
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:140px 0 80px;
    position:relative;
    overflow:hidden;
}

/* GLOW EFFECT */

.hero::before{
    content:'';
    position:absolute;
    width:600px;
    height:600px;
    background:#00d9ff;
    filter:blur(220px);
    opacity:0.12;
    top:-200px;
    right:-150px;
}

.hero::after{
    content:'';
    position:absolute;
    width:500px;
    height:500px;
    background:#0059ff;
    filter:blur(220px);
    opacity:0.12;
    bottom:-150px;
    left:-150px;
}

.hero-text{
    position:relative;
    z-index:2;
}

.hero-text h1{
    font-size:85px;
    font-weight:800;
    line-height:1.1;
    margin-bottom:25px;
    animation:slideUp 1s ease;
}

.hero-text h1 span{
    color:#00d9ff;
}

.hero-text p{
    font-size:20px;
    color:#c9c9c9;
    line-height:1.8;
    margin-bottom:35px;
    max-width:600px;
    animation:slideUp 1.2s ease;
}

.hero-buttons{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
}

/* STATS */

.hero-stats{
    display:flex;
    gap:40px;
    margin-top:45px;
    flex-wrap:wrap;
}

.hero-stats h2{
    font-size:38px;
    color:#00d9ff;
    font-weight:800;
}

.hero-stats p{
    font-size:15px;
    margin-top:5px;
    color:#bdbdbd;
}

/* HERO IMAGE */

.hero-image{
    text-align:center;
    position:relative;
    z-index:2;
}

.hero-image img{
    width:100%;
    max-width:720px;
    animation:float 4s ease-in-out infinite;
    filter:drop-shadow(0 25px 40px rgba(0,0,0,0.6));
}

/* ANIMATION */

@keyframes float{

    0%{
        transform:translateY(0px);
    }

    50%{
        transform:translateY(-18px);
    }

    100%{
        transform:translateY(0px);
    }

}

@keyframes slideUp{

    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0px);
    }

}

/* MOBILE */

@media(max-width:767px){

    .navbar{
        padding:12px 0;
    }

    .navbar-brand{
        font-size:26px;
    }

    .hero{
        padding:120px 15px 70px;
        text-align:center;
        min-height:auto;
    }

    .hero-text h1{
        font-size:42px;
        line-height:1.3;
    }

    .hero-text p{
        font-size:15px;
        line-height:1.8;
        margin:auto;
        margin-bottom:30px;
    }

    .hero-buttons{
        justify-content:center;
    }

    .shop-btn,
    .outline-btn{
        width:100%;
    }

    .hero-image{
        margin-top:50px;
    }

    .hero-image img{
        max-width:100%;
    }

    .hero-stats{
        justify-content:center;
        gap:25px;
    }

    .hero-stats h2{
        font-size:28px;
    }

}

/* TABLET */

@media(min-width:768px) and (max-width:991px){

    .hero{
        text-align:center;
    }

    .hero-text h1{
        font-size:60px;
    }

    .hero-text p{
        margin:auto;
        margin-bottom:35px;
    }

    .hero-buttons{
        justify-content:center;
    }

    .hero-image{
        margin-top:60px;
    }

    .hero-stats{
        justify-content:center;
    }

}

/* LARGE SCREEN */

@media(min-width:1400px){

    .hero-text h1{
        font-size:100px;
    }

    .hero-image img{
        max-width:800px;
    }

}