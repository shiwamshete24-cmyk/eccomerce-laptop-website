<%@ page language="java"
contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>

	Verify OTP

</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<style>

body{

	height:100vh;

	display:flex;

	justify-content:center;

	align-items:center;

	background:#111827;

	font-family:Poppins;

}

.otp-box{

	width:400px;

	background:#1f2937;

	padding:40px;

	border-radius:20px;

	color:white;

}

input{

	height:55px !important;

	margin-bottom:20px;

}

button{

	height:55px;

}

</style>

</head>

<body>

<div class="otp-box">

	<h2 class="text-center mb-4">

		Verify OTP

	</h2>

	<form
	action="VerifyOtp"
	method="post">

		<input
		type="text"
		name="otp"
		class="form-control"
		placeholder="Enter OTP"
		required>

		<button
		class="btn btn-primary w-100">

			Verify OTP

		</button>

	</form>

</div>

</body>

</html>