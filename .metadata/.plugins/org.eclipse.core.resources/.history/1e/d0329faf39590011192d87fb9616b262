
<!DOCTYPE html>
<html>
<head>
<title>Register - TechLaptop</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link rel="stylesheet" href="auths.css">

</head>
<body>

	<!-- NAVBAR -->

	<nav class="navbar navbar-expand-lg navbar-dark px-5">
		<a class="navbar-brand fw-bold" href="index.html">TechLaptop</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse"
			data-bs-target="#menu">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="menu">
			<ul class="navbar-nav ms-auto">
				<li class="nav-item"><a class="nav-link" href="index.html">Home</a>
				</li>

				<li class="nav-item"><a class="nav-link" href="login.html">Login</a>
				</li>

				<li class="nav-item"><a
					class="nav-link btn btn-primary text-white px-3 ms-2 active"
					href="register.html">Register</a></li>
			</ul>
		</div>
	</nav>

	<!-- REGISTER FORM -->

	<div class="auth-container">
		<div class="auth-box">
			<h2>Create Account</h2>

			<form method="post" action="register"
				onsubmit="return validatePassword()">
				<input type="text" placeholder="Full Name" name="username">

				<input type="email" placeholder="Email" name="email"> <input
					type="password" placeholder="Password" name="password"
					id="password"> <input type="password"
					placeholder="Confirm Password" name="confirm-password"
					id="confirm-password">

				<button type="submit">Register</button>

				<p class="link">
					Already have account? <a href="login.html">Login</a>
				</p>
			</form>
		</div>
	</div>
	<script src="script.js"></script>
	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>

