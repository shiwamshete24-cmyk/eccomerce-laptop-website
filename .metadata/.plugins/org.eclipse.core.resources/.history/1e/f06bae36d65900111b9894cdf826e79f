/* =========================
   GOOGLE FONT
========================= */

@import
url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

/* =========================
   GLOBAL
========================= */

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.72),
	rgba(0,0,0,0.72)
	),

	url("img/myimg6.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

}

/* =========================
   NAVBAR
========================= */

.navbar{

	padding:18px 70px;

	background:
	rgba(0,0,0,0.35);

	backdrop-filter:blur(14px);

	border-bottom:
	1px solid rgba(255,255,255,0.08);

	box-shadow:
	0 4px 20px rgba(0,0,0,0.25);

}

.navbar-brand{

	font-size:34px;

	font-weight:800;

	color:white !important;

	letter-spacing:1px;

}

.navbar-nav .nav-link{

	color:#e5e7eb !important;

	font-size:15px;

	font-weight:500;

	margin-left:20px;

	padding:10px 18px !important;

	border-radius:12px;

	transition:0.3s;

}

.navbar-nav .nav-link:hover{

	background:
	rgba(255,255,255,0.08);

	color:#d946ef !important;

}

.navbar-nav .active{

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white !important;

	box-shadow:
	0 8px 18px rgba(217,70,239,0.35);

}

/* =========================
   AUTH CONTAINER
========================= */

.auth-container{

	min-height:88vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:40px 20px;

}

/* =========================
   AUTH BOX
========================= */

.auth-box{

	width:100%;

	max-width:450px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(18px);

	border:
	1px solid rgba(255,255,255,0.14);

	border-radius:28px;

	padding:45px;

	box-shadow:
	0 12px 40px rgba(0,0,0,0.4);

	color:white;

	animation:fadeIn 0.8s ease;

	position:relative;

	overflow:hidden;

}

/* =========================
   TOP GLOW EFFECT
========================= */

.auth-box::before{

	content:"";

	position:absolute;

	width:180px;

	height:180px;

	background:
	radial-gradient(
	circle,
	rgba(217,70,239,0.28),
	transparent
	);

	top:-60px;

	right:-60px;

}

/* =========================
   ANIMATION
========================= */

@keyframes fadeIn{

	from{

		opacity:0;

		transform:translateY(30px);

	}

	to{

		opacity:1;

		transform:translateY(0);

	}

}

/* =========================
   TITLE
========================= */

.auth-box h2{

	font-size:42px;

	font-weight:800;

	text-align:center;

	margin-bottom:10px;

}

.auth-subtitle{

	text-align:center;

	color:#d1d5db;

	font-size:15px;

	margin-bottom:35px;

	line-height:1.7;

}

/* =========================
   LABELS
========================= */

.auth-box label{

	display:block;

	margin-bottom:10px;

	font-size:14px;

	font-weight:600;

	color:#f3f4f6;

}

/* =========================
   INPUT BOX
========================= */

.input-box{

	position:relative;

	margin-bottom:22px;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:17px;

}

/* =========================
   INPUTS
========================= */

.auth-box input{

	width:100%;

	height:58px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:16px;

	padding-left:55px;

	padding-right:15px;

	color:white;

	font-size:15px;

	transition:0.3s;

}

.auth-box input::placeholder{

	color:#d1d5db;

}

.auth-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #d946ef;

	box-shadow:
	0 0 14px rgba(217,70,239,0.25);

}

/* =========================
   OPTIONS
========================= */

.options{

	display:flex;

	justify-content:flex-end;

	margin-bottom:22px;

}

.options a{

	color:#f3f4f6;

	font-size:14px;

	text-decoration:none;

	transition:0.3s;

}

.options a:hover{

	color:#d946ef;

}

/* =========================
   BUTTON
========================= */

.auth-box button{

	width:100%;

	height:58px;

	border:none;

	border-radius:16px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	cursor:pointer;

	transition:0.4s;

	box-shadow:
	0 10px 24px rgba(217,70,239,0.3);

}

.auth-box button:hover{

	transform:translateY(-4px);

	box-shadow:
	0 16px 35px rgba(217,70,239,0.45);

}

/* =========================
   LINKS
========================= */

.link{

	text-align:center;

	margin-top:28px;

	font-size:15px;

	color:#e5e7eb;

}

.link a{

	color:white;

	font-weight:700;

	text-decoration:none;

	transition:0.3s;

}

.link a:hover{

	color:#d946ef;

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.navbar{

		padding:15px 22px;

	}

	.auth-box{

		padding:35px 25px;

		border-radius:22px;

	}

	.auth-box h2{

		font-size:34px;

	}

	.navbar-brand{

		font-size:28px;

	}

}