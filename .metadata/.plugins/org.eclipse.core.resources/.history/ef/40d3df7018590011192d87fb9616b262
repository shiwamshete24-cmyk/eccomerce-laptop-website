
/* =========================
   GLOBAL
========================= */

*{
	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;
}

body{
	background:#050816;
	color:#111827;
}

/* =========================
   NAVBAR
========================= */

.navbar{
	background:white;
	padding:18px 35px;
	box-shadow:0 2px 20px rgba(0,0,0,0.05);
	position:sticky;
	top:0;
	z-index:999;
}

.logo{
	font-size:32px;
	font-weight:800;
	color:#0077ff;
	text-decoration:none;
	display:flex;
	align-items:center;
	gap:10px;
}

.logo:hover{
	color:#005fe0;
}

.nav-link-custom{
	color:#374151;
	text-decoration:none;
	font-weight:600;
	margin-left:28px;
	transition:0.3s;
	display:flex;
	align-items:center;
	gap:8px;
	font-size:15px;
}

.nav-link-custom:hover{
	color:#0077ff;
	transform:translateY(-2px);
}

.navbar-toggler{
	border:none;
}

.navbar-toggler:focus{
	box-shadow:none;
}

/* =========================
   MAIN
========================= */

.main-section{
	padding:40px 0;
}

/* =========================
   PRODUCT WRAPPER
========================= */

.product-wrapper{
	background:white;
	border-radius:28px;
	padding:35px;
	box-shadow:
	0 10px 35px rgba(0,0,0,0.05);
}

/* =========================
   LEFT SIDE
========================= */

.left-side{
	position:sticky;
	top:100px;
}

/* =========================
   MAIN IMAGE BOX
========================= */

.main-image-box{

	background:#ffffff;

	border:1px solid #e5e7eb;

	border-radius:25px;

	height:520px;

	display:flex;

	align-items:center;

	justify-content:center;

	overflow:hidden;

	cursor:zoom-in;

	padding:10px;

	box-shadow:
	0 8px 20px rgba(0,0,0,0.04);

}

/* =========================
   MAIN IMAGE
========================= */

.main-image{

	width:100%;

	height:100%;

	object-fit:contain;

	padding:20px;

	max-width:100%;

	max-height:100%;

	image-rendering:auto;

	transition:transform 0.35s ease;

	filter:contrast(102%);

}

/* =========================
   ZOOM EFFECT
========================= */

.main-image-box:hover .main-image{

	transform:scale(1.12);

}

/* =========================
   THUMBNAILS
========================= */

.thumbnail-row{
	display:flex;
	gap:15px;
	margin-top:22px;
	justify-content:center;
	flex-wrap:wrap;
}

.thumb{

	width:90px;

	height:90px;

	object-fit:contain;

	background:white;

	border:2px solid #e5e7eb;

	border-radius:16px;

	padding:6px;

	cursor:pointer;

	transition:0.3s;

	box-shadow:
	0 4px 10px rgba(0,0,0,0.05);

}

.thumb:hover{
	border-color:#0077ff;
	transform:translateY(-5px);
	box-shadow:
	0 10px 20px rgba(0,119,255,0.12);
}

/* =========================
   RIGHT SIDE
========================= */

.brand{
	color:#0077ff;
	font-weight:700;
	font-size:15px;
	margin-bottom:12px;
	text-transform:uppercase;
	letter-spacing:1px;
	background-color: pink;
	display: inline-block;
	padding:10px;
	border-radius:10px;
	
}

.title{
	font-size:40px;
	font-weight:800;
	line-height:1.4;
	margin-bottom:18px;
	color:#111827;
}

/* =========================
   RATING
========================= */

.rating-row{
	display:flex;
	align-items:center;
	gap:12px;
	margin-bottom:22px;
	flex-wrap:wrap;
}

.stars{
	background:#00b67a;
	color:white;
	padding:6px 12px;
	border-radius:8px;
	font-size:14px;
	font-weight:700;
}

.review-text{
	color:#666;
	font-size:15px;
}

/* =========================
   PRICE
========================= */

.price-section{
	margin-bottom:28px;
}

.new-price{
	font-size:46px;
	font-weight:800;
	color:#111827;
}

.old-price{
	font-size:24px;
	color:#9ca3af;
	text-decoration:line-through;
	margin-left:14px;
}

.discount{
	color:#00b67a;
	font-weight:700;
	font-size:18px;
	margin-left:14px;
}

/* =========================
   STOCK
========================= */

.stock{
	font-size:17px;
	font-weight:700;
	margin-bottom:25px;
}

.in-stock{
	color:#00b67a;
}

.out-stock{
	color:red;
}

/* =========================
   FEATURES
========================= */

.feature-row{
	display:flex;
	gap:15px;
	margin-bottom:30px;
	flex-wrap:wrap;
}

.feature{
	background:#f3f6fb;
	padding:18px;
	border-radius:18px;
	text-align:center;
	flex:1;
	min-width:120px;
	transition:0.3s;
}

.feature:hover{
	transform:translateY(-4px);
	box-shadow:
	0 10px 20px rgba(0,0,0,0.05);
}

.feature i{
	font-size:28px;
	color:#0077ff;
	margin-bottom:10px;
}

.feature p{
	margin:0;
	font-size:14px;
	font-weight:600;
}

/* =========================
   BUTTONS
========================= */

.button-row{
	display:flex;
	gap:18px;
	margin-bottom:35px;
}

.buy-btn{
	flex:1;
	background:#ff9f00;
	border:none;
	color:white;
	padding:16px;
	border-radius:14px;
	font-size:17px;
	font-weight:700;
	transition:0.3s;
}

.buy-btn:hover{
	background:#f59e0b;
	transform:translateY(-3px);
	box-shadow:
	0 10px 20px rgba(245,158,11,0.2);
}

.cart-btn{
	flex:1;
	background:#0077ff;
	border:none;
	color:white;
	padding:16px;
	border-radius:14px;
	font-size:17px;
	font-weight:700;
	transition:0.3s;
}

.cart-btn:hover{
	background:#005fe0;
	transform:translateY(-3px);
	box-shadow:
	0 10px 20px rgba(0,119,255,0.2);
}

/* =========================
   SPECIFICATIONS
========================= */

.spec-box{
	background:#f9fafb;
	border-radius:22px;
	padding:28px;
	margin-top:20px;
	border:1px solid #eee;
}

.spec-title{
	font-size:24px;
	font-weight:700;
	margin-bottom:22px;
	color:#111827;
}

.spec-row{
	display:flex;
	justify-content:space-between;
	padding:14px 0;
	border-bottom:1px solid #e5e7eb;
}

.spec-row:last-child{
	border-bottom:none;
}

.spec-name{
	color:#6b7280;
	font-weight:500;
}

.spec-value{
	font-weight:600;
	text-align:right;
	color:#111827;
}

/* =========================
   DESCRIPTION
========================= */

.desc-box{
	background:#f9fafb;
	border-radius:22px;
	padding:28px;
	margin-top:25px;
	border:1px solid #eee;
}

.desc-title{
	font-size:24px;
	font-weight:700;
	margin-bottom:18px;
	color:#111827;
}

.desc{
	color:#4b5563;
	line-height:2;
	font-size:15px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:991px){

	.left-side{
		position:relative;
		top:0;
	}

	.title{
		font-size:30px;
		margin-top:25px;
	}

	.main-image-box{
		height:350px;
	}

}

@media(max-width:576px){

	.product-wrapper{
		padding:20px;
	}

	.button-row{
		flex-direction:column;
	}

	.title{
		font-size:24px;
	}

	.new-price{
		font-size:34px;
	}

	.thumb{
		width:70px;
		height:70px;
	}

}
