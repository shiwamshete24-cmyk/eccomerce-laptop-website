<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Verify OTP - TechLaptop

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	min-height:100vh;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:20px;

	background:
	linear-gradient(
	rgba(0,0,0,0.68),
	rgba(0,0,0,0.68)
	),
	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	overflow:hidden;

}

/* =========================
   OTP BOX
========================= */

.otp-box{

	width:100%;

	max-width:470px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(16px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:32px;

	padding:50px 40px;

	box-shadow:
	0 15px 45px rgba(0,0,0,0.35);

	color:white;

	animation:fadeIn 0.8s ease;

	position:relative;

	overflow:hidden;

}

/* GLOW EFFECT */

.otp-box::before{

	content:"";

	position:absolute;

	width:220px;

	height:220px;

	background:
	radial-gradient(
	circle,
	rgba(217,70,239,0.4),
	transparent 70%
	);

	top:-80px;

	right:-60px;

	z-index:0;

}

/* CONTENT */

.otp-content{

	position:relative;

	z-index:2;

}

/* =========================
   ICON
========================= */

.otp-icon{

	width:95px;

	height:95px;

	margin:auto;

	border-radius:50%;

	display:flex;

	align-items:center;

	justify-content:center;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	box-shadow:
	0 10px 30px rgba(217,70,239,0.4);

	margin-bottom:28px;

}

.otp-icon i{

	font-size:42px;

	color:white;

}

/* =========================
   TEXT
========================= */

.otp-box h2{

	font-size:42px;

	font-weight:800;

	text-align:center;

	margin-bottom:12px;

}

.otp-box p{

	text-align:center;

	color:#d1d5db;

	font-size:15px;

	line-height:1.8;

	margin-bottom:38px;

}

/* =========================
   INPUT
========================= */

.input-box{

	position:relative;

	margin-bottom:28px;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	font-size:20px;

	color:#d1d5db;

}

.input-box input{

	width:100%;

	height:62px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:18px;

	padding-left:58px;

	padding-right:15px;

	color:white;

	font-size:22px;

	font-weight:700;

	letter-spacing:8px;

	text-align:center;

	transition:0.3s;

}

.input-box input::placeholder{

	color:#d1d5db;

	letter-spacing:4px;

	font-weight:500;

}

.input-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #d946ef;

	box-shadow:
	0 0 15px rgba(217,70,239,0.25);

}

/* =========================
   BUTTON
========================= */

.verify-btn{

	width:100%;

	height:60px;

	border:none;

	border-radius:18px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	transition:0.4s;

	box-shadow:
	0 10px 25px rgba(192,38,211,0.3);

}

.verify-btn:hover{

	transform:translateY(-4px);

	box-shadow:
	0 15px 35px rgba(192,38,211,0.45);

}

/* =========================
   RESEND
========================= */

.resend-text{

	text-align:center;

	margin-top:28px;

	font-size:14px;

	color:#e5e7eb;

}

.resend-text a{

	color:white;

	font-weight:700;

	text-decoration:none;

	transition:0.3s;

}

.resend-text a:hover{

	color:#d946ef;

}

/* =========================
   ANIMATION
========================= */

@keyframes fadeIn{

	from{

		opacity:0;

		transform:translateY(35px);

	}

	to{

		opacity:1;

		transform:translateY(0);

	}

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.otp-box{

		padding:40px 25px;

	}

	.otp-box h2{

		font-size:34px;

	}

	.input-box input{

		font-size:18px;

		letter-spacing:5px;

	}

}

</style>

</head>

<body>

	<div class="otp-box">

		<div class="otp-content">

			<!-- ICON -->

			<div class="otp-icon">

				<i class="bi bi-shield-lock-fill"></i>

			</div>

			<!-- TITLE -->

			<h2>

				Verify OTP

			</h2>

			<p>

				Please enter the one-time password sent to your
				registered email address to continue securely.

			</p>

			<!-- FORM -->

			<form
			action="VerifyOtp"
			method="post">

				<div class="input-box">

					<i class="bi bi-key-fill"></i>

					<input
					type="text"
					name="otp"
					placeholder="------"
					required>

				</div>

				<button
				type="submit"
				class="verify-btn">

					Verify OTP

				</button>

			</form>

			<!-- RESEND -->

			<div class="resend-text">

				Didn't receive OTP?

				<a href="#">

					Resend OTP

				</a>

			</div>

		</div>

	</div>

</body>

</html>