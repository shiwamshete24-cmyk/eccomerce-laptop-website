<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>

<%@ page import="java.sql.*"%>
<%@ page import="in.sp.connection.DbConnection"%>

<%
int orderId = Integer.parseInt(request.getParameter("id"));

Connection conn = DbConnection.getConnection();

PreparedStatement ps = conn.prepareStatement(
"select * from orders where id=?");

ps.setInt(1, orderId);

ResultSet rs = ps.executeQuery();
%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Order User Details

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;
	padding:0;
	box-sizing:border-box;
	font-family:'Poppins',sans-serif;

}

body{

	background:#f1f5f9;

}

/* ======================
   SIDEBAR
====================== */

.sidebar{

	width:250px;

	height:100vh;

	position:fixed;

	top:0;
	left:0;

	background:linear-gradient(180deg,#0f172a,#1e293b);

	padding:25px 18px;

	overflow-y:auto;

}

.logo{

	color:white;

	font-size:32px;

	font-weight:800;

	margin-bottom:40px;

}

.menu{

	list-style:none;

	padding:0;

}

.menu li{

	margin-bottom:10px;

}

.menu li a{

	display:flex;

	align-items:center;

	gap:12px;

	padding:14px 18px;

	border-radius:14px;

	color:#cbd5e1;

	text-decoration:none;

	font-size:16px;

	font-weight:500;

	transition:0.3s;

}

.menu li a:hover,
.menu li a.active{

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

}

.menu li a i{

	font-size:18px;

}

/* ======================
   MAIN
====================== */

.main{

	margin-left:270px;

	padding:25px;

}

/* TOP */

.top-box{

	background:white;

	padding:22px 30px;

	border-radius:20px;

	margin-bottom:25px;

	box-shadow:0 4px 20px rgba(0,0,0,0.04);

}

.top-box h1{

	font-size:34px;

	font-weight:700;

	color:#0f172a;

	margin:0;

}

/* DETAILS */

.details-box{

	background:white;

	border-radius:25px;

	padding:35px;

	box-shadow:0 4px 20px rgba(0,0,0,0.04);

}

.info-card{

	background:#f8fafc;

	border-radius:18px;

	padding:22px;

	height:100%;

	transition:0.3s;

	border:1px solid #e2e8f0;

}

.info-card:hover{

	transform:translateY(-3px);

}

.info-card i{

	font-size:24px;

	color:#9333ea;

	margin-bottom:14px;

	display:inline-block;

}

.info-card h5{

	font-size:14px;

	font-weight:600;

	color:#64748b;

	margin-bottom:8px;

}

.info-card p{

	font-size:17px;

	font-weight:700;

	color:#0f172a;

	word-break:break-word;

}

/* ADDRESS */

.address-box{

	background:#0f172a;

	color:white;

	padding:28px;

	border-radius:22px;

	margin-top:25px;

}

.address-box h3{

	font-size:24px;

	font-weight:700;

	margin-bottom:15px;

}

.address-box p{

	font-size:16px;

	line-height:1.8;

	color:#cbd5e1;

}

/* BUTTON */

.back-btn{

	display:inline-block;

	margin-top:25px;

	background:linear-gradient(90deg,#c026ff,#9333ea);

	color:white;

	padding:13px 24px;

	border-radius:12px;

	text-decoration:none;

	font-weight:600;

	transition:0.3s;

}

.back-btn:hover{

	transform:translateY(-2px);

	color:white;

}

/* MOBILE */

@media(max-width:992px){

	.sidebar{

		width:100%;

		height:auto;

		position:relative;

	}

	.main{

		margin-left:0;

	}

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

	<h1 class="logo">

		TechLaptop

	</h1>

	<ul class="menu">

		<li>

			<a href="admin_dashboard.jsp">

				<i class="bi bi-grid-fill"></i>

				Dashboard

			</a>

		</li>

		<li>

			<a href="admin_profile.jsp">

				<i class="bi bi-person-circle"></i>

				Profile

			</a>

		</li>

		<li>

			<a href="admin_users.jsp">

				<i class="bi bi-people-fill"></i>

				Users

			</a>

		</li>

		<li>

			<a href="admin_laptops.jsp">

				<i class="bi bi-laptop"></i>

				Laptops

			</a>

		</li>

		<li>

			<a href="admin_orders.jsp"
			   class="active">

				<i class="bi bi-bag-check-fill"></i>

				Orders

			</a>

		</li>

		<li>

			<a href="Logout">

				<i class="bi bi-box-arrow-right"></i>

				Logout

			</a>

		</li>

	</ul>

</div>

<!-- MAIN -->

<div class="main">

	<!-- TOP -->

	<div class="top-box">

		<h1>

			Order User Details

		</h1>

	</div>

	<!-- DETAILS -->

	<div class="details-box">

		<%
		if(rs.next()){
		%>

		<div class="row g-4">

			<!-- NAME -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-person-fill"></i>

					<h5>

						Customer Name

					</h5>

					<p>

						<%=rs.getString("full_name")%>

					</p>

				</div>

			</div>

			<!-- EMAIL -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-envelope-fill"></i>

					<h5>

						Email Address

					</h5>

					<p>

						<%=rs.getString("user_email")%>

					</p>

				</div>

			</div>

			<!-- PHONE -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-telephone-fill"></i>

					<h5>

						Phone Number

					</h5>

					<p>

						<%=rs.getString("phone")%>

					</p>

				</div>

			</div>

			<!-- CITY -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-buildings-fill"></i>

					<h5>

						City

					</h5>

					<p>

						<%=rs.getString("city")%>

					</p>

				</div>

			</div>

			<!-- STATE -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-globe-central-south-asia"></i>

					<h5>

						State

					</h5>

					<p>

						<%=rs.getString("state")%>

					</p>

				</div>

			</div>

			<!-- PINCODE -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-mailbox2"></i>

					<h5>

						Pincode

					</h5>

					<p>

						<%=rs.getString("pincode")%>

					</p>

				</div>

			</div>

			<!-- PAYMENT -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-credit-card-fill"></i>

					<h5>

						Payment Method

					</h5>

					<p>

						<%=rs.getString("payment_method")%>

					</p>

				</div>

			</div>

			<!-- STATUS -->

			<div class="col-md-6">

				<div class="info-card">

					<i class="bi bi-bag-check-fill"></i>

					<h5>

						Order Status

					</h5>

					<p>

						<%=rs.getString("order_status")%>

					</p>

				</div>

			</div>

			<!-- TOTAL -->

			<div class="col-md-12">

				<div class="info-card">

					<i class="bi bi-currency-rupee"></i>

					<h5>

						Total Amount

					</h5>

					<p>

						₹<%=rs.getDouble("total_amount")%>

					</p>

				</div>

			</div>

		</div>

		<!-- ADDRESS -->

		<div class="address-box">

			<h3>

				<i class="bi bi-geo-alt-fill"></i>

				Shipping Address

			</h3>

			<p>

				<%=rs.getString("address")%>

			</p>

		</div>

		<%
		}
		%>

		<a href="admin_orders.jsp"
		   class="back-btn">

			<i class="bi bi-arrow-left"></i>

			Back To Orders

		</a>

	</div>

</div>

</body>

</html>