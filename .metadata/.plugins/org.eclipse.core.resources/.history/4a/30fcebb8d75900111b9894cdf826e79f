<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

	Change Password

</title>

<!-- BOOTSTRAP -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<!-- ICONS -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- GOOGLE FONT -->

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{

	margin:0;

	padding:0;

	box-sizing:border-box;

	font-family:'Poppins',sans-serif;

}

body{

	min-height:100vh;

	background:
	linear-gradient(
	rgba(0,0,0,0.65),
	rgba(0,0,0,0.65)
	),

	url("img/myimg3.jpg");

	background-size:cover;

	background-position:center;

	background-repeat:no-repeat;

	overflow-x:hidden;

	display:flex;

	align-items:center;

	justify-content:center;

	padding:30px;

}

/* =========================
   PASSWORD BOX
========================= */

.password-box{

	width:100%;

	max-width:500px;

	background:
	rgba(255,255,255,0.08);

	backdrop-filter:blur(16px);

	border:
	1px solid rgba(255,255,255,0.12);

	border-radius:30px;

	padding:50px;

	box-shadow:
	0 10px 40px rgba(0,0,0,0.35);

	color:white;

	animation:fadeIn 0.8s ease;

}

/* =========================
   ANIMATION
========================= */

@keyframes fadeIn{

	from{

		opacity:0;

		transform:translateY(30px);

	}

	to{

		opacity:1;

		transform:translateY(0);

	}

}

/* =========================
   TEXT
========================= */

.password-box h1{

	font-size:40px;

	font-weight:800;

	margin-bottom:10px;

	text-align:center;

	line-height:1.2;

}

.password-box p{

	text-align:center;

	color:#d1d5db;

	margin-bottom:40px;

	font-size:15px;

}

/* =========================
   FORM
========================= */

.form-group{

	margin-bottom:24px;

}

.form-group label{

	display:block;

	margin-bottom:10px;

	font-size:15px;

	font-weight:600;

	color:#f3f4f6;

}

.input-box{

	position:relative;

}

.input-box i{

	position:absolute;

	left:18px;

	top:50%;

	transform:translateY(-50%);

	color:#d1d5db;

	font-size:18px;

}

.input-box input{

	width:100%;

	height:58px;

	background:
	rgba(255,255,255,0.12);

	border:none;

	outline:none;

	border-radius:16px;

	padding-left:55px;

	padding-right:15px;

	color:white;

	font-size:15px;

	transition:0.3s;

}

.input-box input::placeholder{

	color:#d1d5db;

}

.input-box input:focus{

	background:
	rgba(255,255,255,0.18);

	border:
	1px solid #c026d3;

}

/* =========================
   BUTTON
========================= */

.change-btn{

	width:100%;

	height:58px;

	border:none;

	border-radius:16px;

	background:
	linear-gradient(
	135deg,
	#d946ef,
	#9333ea
	);

	color:white;

	font-size:18px;

	font-weight:700;

	transition:0.4s;

	box-shadow:
	0 10px 20px rgba(192,38,211,0.3);

	margin-top:10px;

}

.change-btn:hover{

	transform:translateY(-4px);

	box-shadow:
	0 15px 30px rgba(192,38,211,0.45);

}

/* =========================
   BACK LINK
========================= */

.back-link{

	text-align:center;

	margin-top:28px;

}

.back-link a{

	color:#f3f4f6;

	text-decoration:none;

	font-size:15px;

	font-weight:500;

	transition:0.3s;

}

.back-link a:hover{

	color:#d946ef;

	text-decoration:underline;

}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

	.password-box{

		padding:35px 25px;

	}

	.password-box h1{

		font-size:36px;

	}

}

</style>

</head>

<body>

<div class="password-box">

	<h1>

		Change Password

	</h1>

	<p>

		Update your account password securely

	</p>

	<form
	action="ChangePassword"
	method="post">

		<!-- EMAIL -->

		<div class="form-group">

			<label>

				Email Address

			</label>

			<div class="input-box">

				<i class="bi bi-envelope-fill"></i>

				<input
				type="email"
				name="email"
				placeholder="Enter your email"
				required>

			</div>

		</div>

		<!-- OLD PASSWORD -->

		<div class="form-group">

			<label>

				Old Password

			</label>

			<div class="input-box">

				<i class="bi bi-lock-fill"></i>

				<input
				type="password"
				name="old_password"
				placeholder="Enter old password"
				required>

			</div>

		</div>

		<!-- NEW PASSWORD -->

		<div class="form-group">

			<label>

				New Password

			</label>

			<div class="input-box">

				<i class="bi bi-shield-lock-fill"></i>

				<input
				type="password"
				name="new_password"
				placeholder="Enter new password"
				required>

			</div>

		</div>

		<!-- CONFIRM PASSWORD -->

		<div class="form-group">

			<label>

				Confirm New Password

			</label>

			<div class="input-box">

				<i class="bi bi-check-circle-fill"></i>

				<input
				type="password"
				name="confirm_password"
				placeholder="Confirm new password"
				required>

			</div>

		</div>

		<!-- BUTTON -->

		<button
		type="submit"
		class="change-btn">

			<i class="bi bi-shield-lock-fill"></i>

			Change Password

		</button>

	</form>

	<!-- BACK -->

	<div class="back-link">

		<a href="profiles.jsp">

			<i class="bi bi-arrow-left"></i>

			Back To Profile

		</a>

	</div>

</div>

</body>

</html>